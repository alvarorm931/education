		<script type="text/javascript">
			jQuery(document).ready(function() {
				jQuery('a').each(function() {
					var href = this.href;
					var pos = href.match("do$");
	
					if (pos) {
						jQuery(this).attr('href', href + '?lang=' + document.documentElement.lang);
					}
				});
				
				// Si no tiene hijos o tiene hijos pero no es el titulo del menú, ocultamos esos div.
				if ($('#divMenuLateral').children().length == 0 || $('#divMenuLateral').children()[0].tagName != "H2") {
					$('#menuLateralOp').css('display', 'none');
					$('.contenidoCol2').removeClass('bordeDerechoPanel');
				}else{
					$('.contenidoCol2').addClass('bordeDerechoPanel');
	
				}
	
			});
			</script>
	
			
<script type="text/javascript">
		$(document).ready(function() {
			if($("div[class*='date']").size()!=0){
				
				$('.dog-datetimepicker-busqueda').datetimepicker({
					format : "DD/MM/YYYY",
					maxDate : today,
					locale : document.documentElement.lang,
					daysOfWeekDisabled : [ 0, 6 ],
					disabledTimeIntervals : false,
					useCurrent : false,
					keepInvalid : true,
					ignoreReadonly : true

				});
				$('.dog-datetimepicker-anos-lat').datetimepicker({
					format : "YYYY",
					maxDate : today,
					minDate : '1978',
					locale : document.documentElement.lang,
					daysOfWeekDisabled : [ 0, 6 ],
					disabledTimeIntervals : false,
					useCurrent : false,
					keepInvalid : true,
					viewMode : 'years',
					ignoreReadonly : true
				});

				$('.dog-datetimepicker-anos-lat').datetimepicker().on('dp.change', function(e) {
					e.preventDefault();
					window.location.href = "construirMapaCalendario.do?compMenu=10103&year=" + $('#anoBusquedaLat').val();

					return false;
				});
				
				$('.dog-datetimepicker-anos-lat').datetimepicker().on('dp.change', function(e) {
					e.preventDefault();
					window.location.href = "construirMapaCalendario.do?compMenu=10103&year=" + $('#anoBusquedaLat').val();
					return false;
				});

				$('.dog-datetimepicker-busqueda').on("dp.update", function(e) {
					today = new Date(e.viewDate);
					getDiasDog(urlCargarDiariosDelMes);
				});

				$('.dog-datetimepicker-busqueda').on("dp.change", function(e) {
					e.preventDefault();
				});
			}
		});
			

			var nowDate = new Date();
			var today = new Date(nowDate.getFullYear(), nowDate.getMonth(), nowDate.getDate(), 0, 0, 0, 0);

			// Url para cargar la lista de diarios del mes
			urlCargarDiariosDelMes = "portalPublicoHome.do?method=getDiasDog"

			// Devuelve los dias que hay diario publicado
			function getDiasDog(urlPeticion) {
				jQuery.ajax({
					url : urlPeticion,
					method: 'POST',
					data : {
						mes : today.getMonth() + 1,
						ano : today.getFullYear(),
						idioma : $('#idiomaSeleccionado').val()
					},
					success : function(result) {
						jQuery.each(result, function(index, diaDog) {
							jQuery('.dog-datetimepicker-busqueda  td.day[data-day="' + diaDog.fecha + '"]').each(function() {
								$(this).addClass("active");
								$(this).attr("url", diaDog.url);
								$(this).attr("descripcion", diaDog.descripcion);
								$(this).html("<a href='" + diaDog.url + "' title='" + diaDog.descripcion + "' target='_self'>" + $(this).html() + "</a>");
							});

							jQuery('.dog-datetimepicker-busqueda  td.day[data-day="' + diaDog.fecha + '"]').on('click', function(e) {
								e.preventDefault();
								if ($(this).attr("url") != undefined) {
									window.location.href = $(this).attr("url");
								}
								return false;
							});
						});
					},					
			        cache: false,
					async : true,
					error: function (result){                                        		                         
		                abrirVentanaModal(MENSAJES.general.errorInterno);
		            }
				});
			}			
        </script>
	
