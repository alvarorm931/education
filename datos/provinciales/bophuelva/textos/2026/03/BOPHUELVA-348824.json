 "id": "BOPHUELVA-348824",
 "titulo": "Rectificación de error material de la Resolución de aprobación de la lista definitiva de admitidos y excluidos para la provisión de una plaza de Conserje",
 "texto": "\u0001\u0002\u0003\u0002\u0004\u0002\u0003\u0002\u0005\u0002\u0006\u0002\u0007\u0002 \u0001\u0002\u0003\u0004\u0005\u0006\u0002\u0005\u0007\b\u0002 \u0003\u0006\n\u0003\n\u0006\u000e\u0002\u0003\u000f\u0010\u0003\u0007 \u0003\u0011\u0002\u0012\u0013 \u0003\u0007 \u0003\u0014\u0015\u0014\u0010 \u0003\u000e\u0002\u0003\u0007\u0016\u0006\u0017\u0002\u0007 \u0003\u0018 \u0019 \u0005\u001a\u0006\u0016\u001b \u0003\n\u0012\u0003\u0005\u0002\u0019\u0003 \u001a \u0003 \u0019 \u0003 \u0012 \u0006 \u0007 \u0003\u0002\u0003\u0005\u0002\u0003\u0012 \u0006\u0017\u0016 \u0006\u0002\u0006\u0016\u001b \u0003\u0007 \u0003\u0005\u0002\u0003\u0018 \u0019 \u0005\u001a\u0006\u0016\u001b \u0003\u0007 \u0003\u0002 \u0012 \u0002\u0006\u0016\u001b \u0003\u0007 \u0003\u0005\u0002\u0019\u0003\u0005\u0016\u0019\u0017\u0002\u0019\u0003\u0007\n\u0016\u0017\u0016 \u0002\u0003 \u0002 \u0012\u001a \u0002\u0003\u0005\u0002\u0003\u0005\u0016\u0019\u0017\u0002\u0003\u0007\n\u0016\u0017\u0016 \u0002\u0003\u0007 \u0003\u0004\u0007\u0011\u0016\u0017\u0016\u0007 \u0019 \u0003\u0007 \u0019\u0016! \u0002\u0006\u0016\u001b \u0003\u0007 \u0003\"\u0012\u0016 \u001a \u0002\u0005\u0003#\u0003\n\u0006\u000e\u0002\u0003\u0007 \u0003\u0005\u0002\u0019\u0003 \u0012\u001a \u0002\u0019\u0003 \u0019 \u0005 \u0006\u0017\u0016 \u0002\u0019\u0003 \u0002\u0012\u0002\u0003\u0005\u0002\u0003 \u0012 \u0016\u0019\u0016\u001b \u0003\u0006 \u0011 \u0003$\u001a \u0006\u0016\n\u0002\u0012\u0016 \u0003\u0007 \u0003%\u0002 \u0012\u0012 \u0012\u0002 \u0003\n\u0012\u0003 \u0005\u0003\u0019\u0016\u0019\u0017 \u0011\u0002\u0003\u0007 \u0003\u0006\n\u0006\u001a\u0012\u0019 &\n\u0019\u0016\u0006\u0016\u001b \u0003\u0007 \u0003\u001a \u0002\u0003 \u0005\u0002\u0013\u0002\u0003’\u0002\u0006\u0002 \u0017 \u0003\u0007 \u0003%\n\u0019 \u0012( \u0003\n\u0012\u0017\n\u0006\u0016\n\u0017 \u0003\u0002\u0003\u0005\u0002\u0003 \u0005\u0002 \u0017\u0016\u0005\u0005\u0002\u0003\u0007 \u0003\n\u0012\u0019\n\u0002\u0005\u0003\n\u001a \u0006\u0016\n\u0002\u0012\u0016 \u0003\u0007 \u0005\u0003)*\u0006\u0011 +\u0003\u0004#\u001a \u0017\u0002\u0011\u0016\n\u0017 \u0003\u0007 \u0003,\u0019\u0005\u0002\u0003%\u0012\u0016\u0019\u0017\u0016 \u0002+ -.’\u0016\u0019\u0017\u0002\u0003\u0005\u0002\u0003\u0018 \u0019 \u0005\u001a\u0006\u0016\u001b \u0003\u0007 \u0003\u0004\u0005\u0006\u0002\u0005\u0007\b\u0002 \u0003\u0007 \u0003\n\u0006\u000e\u0002\u0003\u000f/\u0003\u0007 \u0003\n\u0012 \u0012 \u0003\u0007 \u0003\u0014\u0015\u0014\u0010 \u0003\n\u0012\u0003\u0005\u0002\u0003 \u001a \u0003 \u0019 \u0003\u0002 \u0012\u001a \u0002\u0003\u0005\u0002\u0003\u0005\u0016\u0019\u0017\u0002\u0003\u0007\n\u0016\u0017\u0016 \u0002\u0003\u0007 \u0003\u0002\u0007\u0011\u0016\u0017\u0016\u0007 \u0019\u0003\u0007 \u0003\u0005\u0002\u0003\u0006\n\u0006\u0002\u0017 \u0012\u0016\u0002\u0003 \u0002\u0012\u0002\u0003\u0005\u0002\u0003 \u0012 \u0016\u0019\u0016\u001b \u0003\u0006 \u0011 \u0003\n\u001a \u0006\u0016\n\u0002\u0012\u0016 \u0003\u0007 \u0003\u0006\u0002\u0012\u0012 \u0012\u0002 \u0003\n\u0012\u0003 \u0005\u0003\u0019\u0016\u0019\u0017 \u0011\u0002\u0003\u0007 \u0003\u0006\n\u0006\u001a\u0012\u0019 &\n\u0019\u0016\u0006\u0016\u001b \u0003\u0017\u001a\u0012\n\u0003\u0005\u0016 \u0012 \u0003\u0007 \u0003\u001a \u0002\u0003 \u0005\u0002\u0013\u0002\u0003 \u0002\u0006\u0002 \u0017 \u0003\u0007 \u0003%\n\u0019 \u0012( \u0003\n\u0012\u0017\n\u0006\u0016\n\u0017 \u0003\u0002\u0003\u0005\u0002\u0003)\u0019\u0006\u0002\u0005\u0002\u0003\u0007 \u0003\u0004 \u0007\u0011\u0016 \u0016\u0019\u0017\u0012\u0002\u0006\u0016\u001b \u00030\n\u0012\u0002\u0005 \u00031\u001a \u0019\u0006\u0002\u0005\u0002\u0003 1\u001a \u0002\u0005\u0017 \u0012\n\u0003 \u0004!\u0012\u001a \u0002\u0006\u0016\n\u0019 \u0003 2\u0012\n\u0019\u0016\n\u0002\u0005 \u0019 \u0003\n\u0012\u0017\n\u0006\u0016\n\u0017 \u0003 \u0002 \u0003 \u0005\u0002 \u0003 \u0005\u0002 \u0017\u0016\u0005\u0005\u0002 \u0003 \u0007 \u0003\n\u0012\u0019\n\u0002\u0005\u0003\n\u001a \u0006\u0016\n\u0002\u0012\u0016 \u0003\u0007 \u0005\u0003)*\u0006\u0011 +\u0003\u0004#\u001a \u0017\u0002\u0011\u0016\n\u0017 \u0003\u0007 \u0003,\u0019\u0005\u0002\u0003%\u0012\u0016\u0019\u0017\u0016 \u0002 \u0003 \u001a \u0005\u0016\u0006\u0002\u0007\u0002\u0003\n\u0003 \u0005\u00033 \u0005 \u0017\b \u00034 \u0016\u0006\u0016\u0002\u0005\u0003\u0007 \u0003\u0005\u0002\u0003 2\u0012 \u0016 \u0006\u0016\u0002\u0003\u0007 \u00035\u001a \u0005 \u0002\u0003 6\u0011 \u0012 \u000378\u0003\u0007 \u0003\u000f\u0015\u0003\u0007 \u0003\u0011\u0002\u0012\u0013 \u0003\u0007 \u0003\u0014\u0015\u0014\u0010+ ’\u0016\u0019\u0017 \u0003 \u001a \u0003\u0019 \u0003\u000e\u0002\u0003\u0007 \u0017 \u0006\u0017\u0002\u0007 \u0003\u001a \u0003 \u0012\u0012 \u0012\u0003\u0011\u0002\u0017 \u0012\u0016\u0002\u0005\u0003\n\u0003\u0005\u0002\u0003\u0012 \u0005\u0002\u0006\u0016\u001b \u0003\u0007 \u0003\u0002\u0019 \u0016\u0012\u0002 \u0017 \u0003 \u001a \u0003 \u000e\u0002 \u0003 \u0012 \u0019\n\u0017\u0002\u0007 \u0003\u0019\u001a \u0019\u0002 \u0002\u0006\u0016\n\u0019\u0003\u0002\u0003\u0005\u0002\u0003\u0005\u0016\u0019\u0017\u0002\u0003 \u0012 \u0016\u0019\u0016\n\u0002\u0005 \u0003\u0006\n\u0019\u0016\u0019\u0017\n\u0017 \u0003\n9 &\u0003:\n\u0007 \u0003\u0007\u0016\u0006 9\u0003/+&\u0003:;\u0002+\u0003\u0004 \u0017\n\u0016\u0002\u00031\u0002\u0011\u001a \u0005\u0003\u0018 \u0007\u0012\b!\u001a \u0013 \u0003:<,+==7 >?\u0015==3 \u0003 \u001a \u0003 \u0012 \u0019\n\u0017\u0002\u0003’\u0016\u0007\u0002\u0003 \u0001\u0002 \u0012\u0002\u0005+ &\u0003:\n\u0003\u0007 \u0006\u0016\u0012 \b\u0003/+&\u0003:;\u0002+\u0003@\u0002\u0012\b\u0002\u0003@\u0002\u0006\u0002\u0012\n\u0002\u0003\u0018 \u0011 \u0012 \u00031A \u0006\u000e \u0013+\u0003:<,+==7>?\u0015==3 \u0003 \u001a \u0003 \u0012 \u0019\n\u0017\u0002\u0003 ’\u0016\u0007\u0002\u0003\u0001\u0002 \u0012\u0002\u0005+ ’\u0016\u0019\u0017 \u0003 \u001a \u0003 \u0005\u0003\u0002\u0012\u0017\b\u0006\u001a\u0005 \u0003\u000f\u0015? \u0014\u0003\u0007 \u0003\u0005\u0002\u0003\u0001 #\u0003/?B\u0014\u0015\u000fC \u0003\u0007 \u0003\u000f \u0003\u0007 \u0003 \u0006\u0017\u001a \u0012 \u0003\u0007 \u0005\u0003 2\u0012 \u0006 \u0007\u0016\u0011\u0016\n\u0017 \u0003\u0004\u0007\u0011\u0016 \u0016\u0019\u0017\u0012\u0002\u0017\u0016 \u0003% \u00116 \u0003\u0007 \u0003\u0005\u0002\u0019\u0003\u0004\u0007\u0011\u0016 \u0016\u0019\u0017\u0012\u0002\u0006\u0016\n\u0019\u000326 \u0005\u0016\u0006\u0002\u0019 \u0003\u0007\u0016\u0019\n\u0003 \u001a 9\u0003-\u0001\u0002\u0019\u0003 \u0004\u0007\u0011\u0016 \u0016\u0019\u0017\u0012\u0002\u0006\u0016\n\u0019\u000326 \u0005\u0016\u0006\u0002\u0019 \u0003\n\u0007\u0012A \u0003\u0002\u0019\u0016\u0011\u0016\u0019\u0011 \u0003\u0012 \u0006\u0017\u0016 \u0016\u0006\u0002\u0012\u0003\n\u0003\u0006\u001a\u0002\u0005 \u001a\u0016 \u0012\u0003\u0011 \u0011\n\u0017 \u0003\u0007 \u0003\n\u0016\u0006\u0016 \u0003 \u0003 \u0007 \u0003\u0016 \u0019\u0017\u0002 \u0006\u0016\u0002\u0003\u0007 \u0003\u0005 \u0019\u0003\u0016 \u0017 \u0012 \u0019\u0002\u0007 \u0019 \u0003\u0005 \u0019\u0003 \u0012\u0012 \u0012 \u0019\u0003\u0011\u0002\u0017 \u0012\u0016 \u0002\u0005 \u0019 \u0003\u0007 \u0003\u000e \u0006\u000e \u0003 \u0003\u0002\u0012\u0016\u0017\u0011D\u0017\u0016\u0006 \u0019\u0003 *\u0016\u0019\u0017\n\u0017 \u0019\u0003\n\u0003\u0019\u001a\u0019\u0003\u0002\u0006\u0017 \u0019+.\n%\n\u0003 \u0002\u0019 \u0003\n\u0003\u0005 \u0003\u0002 \u0017 \u0012\u0016 \u0012 \u0003#\u0003\n\u0003 \u0016\u0012\u0017\u001a\u0007\u0003\u0007 \u0003\u0005\u0002\u0003\u0006 \u0011\n\u0017\n\u0006\u0016\u0002\u0003 \u001a \u0003\u0017\u0016\n\u0003\u0002\u0017\u0012\u0016 \u001a\u0016\u0007\u0002\u0003 \u0019\u0017\u0002\u0003 \u0004\u0005\u0006\u0002\u0005\u0007\b\u0002\u0003\n\u0012\u0003 \u0005\u0003\u0002\u0012\u0017\b\u0006\u001a\u0005 \u0003\u0014\u000f+\u000f+\u000eE\u0003\u0007 \u0003\u0005\u0002\u0003\u0001 #\u00038B>C\u0003\u0007 \u0003 \u0014\u0003\u0007 \u0003\u0002 \u0012\u0016\u0005 \u0003\u0018 !\u001a\u0005\u0002\u0007 \u0012\u0002\u0003\u0007 \u0003\u0005\u0002\u0019\u00033\u0002\u0019 \u0019\u0003\u0007 \u0003 \u0018D!\u0016\u0011\n\u0003\u0001 \u0006\u0002\u0005 \u0003 \u0002\n\u0004\n\u000e\u0007\b\u0002 \u000f\u0010\u0011\u0012\u0013\u0010\u0014\u0015&\u0003\u0018 \u0006\u0017\u0016 \u0016\u0006\u0002\u0012\u0003\u0005\u0002\u0003\u0012 \u0005\u0002\u0006\u0016\u001b \u0003\u0007 \u0003\u0002\u0019 \u0016\u0012\u0002 \u0017 \u0019\u0003 \u001a \u0003\u000e\u0002 \u0003 \u0012 \u0019\n\u0017\u0002\u0007 \u0003\u0019\u001a \u0019\u0002 \u0002\u0006\u0016\n\u0019\u0003\u0002\u0003\u0005\u0002\u0003 \u0005\u0016\u0019\u0017\u0002\u0003 \u0012 \u0016\u0019\u0016\n\u0002\u0005\u0003\u0007 \u0003\u0002\u0007\u0011\u0016\u0017\u0016\u0007 \u0019B *\u0006\u0005\u001a\u0016\u0007 \u0019\u0003\u0007 \u0003\u0005\u0002\u0003\u0006\n\u0006\u0002\u0017 \u0012\u0016\u0002\u0003 \u0002\u0012\u0002\u0003\u0005\u0002\u0003 \u0012 \u0016\u0019\u0016\u001b \u0003\u0006 \u0011 \u0003\n\u001a \u0006\u0016\n\u0002\u0012\u0016 \u0003\u0007 \u0003\u0006\u0002\u0012\u0012 \u0012\u0002 \u0003\n\u0012\u0003 \u0005\u0003\u0019\u0016\u0019\u0017 \u0011\u0002\u0003\u0007 \u0003\u0006\n\u0006\u001a\u0012\u0019 &\n\u0019\u0016\u0006\u0016\u001b \u0003\u0017\u001a\u0012\n\u0003\u0005\u0016 \u0012 \u0003\u0007 \u0003\u001a \u0002\u0003 \u0005\u0002\u0013\u0002\u0003 \u0002\u0006\u0002 \u0017 \u0003\u0007 \u0003%\n\u0019 \u0012( \u0003\n\u0012\u0017\n\u0006\u0016\n\u0017 \u0003\u0002\u0003\u0005\u0002\u0003)\u0019\u0006\u0002\u0005\u0002\u0003\u0007 \u0003\u0004 \u0007\u0011\u0016 \u0016\u0019\u0017\u0012\u0002\u0006\u0016\u001b \u00030\n\u0012\u0002\u0005 \u00031\u001a \u0019\u0006\u0002\u0005\u0002\u0003 1\u001a \u0002\u0005\u0017 \u0012\n\u0003 \u0004!\u0012\u001a \u0002\u0006\u0016\n\u0019 \u0003 2\u0012\n\u0019\u0016\n\u0002\u0005 \u0019 \u0003\n\u0012\u0017\n\u0006\u0016\n\u0017 \u0003 \u0002 \u0003 \u0005\u0002 \u0003 \u0005\u0002 \u0017\u0016\u0005\u0005\u0002 \u0003 \u0007 \u0003\