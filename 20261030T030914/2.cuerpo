// pintarCalAnio se llama en el onload de Publico_Cal.
// Pinta los 12 calendarios de un año.
// Parametro año por URL.
function pintarCalAnio() {
    var fechaActual = new Date();
    var anio = obtenerValorParametro("anio");
    fechaActual.setDate(1);
    fechaActual.setFullYear(obtenerValorParametro("anio"));
    for (mes = 0; mes < 12; mes++) {
        fechaActual.setMonth(mes);
//            pintarCalendariosBolHist(fechaActual);
        pintarCalendarios(fechaActual);
    }
}

// Pinta el calendario de un més y año pasados como parámetro.
function pintarCalendarios(fecha) {
    var anio = fecha.getFullYear();
    var mes = fecha.getMonth() + 1;
    var eventos = {};
    // Formato Eventos: eventos["2017-01-11"] = {"url": "#"};
    // Solicitar Boletines del mes/año para Rellenar eventos.
    $.ajax({
        url: '/bop/services/boletines/bopMesCalendario',
        method: 'GET',
        dataType: 'json',
        data: {"mes":mes, "anio":anio},
        timeout: 0, // sin tiempo de espera
        success: function (resultado, textStatus, jqXHR) {

            // Llamar al servicio y Cargar EVENTOS.
            if (resultado !== null && resultado.data !== null && resultado.data.length > 0) {
                for (x in resultado.data) {
//                    var clave = anio + "-" + mes + "-" + resultado.data[x].diaBop;
                    var clave = anio + "-";
                    if (mes < 10)
                        clave = clave + "0";
                    clave = clave + mes + "-";
                    if (resultado.data[x].diaBop < 10)
                        clave = clave + "0";
                    clave = clave + resultado.data[x].diaBop;
                    // Añadir llamada a servicio en cada evento del calendario.
                    eventos[clave] = {"url": "sumario.html?busqueda=numBop" + "&id=" + resultado.data[x].idBoletin};
                }
            }

            $("#mes" + mes).responsiveCalendar({
                time: anio + "-" + mes,
                allRows: true,
                activateNonCurrentMonths: true,
                translateMonths: ["Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"],
                events: eventos});
        },
        error: function (jqXHR, textStatus, errorThrown) {
            console.log("Error: pintarCalendarios() -> /services/boletines/bopMes", textStatus);
        }
    });
}

function pintarCalHistAnio() {
    var anio = obtenerValorParametro("anio");
    if(anio==null)
    	anio='2001';
//    fechaActual.setFullYear(obtenerValorParametro("anio"));
    for (mes = 0; mes < 12; mes++) {
//        fechaActual.setMonth(mes);
        pintarCalendariosBolHist(mes +1, anio);
    }
}

function pintarCalendariosBolHist(mes, anio) {
//    var anio = fecha.getFullYear();
//    var mes = fecha.getMonth() + 1;
    var dto = {};
    if (anio) {
        dto.anio = anio;
    }
    if (mes && mes != "null") {
        dto.mes = mes;
    }
    var eventos = {};
    // Formato Eventos: eventos["2017-01-11"] = {"url": "#"};
    // Solicitar Boletines del mes/año para Rellenar eventos.
    $.ajax({
        url: '/bop/services/boletineshistoricos/bopMes',
        method: 'GET',
        dataType: 'json',
        data: dto,
        timeout: 0, // sin tiempo de espera
        success: function (resultado, textStatus, jqXHR) {
            // Llamar al servicio y Cargar EVENTOS.
            if (resultado !== null && resultado.data !== null && resultado.data.length > 0) {
                for (x in resultado.data) {
//                    var clave = anio + "-" + mes + "-" + resultado.data[x].diaBop;
                    var clave = anio + "-";
                    if (mes < 10)
                        clave = clave + "0";
                    clave = clave + mes + "-";
                    if (resultado.data[x].diaBop < 10)
                        clave = clave + "0";
                    clave = clave + resultado.data[x].diaBop;
                    // Añadir llamada a servicio en cada evento del calendario.                 
                    eventos[clave] = {"url": "/bop/services/boletineshistoricos/contenidoPdfIdBoletin?idBoletin=" + resultado.data[x].id};
                }
            }

            $("#mes" + mes).responsiveCalendar({
                time: anio + "-" + mes,
                allRows: true,
                activateNonCurrentMonths: true,
                newWindow: true,
                translateMonths: ["Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"],
                events: eventos});
        },
        error: function (jqXHR, textStatus, errorThrown) {
            console.log("Error: pintarCalendariosBolHist() -> /services/boletines/bopMes", textStatus);
        }
    });
}

// Pinta un calendario de un més y año pasados como parámetro.
function pintarUnCalendario(anio, mes) {
// var anio = fecha.getFullYear();
//var mes = fecha.getMonth() + 1;
    var eventos = {};
    // Solicitar Boletines del mes/año para Rellenar eventos.
    $.ajax({
        url: '/bop/services/boletines/bopMes',
        method: 'GET',
        dataType: 'json',
        data: {"mes":mes, "anio":anio},
        timeout: 0, // sin tiempo de espera
        success: function (resultado, textStatus, jqXHR) {

            // Cargar EVENTOS via servicio.
            if (resultado !== null && resultado.data !== null && resultado.data.length > 0) {
                for (x in resultado.data) {
//                  var clave = anio + "-" + mes + "-" + resultado.data[x].diaBop;
                    var clave = anio + "-";
                    if (mes < 10)
                        clave = clave + "0";
                    clave = clave + mes + "-";
                    if (resultado.data[x].diaBop < 10)
                        clave = clave + "0";
                    clave = clave + resultado.data[x].diaBop;
                    // Añadir llamada a servicio en cada evento del calendario.
                    eventos[clave] = {"url": "sumario.html?busqueda=numBop" + "&id=" + resultado.data[x].idBoletin};
                }
            } else if (resultado.total == -1) {
                window.alert("La fecha de su sistema no coincide con la fecha actual, revise su configuración de fecha y hora.");
            }

            $(".responsive-calendar").responsiveCalendar({
                time: anio + "-" + (mes),
                allRows: false,
                activateNonCurrentMonths: false,
                newWindow: false,
                translateMonths: ["Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"],
                events: eventos});
        },
        error: function (jqXHR, textStatus, errorThrown) {
            console.log("Error: pintarUnCalendario() -> /services/boletines/bopMes", textStatus);
        }});
    $(function () {
        $('#fechaEntrada').datetimepicker({
            locale: 'es',
            format: 'DD/MM/YYYY'
        });
    });
    $(function () {
        $('#fechaPrevista').datetimepicker({
            locale: 'es',
            format: 'DD/MM/YYYY'
        });
    });
    $(function () {
        $('#idBOPDia').datetimepicker({
            locale: 'es',
            format: 'DD/MM/YYYY'
        });
    });
    $(function () {
        $('#idBOP').datetimepicker({
            locale: 'es',
            format: 'DD/MM/YYYY'
        });
    });
}


function mostrarFechaUltimoBop() {
     $.ajax({
        url: '/bop/services/boletines/ultimoBop',
        method: 'GET',
        dataType: 'json',
//        data: {mes, anio},
        timeout: 0, // sin tiempo de espera
        success: function (resultado, textStatus, jqXHR) {

            // Cargar EVENTOS via servicio.
            if (resultado !== null && resultado.data !== null) {
                $('#fUltimoBop').html(resultado.data.fecha);
                $('#fUltimoBop').attr('href','sumario.html?busqueda=numBop&id='+resultado.data.idBoletin);
                $('#fechaMigaPan').html(resultado.data.fecha);
            }
        }
   });
}

function mostrarUltimoBop() {
     $.ajax({
        url: '/bop/services/boletines/ultimoBop',
        method: 'GET',
        dataType: 'json',
//        data: {mes, anio},
        timeout: 0, // sin tiempo de espera
