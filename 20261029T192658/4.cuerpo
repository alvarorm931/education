'use strict';
/**
 * @ngdoc overview
 * @name BormApp
 * @description
 * # BormApp
 *
 * Módulo principal del aplicativo
 */
angular
.module('BormApp', ['oc.lazyLoad', 'ui.router', 'ui.bootstrap', 'ngSanitize',
