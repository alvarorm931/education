    fpca_sumari_DOGC.init($(".fpca_sumari_DOGC_ALL"));
	var events;
	var json = {};
	var localeSumari = $("#localeSumari").val();
	var protocolSumari = $("#protocolSumari").val();
	var hostSumari = hostConstant;
	var portSumari = $("#portSumari").val();
	var uriSumari = $("#uriSumari").val();
	var downloadText = $("#downloadPagi").val();
	var downloadTextSup = $("#downloadSup").val();
	var downloadTextDes = $("#downloadDes").val();
	var action = $("#action").val();
	var up = $("#up").val();
	var share = $("#share").val();
	var summary = $("#summary").val();
	var suplementText = $("#suplementText").val();
	var currentDate = new Date();
	var selectedMonth = currentDate.getMonth();
	var selectedYear = currentDate.getFullYear();
	var MAX = 2;

	var numDOGCRequest = $("#numDOGCRequest").val();

	callAPISumari();


	function callAPISumari() {
		events = {};
		var url = protocolSumari + "://" + hostSumari + ":" + portSumari + uriSumari;

		if (numDOGCRequest == "null" || numDOGCRequest === "") {
			var inputParameters = {
				numDOGC: getUrlParameter(window.location.href, "numDOGC"),
				language: localeSumari
			};
		} else {
			var inputParameters = {
				numDOGC: numDOGCRequest,
				language: localeSumari
			};
		}



		$.ajax({
			type: 'post',
			url: url,
			timeout: 45000,
			data: inputParameters,
			dataType: 'json',
			async: false,
			success: function (data) {
				showModalLoading(true);
				if (data) {
					$.each(data.sumaris, function (key, value) {
						var numDOGC = value.numDOGC;
						var previousNumDOGC = value.previousNumDOGC;
						var laterNumDOGC = value.laterNumDOGC;
						var dateStringDOGC = value.dateStringDOGC;
						var dateDOGC = value.dateDOGC;
						fpca_sumari_DOGC_calendari_dogc.CONSTANTS["date"] = dateDOGC;
						var linkDownloadDOGCPDF = value.linkDownloadDOGCPDF;
						var linkDownloadSummaryPDF = value.linkDownloadSummaryPDF;
						$('#sectionAll').append(createSecciones(value.numDOGC));						

						if (linkDownloadSummaryPDF != null) {
							linkDownloadSummaryPDF = linkDownloadSummaryPDF.replace('PdfProviderServlet', 'jsp/captcha/RecaptchaServlet.jsp');
						}

						var element = document.getElementById("panel-group-" + value.title);

						/*$('#header-sumari-'+value.numDOGC).append('<h2 class="panel-title">'+getPropertiesHtml("summary")+'</h2>' +
						'<div class="download"> <a id="myModalSumary" href="'+linkDownloadSummaryPDF+'" target="_blank"class="dropdown-toggle"> ' +
						'<img alt="pdf icon" src="/system/modules/cat.gencat.wcmResponsive.formatters.httpFetch/resources/common/img/NG_ico_pdf.png" ' + 
						'class="icon-corrector">'+downloadText+'<span class="sr-only">'+downloadText+'</span></a>' +
						'</div><ul class="listado"></ul>');*/
						$('#header-sumari-' + value.numDOGC).append(
							'<div class="header-sumari__row"> <h2 class="panel-title">' + getPropertiesHtml("summary") + '</h2>' + '<ul class="listado"></ul></div>' +
							'<div class="header-sumari__row"><div class="download">');
						if (linkDownloadSummaryPDF != null) {
							$('#download-' + value.numDOGC).append('<a href="' + linkDownloadSummaryPDF + '" target="_blank"> ' +
								'<img alt="pdf icon" src="/system/modules/cat.gencat.wcmResponsive.formatters.httpFetch/resources/common/img/NG_ico_pdf.png" ' +
								'class="icon-corrector">' + downloadTextSup + '<span class="sr-only">' + downloadTextSup + '</span></a>');
						}

						$('#header-sumari-' + value.numDOGC).append('</div></div>');

						$('#downloadSumariHeader-' + value.numDOGC).append('<a href="' + linkDownloadDOGCPDF + '" target="_blank"><img alt="pdf icon" ' +
							'src="/system/modules/cat.gencat.wcmResponsive.formatters.httpFetch/resources/common/img/NG_ico_pdf.png" ' +
							'class="icon-corrector"/>' + downloadText + '<span class="sr-only">' + downloadText + '</span></a>');

						loadPaginacio(numDOGC, dateStringDOGC, previousNumDOGC, laterNumDOGC, linkDownloadDOGCPDF, linkDownloadSummaryPDF, value.numDOGC);
						iterar(value.section, value.numDOGC);
						listaResultados(value.section, value.numDOGC);

						var url = $(location).attr("href");

						if (url.includes("#")) {
							window.location.href = url;
						}

					});
					fpca_sumari_DOGC_calendari_dogc.init($(".fpca_sumari_DOGC_ALL"));

					$('.el_mes_consultat .panel-heading a').click(function () {
						$(this).parents('.el_mes_consultat').hasClass('open') ? ($(this).parents('.el_mes_consultat').removeClass('open'), $('.el_mes_consultat .panel-body').animate({
							right: '-260px'
						}, 400, 'swing')) : ($(this).parents('.el_mes_consultat').addClass('open'), $('.el_mes_consultat .panel-body').animate({
							right: '-15px'
						}, 400, 'swing'))
					})
					
					if (data.sumaris.length > 1) {
						$.each(data.sumaris, function (key, value) {

							if (value.numDOGC != getParameterByName("numDOGC")) {
								var url = "/" + localeSumari + pageDOGC + "?numDOGC=" + value.numDOGC;
                                var veureLabel = fpca_sumari_DOGC.config.labels.veureLabel + ' ' + value.title;
								$('.listado').append('<li><a href="' + url + '" id="' + value.numDOGC + '">'+veureLabel + '</a></li>');
							}

						});
					}

						$.each(data.sumaris, function (key, value) {

							if (value.numSuplement != null) {
								var url = "/" + localeSumari + "/sumari-del-suplement/?numDOGC=" + value.numSuplement;
								$('.listado').append('<li><a href="' + url + '" id="' + value.numSuplement + '" title="'+suplementText+'">' + suplementText + '</a></li>');
							}

						});
					
					


					if (numDOGCRequest == "null" || numDOGCRequest === "") {
						var number = getUrlParameter(window.location.href, "numDOGC");

						$("#header-" + number).css("display", "block");
						$("#fpca_sumari_dogc" + number).css("display", "block");
					} else {
						var number = numDOGCRequest;

						$("#header-" + number).css("display", "block");
						$("#fpca_sumari_dogc" + number).css("display", "block");
					}

					$('.ui-datepicker-year').attr("title", fpca_sumari_DOGC_calendari_dogc.CONSTANTS.selectTitleLiteral);


				} else if (data.errorCode != undefined && data.errorDescription != undefined) {
					$(".errorSumari").text(data.errorCode + ": " + data.errorDescription);
				}
				showModalLoading(false);
			},
			error: function (jqXHR, textStatus, errorThrown) {
				error(jqXHR, textStatus, errorThrown);
				showModalLoading(false);
			}

		});


	}

