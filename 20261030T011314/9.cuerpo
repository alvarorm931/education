/******corrección de accesibilidad etiquetas de presentación para Pagination*****/
		Liferay.on('allPortletsReady' ,function()
		{
		
		if(document.querySelector(".lfr-pagination small.search-results") != null){
			var txt_interval = document.createElement("span");
			var content = document.querySelector(".lfr-pagination small.search-results").innerText;
			txt_interval.className="search-results";
			txt_interval.style="font-size: 80%;font-weight: 400;";
			txt_interval.innerHTML=content;
			var smallers=document.querySelectorAll(".lfr-pagination small.search-results");
			for (var i=0; i < smallers.length;i++){
