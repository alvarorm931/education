</form></div></div><script id="dlgIEIncompatible_s" type="text/javascript">$(function(){PrimeFaces.cw("Dialog","dlgIEIncompatible",{id:"dlgIEIncompatible",resizable:false,modal:true,width:"500",responsive:true});});</script>

	<script type="text/javascript">
	//<![CDATA[
		//Permite detectar la version de IE y si corre con Vista de Compatibilidad
		function IeVersion() {
			//Set defaults
			var value = {
				IsIE : false,
				TrueVersion : 0,
				ActingVersion : 0,
				CompatibilityMode : false
			};

			//Try to find the Trident version number
			var trident = navigator.userAgent.match(/Trident\/(\d+)/);
			if (trident) {
				value.IsIE = true;
				//Convert from the Trident version number to the IE version number
				value.TrueVersion = parseInt(trident[1], 10) + 4;
			}

			//Try to find the MSIE number
			var msie = navigator.userAgent.match(/MSIE (\d+)/);
			if (msie) {
				value.IsIE = true;
				//Find the IE version number from the user agent string
				value.ActingVersion = parseInt(msie[1]);
			} else {
				//Must be IE 11 in "edge" mode
				value.ActingVersion = value.TrueVersion;
			}

			//If we have both a Trident and MSIE version number, see if they're different
			if (value.IsIE && value.TrueVersion > 0 && value.ActingVersion > 0) {
				//In compatibility mode if the trident number doesn't match up with the MSIE number
				value.CompatibilityMode = value.TrueVersion != value.ActingVersion;
			}
			return value;
		}

		function comprobarIE() {
			var ie = IeVersion();
			if (ie.IsIE) {
				//openDlg('dlgIEIncompatible');
				// En vez de mostrar el dialogo de incompatibilidad, redirijo a la pagina de error (si no estoy ya en esa pagina)
				if (window.location.pathname != '/bop/xhtml/403IE.xhtml') {
					window.location.href = "/bop/xhtml/403IE.xhtml";
				}
			}
			/*alert("IsIE: " + ie.IsIE + "\n" + 
					"TrueVersion: " + ie.TrueVersion + "\n" +
					"ActingVersion: " + ie.ActingVersion + "\n" +
					"CompatibilityMode: " + ie.CompatibilityMode + "\n");*/
		}
		//]]>
	</script><div id="dlgStatusPortal" class="ui-dialog ui-widget ui-widget-content ui-corner-all ui-shadow ui-hidden-container ui-dialog-status-portal ui-dialog-fast-close-disabled"><div class="ui-dialog-titlebar ui-widget-header ui-helper-clearfix ui-corner-top"><span id="dlgStatusPortal_title" class="ui-dialog-title">Processant...</span></div><div class="ui-dialog-content ui-widget-content" id="dlgStatusPortal_content">

		<style>
			.ui-dialog-status-portal {
				background: none;
				box-shadow: none !important;
			}

			.ui-dialog-status-portal .ui-dialog-titlebar {
				display: none;
			}

			.ui-dialog-status-portal .ui-dialog-content {
				overflow: hidden;
				padding: 10px;
			}

			.ui-dialog-status-portal .status-message {
				display: block;
				text-align: center;
				margin: 53px 0;
				font-size: 18px !important;
				color: rgba(255, 255, 255, 0.8);
			}

			.ui-dialog-status-portal .loading-bell {
				width: 125px;
				height: 127px;
				border-radius: 100%;
				position: absolute;
				left: calc(50% - 62px);
			}

			.ui-dialog-status-portal-xs .loading-bell {
				width: 97px;
				height: 99px;
				left: calc(50% - 49px);
			}

			.ui-dialog-status-portal-xs .ui-dialog-content .status-message {
				margin: 40px 0;
				font-size: 15px !important;
			}

			.ui-dialog-status-portal-xl .loading-bell {
				width: 150px;
				height: 152px;
				left: calc(50% - 75px);
			}

			.ui-dialog-status-portal-xl .ui-dialog-content .status-message {
				margin: 62px 0;
				font-size: 24px !important;
			}

			.loading-circle {
				width: 100%;
				height: 100%;
				position: absolute;
			}

			.loading-circle .loading-inner {
				width: 100%;
				height: 100%;
				border-radius: 100%;
				border: 5px solid rgba(255,255,255,0.7);
				border-right: none;
				border-top: none;
				background-clip: padding-box;
				box-shadow: inset 0px 0px 10px rgba(255,255,255,0.15);
			}

			.loading-circle:nth-of-type(0) {
				transform: rotate(0deg);
					-o-transform: rotate(0deg);
					-ms-transform: rotate(0deg);
					-webkit-transform: rotate(0deg);
					-moz-transform: rotate(0deg);
			}

			.loading-circle:nth-of-type(0) .loading-inner {
				animation: loading-spin 2.3s infinite linear;
					-o-animation: loading-spin 2.3s infinite linear;
					-ms-animation: loading-spin 2.3s infinite linear;
					-webkit-animation: loading-spin 2.3s infinite linear;
					-moz-animation: loading-spin 2.3s infinite linear;
			}

			.loading-circle:nth-of-type(1) {
				transform: rotate(70deg);
					-o-transform: rotate(70deg);
					-ms-transform: rotate(70deg);
					-webkit-transform: rotate(70deg);
					-moz-transform: rotate(70deg);
			}

			.loading-circle:nth-of-type(1) .loading-inner {
				animation: loading-spin 2.3s infinite linear;
					-o-animation: loading-spin 2.3s infinite linear;
					-ms-animation: loading-spin 2.3s infinite linear;
					-webkit-animation: loading-spin 2.3s infinite linear;
					-moz-animation: loading-spin 2.3s infinite linear;
			}

			.loading-circle:nth-of-type(2) {
				transform: rotate(140deg);
					-o-transform: rotate(140deg);
					-ms-transform: rotate(140deg);
					-webkit-transform: rotate(140deg);
					-moz-transform: rotate(140deg);
			}

			.loading-circle:nth-of-type(2) .loading-inner {
				animation: loading-spin 2.3s infinite linear;
					-o-animation: loading-spin 2.3s infinite linear;
					-ms-animation: loading-spin 2.3s infinite linear;
					-webkit-animation: loading-spin 2.3s infinite linear;
					-moz-animation: loading-spin 2.3s infinite linear;
			}

			.loading-bell {
				animation: loading-spin 5.75s infinite linear;
					-o-animation: loading-spin 5.75s infinite linear;
					-ms-animation: loading-spin 5.75s infinite linear;
					-webkit-animation: loading-spin 5.75s infinite linear;
					-moz-animation: loading-spin 5.75s infinite linear;
			}

			@keyframes loading-spin {
				from {
					transform: rotate(0deg);
				}
				to {
					transform: rotate(360deg);
				}
			}

			@-o-keyframes loading-spin {
				from {
					-o-transform: rotate(0deg);
				}
				to {
					-o-transform: rotate(360deg);
				}
			}

			@-ms-keyframes loading-spin {
				from {
					-ms-transform: rotate(0deg);
				}
				to {
					-ms-transform: rotate(360deg);
				}
			}

			@-webkit-keyframes loading-spin {
				from {
					-webkit-transform: rotate(0deg);
				}
				to {
					-webkit-transform: rotate(360deg);
				}
			}

			@-moz-keyframes loading-spin {
				from {
					-moz-transform: rotate(0deg);
				}
				to {
					-moz-transform: rotate(360deg);
				}
			}
		</style>

