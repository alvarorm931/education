{"id": "bopgranada:BOPGR-2022-104-007", "fecha": "2022-06-02", "fuente": "BOP-GRANADA", "boletin": 104, "url": null, "url_pdf": null, "titulo": "Modificación de bases de convocatoria como personal funcionario interino de plaza de Técnico de Inclusión Social", "organismo": "Ayuntamiento de Aldeire", "seccion": "AYUNTAMIENTOS", "ambito": "local", "convocante": {"tipo": "Ayuntamiento", "nombre": "Aldeire", "provincia": "Granada", "organismo": "Ayuntamiento de Aldeire"}, "tipo_acto": "convocatoria", "alcance": "acceso", "modalidad": null, "tiene_texto": true, "extraccion": "plazo_general_v3", "pendiente": ["plazas", "extraccion_ia"], "citas": [{"boletin": "Boletín Oficial de la provincia de Granada", "numero": "8", "fecha": "2022-01-13"}, {"boletin": "Boletín Oficial de la provincia de Granada", "numero": "22", "fecha": "2022-02-02"}], "sedes": ["https://aldeire.sedeelectronica.es"], "plazo": {"cita": "“Visto que en el Boletín Oficial de la provincia de Granada nº 8 de fecha 13 de enero de 2022, se publicaron las Bases de la convocatoria para la provisión como personal laboral temporal, a tiempo parcial, por obra o servicio determinado de un Técnico de Inclusión Social, aprobadas por decreto de la Alcaldía 2022-0007 de fecha 4 de enero de 2022, concediéndose un plazo de presentación de solicitudes de diez días naturales, a contar desde el día siguiente al de la publicación del anuncio de la convocatoria en el B.O.P y exposición de la misma en el tablón de anuncios del Ayuntamiento en la sede electrónica https://aldeire.sedeelectronica.es.", "metodo": "plazo_general_v3", "dias": 10, "tipo": "naturales", "cuenta_desde": "su publicación", "fin_estimado": "2022-06-13", "fin_exacto": false, "calendario": "festivos de Andalucía (BOE; sin los locales, estimado)"}}
