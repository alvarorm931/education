rBoletin.do?fecha=20261016" rel = 'external'><div>   <span>Ord.</span></div> </a></td> <td class='noTieneDogv'> 17</td> <td class='noTieneDogv'> 18</td><td ></td></tr><tr><td ></td> <td class='siTieneDogv'>19<a class = 'diario_ordinario' href="/docm/cambiarBoletin.do?fecha=20261019" rel = 'external'><div>   <span>Ord.</span></div> </a></td> <td class='siTieneDogv'>20<a class = 'diario_ordinario' href="/docm/cambiarBoletin.do?fecha=20261020" rel = 'external'><div>   <span>Ord.</span></div> </a></td> <td class='siTieneDogv'>21<a class = 'diario_ordinario' href="/docm/cambiarBoletin.do?fecha=20261021" rel = 'external'><div>   <span>Ord.</span></div> </a></td> <td class='siTieneDogv'>22<a class = 'diario_ordinario' href="/docm/cambiarBoletin.do?fecha=20261022" rel = 'external'><div>   <span>Ord.</span></div> </a></td> <td class='siTieneDogv'>23<a class = 'diario_ordinario' href="/docm/cambiarBoletin.do?fecha=20261023" rel = 'external'><div>   <span>Ord.</span></div> </a></td> <td class='noTieneDogv'> 24</td> <td class='noTieneDogv'> 25</td><td ></td></tr><tr><td ></td> <td class='siTieneDogv'>26<a class = 'diario_ordinario' href="/docm/cambiarBoletin.do?fecha=20261026" rel = 'external'><div>   <span>Ord.</span></div> </a></td> <td class='siTieneDogv'>27<a class = 'diario_ordinario' href="/docm/cambiarBoletin.do?fecha=20261027" rel = 'external'><div>   <span>Ord.</span></div> </a></td> <td class='siTieneDogv'>28<a class = 'diario_ordinario' href="/docm/cambiarBoletin.do?fecha=20261028" rel = 'external'><div>   <span>Ord.</span></div> </a><a class = 'diario_extraordinario' href="/docm/cambiarBoletin.do?fecha=20261028-ext-2&numDogv=2" rel = 'external'><div>   <span>Ext.</span></div> </a></td> <td class='siTieneDogv'>29<a class = 'diario_ordinario' href="/docm/cambiarBoletin.do?fecha=20261029" rel = 'external'><div>   <span>Ord.</span></div> </a></td> <td class='siTieneDogv'>30<a class = 'diario_ordinario' href="/docm/cambiarBoletin.do?fecha=20261030" rel = 'external'><div>