    <script type="text/javascript">
        $(document).ready(function () {
            var menuSelIdTxt = 'portada';
            if (menuSelIdTxt.indexOf("portada") >= 0) {
                $('.menuactiu').removeClass('menuactiu');
                $('.submenuactiu').removeClass('submenuactiu');
            } else if (menuSelIdTxt.indexOf("menuId-") >= 0) {
                if (menuSelIdTxt.indexOf("#") >= 0) {
                    var menuSelIdSplit = menuSelIdTxt.split('#');
                    var menuSelId = menuSelIdSplit[0];
                    var submenuSelId = menuSelIdSplit[1];
                    $('.menuactiu').removeClass('menuactiu');
                    $('.submenuactiu').removeClass('submenuactiu');
                    $('#' + menuSelId).addClass('menuactiu');
                    $('#' + submenuSelId).addClass('submenuactiu');
                } else {
                    $('.menuactiu').removeClass('menuactiu');
                    $('#' + menuSelIdTxt).addClass('menuactiu');
                }
            }
            $('a[href="#"]').removeAttr("href");
            $('a[href=""]').removeAttr("href");

        });
    </script>



    
