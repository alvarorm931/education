{"identificador": "BOE-A-2022-4927", "control": "2022/4823", "titulo": "Acuerdo de 23 de marzo de 2022, del Tribunal calificador del proceso selectivo convocado por Acuerdo de 22 de octubre de 2020, de la Comisión Permanente del Consejo General del Poder Judicial, para la provisión de plazas entre juristas de reconocida competencia con más de diez años de ejercicio profesional en las materias propias de los órganos del orden civil, del orden penal o de los órganos con jurisdicción compartida, para el acceso a la Carrera Judicial por la categoría de Magistrado/a, por el que, en ejecución de sentencia, se modifica el Acuerdo de 27 de julio de 2021, por el que se aprueba la relación de aspirantes convocados a la realización del dictamen, así como la fecha y lugar de su celebración y lectura.", "diario": "75", "seccion_codigo": "2B", "seccion": "II. Autoridades y personal. - B. Oposiciones y concursos", "departamento_codigo": "1820", "departamento": "CONSEJO GENERAL DEL PODER JUDICIAL", "epigrafe": "Carrera Judicial", "url_pdf": "https://www.boe.es/boe/dias/2022/03/29/pdfs/BOE-A-2022-4927.pdf", "pagina_inicial": "40920", "pagina_final": "40920", "url_html": "https://www.boe.es/diario_boe/txt.php?id=BOE-A-2022-4927", "url_xml": "https://www.boe.es/diario_boe/xml.php?id=BOE-A-2022-4927", "fecha": "2022-03-29", "fuente": "boe-sumario", "captura_sha256": "5168b92e889c3d55d8f56e047bbe609e862204832a93636d68712bd42999e89a", "capturado": "2026-10-29T14:15:26+00:00", "ambito": "estatal", "tipo_acto": "tribunal", "modalidad": null, "alcance": "acceso", "convocante": null, "plazas": null, "plazas_texto": null, "puesto": null, "extraccion": "reglas", "pendiente_revision": []}
