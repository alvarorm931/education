        <script>
                const dominioOnline = 'bopsevilla.dipusevilla.es';
                let hostname = window.location.hostname;
                console.log('hostname: ', hostname);
                if (hostname !== dominioOnline && hostname !== 'bopsevilla-1.dipusevilla.es' && hostname !== 'bopsevilla-2.dipusevilla.es' && hostname !== 'bopsevilla-3.dipusevilla.es') {
                    console.log('Redirigimos desde el template a: ', dominioOnline);
                    window.location.href = window.location.protocol +
                        '//' +
                        dominioOnline +
                        window.location.pathname +
                        window.location.search;
                }
            </script>
