		function disableAllTheseDays(date) {
			var m = date.getMonth(), d = date.getDate(), y = date.getFullYear();
		
			//Corregimos mes y dí­a
			m = m + 1; 
			if(m < 10)
			{
				m = "0" + m;
			}
			if(d < 10)
			{
				d = "0" + d;
			}
		
			for (i = 0; i < enabledDays.length; i++) {
			if($.inArray(d + '/' + m + '/' + y,enabledDays) == -1) {
				return [false];
			}else{
				return [true];
			}
			}
		}
		function b(date) {
			var vals = date.split('/');
			var d = vals[0];
			var m = vals[1];
			var y = vals[2];
		
			var fecha = y + "-" + m + "-" + d; 
			
			document.location.href="index.jsp?fechaBoletin=" + fecha;
			
			/*var formulario = document.getElementById("frm_consultaCalendario");
			formulario.accionEfectuada.value = 1; //Es una búsqueda
			formulario.tipoBusqueda.value = 0; //Es una búsqueda por fecha
			formulario.fechaMarcada.value = fecha; //El valor de la fecha por la que buscaremos 
		
			formulario.submit();
			*/
		}

		$(document).ready(function() {


            	/* Inicialización en español para la extensión 'UI date picker' para jQuery. */
		/* Traducido por Vester (xvester@gmail.com). */
		jQuery(function($){
		        $.datepicker.regional['es'] = {
		                closeText: 'Cerrar',
		                prevText: '&#x3c;Ant',
		                nextText: 'Sig&#x3e;',
		                currentText: 'Hoy',
		                monthNames: ['Enero','Febrero','Marzo','Abril','Mayo','Junio',
		                'Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'],
		                monthNamesShort: ['Ene','Feb','Mar','Abr','May','Jun',
		                'Jul','Ago','Sep','Oct','Nov','Dic'],
		                dayNames: ['Domingo','Lunes','Martes','Mi&eacute;rcoles','Jueves','Viernes','S&aacute;bado'],
		                dayNamesShort: ['Dom','Lun','Mar','Mi&eacute;','Juv','Vie','S&aacute;b'],
		                dayNamesMin: ['Do','Lu','Ma','Mi','Ju','Vi','S&aacute;'],
		                weekHeader: 'Sm',
		                dateFormat: 'dd/mm/yy',
		                firstDay: 1,
		                isRTL: false,
		                showMonthAfterYear: false,
		                yearSuffix: ''};
		        $.datepicker.setDefaults($.datepicker.regional['es']);
				
				$("#datepicker").datepicker({beforeShowDay:disableAllTheseDays,maxDate:'+0d', dateFormat: 'dd/mm/yy',onSelect:b});			
	  	 		document.getElementById("datepicker").style.display = "";

		});



           

  	 		//$("#datepicker").datepicker({beforeShowDay:disableAllTheseDays,maxDate:'+0d', dateFormat: 'dd/mm/yy',onSelect:b});			
  	 		//document.getElementById("datepicker").style.display = "";

  	  	});
	</script>
	<div id="divFiltros" style="float:none;width:100%">
		<div id="divFiltrosIzq" style="float:left;">
			<div id="datepicker" style="margin-top:10px;margin-left:20px;min-height:190px;"></div>
		</div>
		<div id="divFiltrosDer" style="float:left;margin-left:20px;width:420px">
			<h2>Búsqueda</h2>
			<form name="frmBusqueda" action="index.jsp" method="post">
				<input type="hidden" name="fechaBoletin" value="">
				<br><strong>Fecha desde (dd/mm/aaaa):</strong> <input type="text" name="fDesde" id="fDesde" value="" maxlength="10" autocomplete="off">
				<script type="text/javascript">
				$(function() {
					$( "#fDesde" ).datepicker({maxDate:'+0d', dateFormat: 'dd/mm/yy'});
				});
				</script>
				<br>
				<br>
				<strong>Fecha hasta (dd/mm/aaaa):</strong>
				<input type="text" name="fHasta" id="fHasta" value="" style="margin-left:4px;" maxlength="10" autocomplete="off">
				<script type="text/javascript">
				$(function() {
					$( "#fHasta" ).datepicker({maxDate:'+0d', dateFormat: 'dd/mm/yy'});
				});
				</script>
				<br><br><strong>Texto:</strong> <br>
				<input type="text" name="texto" value="" style="width:100%">
				<br><strong>Etiquetas:</strong> <br>
