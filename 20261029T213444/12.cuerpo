                <div class="sgsection-main_container con_padding seccion-cve-suscripcion-home publica  "  data-cssid="sgsection_n144072">
                <div class="sgsection-main_wrapper">
                <div class="cms_container-section" ><div class="sgrow-main_container doscol-home-buscador-banners      " id="sgrow_n144037" data-cssid="sgrow_n144037" >
        <div class="sgrow-wrapper">


        <div class="sgrow-columna col_xxs-12 col_xs-12 col_sm-12 col_md-6 col_lg-6 col-izda"  data-cssid="sgrowcolumn_n156784" data-recursos-tipo="content">

                    <div class="cms_container-row" ><div class="destacado-bop">
                    <div class="contenedor-destacado">
                        <h2>
                            Encuentra anuncios, boletines y sumarios por número</h2>
                    <div class="contenido h2">
                            <p style="text-align: center;">Busca anuncios, boletines y sumarios publicados en el BOPH por su número CSV. Introduce el número en el siguiente campo y pulsa buscar.</p></div>
                    </div>
                </div>

            

	
	
		
			<div class="zona_publica cve">
        <div class="buscador_anuncios cve">
            <form class="formulario" action="/publica/resultados-busqueda-de-anuncios-por-cve/" method="post" id="buscador_anuncios_cve">
                <div class="fila cve">
                    <div class="elemento termino col_sm-12 col_lg-12 col_md-12 col_sm-12">
                        <input title=' Buscar anuncios por CVE'
                               type="text" id="cve_es_s" name="cve_es_s" class="termino"
                               value=""
                               placeholder="Introduce el código CSV"
                               onfocus="this.placeholder = 'Introduce el código CSV'"
                               onblur="this.placeholder = 'Introduce el código CSV'"
                        />
                        <input type="hidden" id="queryExtra" name="queryExtra">

                    </div>
                </div>
                <div class="fila recaptcha">
                        <div class="wrapper-recaptcha">
                            <div class="g-recaptcha" data-sitekey="6Le9dlgtAAAAAPLxktXClTzFHJaLVaYJTFr-vuIy"></div>
                        </div>
                    </div>
                <div class="fila boton">
                    <div class="acciones">
                        <input id="buscarPorCve" type="submit" value="Buscar" id="lanzar_formulario"/>
                    </div>
                </div>
            </form>
        </div>
    </div>
    <script>
        const cveRegex = '^BOPH-(E-)?\\d{4}-\\d{2,3}(\\d{3,6})?$';
        const tenemosReCaptcha = true;
        const isOnlineProject = true;

        $.validator.addMethod(
            "validaCve",
            function (value, element, regexp) {
                if (value) {
                    let re = new RegExp(regexp);
                    return re.test(value);
                } else {
                    return true
                }
            },
            "<div><p>El CSV debe tener el siguiente formato: <b>BOPH-E-YYYY-###XXX</b></p><p>Donde:</p><ul><li><b>BOPH</b>: es un valor fijo. Todos los boletines empezarán de la misma forma.</li><li><b>E</b>: indica que se trata de un boletín extraordinario. Es opcional y se puede omitir.</li><li><b>YYYY</b>: año de publicación del BOP.</li><li><b>###</b>: número del BOP de hasta tres dígitos, completando por la izquierda con 0.</li><li><b>XXX</b>: número secuencial del anuncio de tres dígitos, completando por la izquierda con 0. Para boletines y sumarios se puede omitir.</li></ul></div>"
        );

        $('form#buscador_anuncios_cve').validate({
            rules: {
                cve_es_s: {
                    required: true,
                    validaCve: "^BOPH-(E-)?\\d{4}-\\d{2,3}(\\d{3,6})?$"
                }
            },
            messages: {
                cve_es_s: {
                    required: "Debe indicar un CSV",
                    validaCve: "<div><p>El CSV debe tener el siguiente formato: <b>BOPH-E-YYYY-###XXX</b></p><p>Donde:</p><ul><li><b>BOPH</b>: es un valor fijo. Todos los boletines empezarán de la misma forma.</li><li><b>E</b>: indica que se trata de un boletín extraordinario. Es opcional y se puede omitir.</li><li><b>YYYY</b>: año de publicación del BOP.</li><li><b>###</b>: número del BOP de hasta tres dígitos, completando por la izquierda con 0.</li><li><b>XXX</b>: número secuencial del anuncio de tres dígitos, completando por la izquierda con 0. Para boletines y sumarios se puede omitir.</li></ul></div>"
                }
            }
        });

        // Convertimos lo que se introduzca en el campo del CVE a mayúsculas porque así lo requiere la validación
        $('#cve_es_s').on('input', function () {
            this.value = this.value.toUpperCase();
        });

        $(document).on('click', '#buscarPorCve', function (e) {
            e.preventDefault();

            if (tenemosReCaptcha && grecaptcha.getResponse() == "" && isOnlineProject) {
                // ERROR en captcha
                $('.g-recaptcha').append('' +
                    '<div style="background: #c33; color: #FFF; padding: 4px 8px; vertical-align: middle; font-size: 12px !important; width: 100%;">' +
                    '   Debe pasar la validación para poder continuar' +
                    '</div>');
            } else {
                if ($('form#buscador_anuncios_cve').validate().checkForm()) {
                    // Si se valida el formulario, generamos: queryExtra
                    // Ejemplo: &fq=cve_es_s:"BOP-LE-2024-054009"
                    let valorQueryExtra = '&fq=(cve_es_s:"' + $('#cve_es_s').val() + '" OR bop.cve_prop:"' + $('#cve_es_s').val() + '")'
                    $('#queryExtra').val((valorQueryExtra));
                    $('form#buscador_anuncios_cve').submit();
                } else {
                    $('form#buscador_anuncios_cve').validate().showErrors();
                }
            }
        });


    </script>

		
		
	

