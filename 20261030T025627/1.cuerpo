<script>

	$(document).ready(function() {

                // Buscamos todos los enlaces que contengan la cadena en su atributo href

                $('a[href*="://gestion-www."').each( function(){
                              // Para todas aquellas cadenas encontradas, reemplazamos dicha cadena por su correspondencia
                               $(this).attr('href', $(this).attr('href').replace('://gestion-www.', '://www.'));       
                });


                /* Forzamos apertura en una nueva pestaña de las siguientes URLs*/
		let direcciones = [
			'/anuncios-y-convocatorias/boletin-oficial-provincia', 
			'/anuncios-y-convocatorias/empleo/autorizaciones-de-compatibilidad-a-empleados-publicos', 
			'/anuncios-y-convocatorias/empleo/normativa-en-relacion-con-el-personal', 
			'/anuncios-y-convocatorias/empleo/oferta-de-empleo-publico', 
			'/anuncios-y-convocatorias/empleo/relacion-de-puestos-de-trabajo', 
			'/anuncios-y-convocatorias/perfil-de-contratante', 
			'/anuncios-y-convocatorias/tablones-de-anuncios-electronicos', 
			'/ciudadania/consumo', 
			'/ciudadania/contratacion-y-patrimonio/patrimonio', 
			'/ciudadania/fomento-e-infraestructuras/proyectos-en-exposicion-publica', 
			'/ciudadania/productos-de-leon/tienda-online-productos-leoneses', 
			'/ciudadania/recursos-humanos/autorizaciones-de-compatibilidad-a-empleados-publicos', 
			'/ciudadania/recursos-humanos/normativa-en-relaccion-con-el-personal', 
			'/ciudadania/recursos-humanos/oferta-de-empleo-publico', 
			'/ciudadania/recursos-humanos/relacion-de-puestos-de-trabajo', 
			'/diputacion/informacion-economica-y-presupuestaria/presupuestos-e-informacion-economica-diputacion-de-leon', 
			'/diputacion/transparencia', 
			'/turismo/cueva-de-valporquero',
			'/turismo/san-isidro-estacion-invernal-y-de-montana',
			'/turismo/leitariegos-estacion-invernal-y-de-montana',
			'/diputacion/organigrama-y-responsables',
			'/diputacion/organos-de-gobierno/dedicaciones-retribuciones-y-asistencias',
			'/diputacion/organos-de-gobierno/nombramiento-de-personal-eventual'
		];
		
		$.each(direcciones, function(key, value) {         
		   $('body a[href="' + value + '"]').attr('target', '_blank');

		});


// Comprobamos si existe algún elemento "seleccionado"/"desplegado" en menu izquierda y recolocamos

if ($('div.columna-menu-secundario ul.MenuLeon-listado[data-nivel="1"]:last li.activoInicial:first').length == 1) {

                // Seleccionamos del último elemento de bloques, el primer elementos activo  y lo asignamos al principio de la lista.

                $('div.columna-menu-secundario ul.MenuLeon-listado[data-nivel="1"]:last li.activoInicial:first').prependTo($('div.columna-menu-secundario ul.MenuLeon-listado[data-nivel="1"]:last'));

}


	});
</script>
