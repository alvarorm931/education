function paginacion(num) { var busqueda = obtenerValorParametro("busqueda");
    var start = (num - 1) * 20;
    if (busqueda == "tge") {
        var tipo = obtenerValorParametro("tipo");
        var grupo = obtenerValorParametro("grupo");
        var entidad = obtenerValorParametro("entidad");
        var desde = obtenerValorParametro("desde");
        var hasta = obtenerValorParametro("hasta");
        if (grupo == "null") {
            grupo = -1;
        }
        if (entidad == "null") {
            entidad = -1;
        }
        var limit = obtenerValorParametro("limit");
        loadAnunciosTipoGrupoEntidadPag(tipo, grupo, entidad, desde, hasta, start, limit, num);
    } else if (busqueda == "tc") {
        var tipos = obtenerValorParametro("tipos");
        var desde = obtenerValorParametro("desde");
        var hasta = obtenerValorParametro("hasta");
        var limit = obtenerValorParametro("limit");
        loadAnunciosTipoContenidoPag(tipos, desde, hasta, start, limit, num);
    } else if (busqueda == "ba") {
        var texto = obtenerValorParametro("texto");
        var tipo = obtenerValorParametro("tipo");
        var grupo = obtenerValorParametro("grupo");
        if (grupo == "null") {
            grupo = -1;
        }
        var entidad = obtenerValorParametro("entidad");
        if (entidad == "null") {
            entidad = -1;
        }
        var tipos = obtenerValorParametro("tipos");
        var desde = obtenerValorParametro("desde");
        var hasta = obtenerValorParametro("hasta");
        var limit = obtenerValorParametro("limit");
        loadAnunciosBusqAvanzadaPag(texto, tipo, grupo, entidad, tipos, desde, hasta, start, limit, num);
    }
}

