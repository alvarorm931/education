 "texto": "Data 6-6-2024\n\u0001\u0002\u0003\u0004\u0005\u0006\u0007\b\n\u0002 \u0005 \u000e\u0005\u0007\u000e\u0005 \b\u000e \b\u000f\u0010\u0011\u0012\u0013\u0014\u0013\u0015\u0016\u0015\u0013\u0017 \u000f\u0010 \u001a \u0010\u001b \u0010\u000f\u0013\u0010\u0011\u0012 \u0002\u001b \u0010\u000f\u0013\u0010\u0011\u0012\u0001\u0002\u0003\u0004\u0005\u0006\u0007\b\u0003\u0004\u0004 \u0006 \u0004 \u000e\n\u0012\u0010 \u0002\n\u000e\u000f\u0010\u0011\u000e\u0010\u0011\u0012\u0013 \u0002 \u0015\u0016\u0017 \u0002 \u0018\u000f\u0019 \u0002 \u001a\u001b\u0010 \u0002 \u0016\u0015\u000f \u0002 \u000f\u0012\u0010 \u0002 \u0016\u000f\u0016 \u0002 \u0011 ! \u0002 \u0010 \u0002 \"\u0016\u000f\n\u0010\u0017 \u0002 \u0017\u0010# \u000f\u0010\u0017 \u0002 $\u0012% \u0002 \u0016 \u0011\u0010\u000e\u0016& \u000f\u0012\u0010\u0002\n\"\u0016\u000f\n\u0010\u0017\u0002'\u001b\u0010\u0017\u0012$\u0012\u0011\u0010\u000e\u0002\u0015( $\u0012\u0011\u0012 \u0002\u0010!#\u0002\u0010\u0015 \u0011\u000f\u0012\"\u0011\u0012\u0013\u0002\u0010\u0017\u0002\u0017\u0017 \u0011\u0002\u0015\u0016\u0002\u000e\u000f\u0016#\u0010\u0017\u0017\u0002\u0015\u0016\u0002 \u0010\"\u0002\u0015\u0016\u0002\u0017\u0010\u0002#\u000f\u0012&\u0010\u0015\u0010 \u0015(\u0016 \"\u0010\u0012 \u0002\")#\u0017\u0012\u0011 \u0019*\"\u000f \u0011+ \u0002\u0016 \u000e\u0010#\u0012\u0017\u0012\u000e \u0010\u0011\u0012\u0013, \u0003\u0010!\"\u0010\u0013 #\u0010 \u0012$!\u0001\u0002-\u0016\u0011\u001b\u000f\n\u0002.\u001b!\u0010\n\u0019 \u000e\u0011\u0012\u0010\u0015\u0010\u000f\u0010\u0011\u0012\n\u0003\u0019\u0007\u0002 \u0016\u000f\u0002-\u0016\n\u0017\u001b\u0011\u0012\u0013\u0002\u0015\u0016\u0002\u0017( \u0017\u0011\u0010\u0017\u0015\u0012\u0010\u0002 )!\u0019 \u0001/0 \u0007 \u0006\u0005 \u0007 \u0006\n\u0002\u0015\u0016\u0002\u0015\u0010\u000e\u0010\u0002\u0003 \u0002\u0015\u0016\u0002\u0015\u0016 \u0016!#\u000f\u0016\u0002\u0015\u0016\u0002 \u0006\n\u0002\u0016 \u0002\u00021\u0010 \u0010\"\u000f 1\u0010\u000f\u0002 \u0002\u0017\u0010\u0002\n1 \u0011\u0010\u000e2\u000f\u0012\u0010\u0002\u0012\u0002\u0017\u0016 \u00024\u0010 \u0016 \u0002\u0015\u0016\u0017\u0002\"\u000f \u0011+ \u0002 \u0016\u0017\u0016\u0011\u000e\u0012\u001b\u0002\u0015(\u001b \u0010\u0002 \"\u0017\u00105\u0010\u0002\u0015\u0016\u0002\"\u0016\u000f\n\u0010\u0017\u0002'\u001b\u0010\u0017\u0012$\u0012\u0011\u0010\u000e \u0015( $\u0012\u0011\u0012 \u0002*&\u000f\u001b\"\u0002\n,\u0002\u0016 \u0002\u000f7&\u0012!\u0002\u0015\u0016\u0002\"\u0016\u000f\n\u0010\u0017\u0002\u0017\u0010# \u000f\u0010\u0017\u0002$\u0012%\u0002!\u0012\u000e8\u0010 5\u0010 \u000e\u0002 \u0012 \u000e\u0016!\u0010\u0002\u0011\n\u0011\u001b\u000f \u0002\u0016%\u000e\u000f\u0010 \u000f\u0015\u0012 \u0010\u000f\u0012\u0002\u0012 \u0016%\u0011\u0016\"\u0011\u0012\n\u0010\u0017 \u0002\u0015(\u0010\u0011\u0011+ \u0002\u0017\u0017\u0012\u001b\u000f\u0016 \u0002\u0017\u0016 \u0002'\u001b\u0010\u0017 \u00021\u0010 \u0002 \u0016\u000f\u0002\"\u001b#\u0017\u0012\u0011\u0010\u0015\u0016 \u0002\u0010\u0017\u000249 4\u0002\u0015\u0016\u0002\u0015\u0010\u000e\u0010\u0002\u0003\u0004\u0002\u0015\u0016\u0002\u0015\u0016 \u0016!#\u000f\u0016\u0002\u0015\u0016\n\u0006\n\u0002\u0012\u0002\u0010\u0017\u0002/9:\n\u0002\u0015\u0016\u0002\u0015\u0010\u000e\u0010\u0002\b\u0006\u0002\u0015\u0016\u0002\u0015\u0016 \u0016!#\u000f\u0016\u0002\u0015\u0016\u0002 \u0006\n\u0019\n\u0019\u0007\u0002;\u0016 \u0002$\u0010 \u0016 \u0002\u0015\u0016\u0002\u0017\u0010\u0002\u0011\n1 \u0011\u0010\u000e2\u000f\u0012\u0010\u0002*1\u0010\u0017 \u000f\u0010\u0011\u0012\u0013\u0002\u0015\u0016\u0002!7\u000f\u0012\u000e ,\u00021\u0010 \u0002\u000e\u0016 \u0012\u000f\u0002\u0017\u0017 \u0011\u0002\u0016\u0017\u0002\u0015\u0012\u0010\u0002 \u0004\u0002\u0015(\u0010#\u000f\u0012\u0017\u0002\u0015\u0016\u0002 \u0006 \u0004\u0019 \b\u0019\u0007\u0002 \u0002\u0017(\u0010\u0011\u000e\u0010\u0002$\u0012 \u0010\u0017\u0002\u0015\u0016\u0017\u0002\"\u000f \u0011+ \u0002 \u0016 \u0017\u0016\u0011\u000e\u0012\u001b \u0002\"\u001b#\u0017\u0012\u0011\u0010\u0015\u0010\u0002\u0010\u0002\u0017(\u0016<\u0010\u001b\u0017\u0016\u000f\u0002\u0016 \u0002\u0015\u0010\u000e\u0010\u0002\u0003\u0005\u0002\u0015\u0016\u0002!\u0010\u0012&\u0002\u0015\u0016\u0002 \u0006 \u0004 \u0002\u0016\u0017 <\u000f\u0012#\u001b \u0010\u0017\u0002'\u001b\u0016\u0002\u0017(=\u0010\u0002'\u001b\u0010\u0017\u0012$\u0012\u0011\u0010\u000e\u0002=\u0010\u0002\u0016\u0017\u00161\u0010\u000e\u0002\"\u000f \"\n\u000e\u0010\u0002\u0015\u0016\u0002\u0011\n\u000e\u000f\u0010\u0011\u000e\u0010\u0011\u0012\u0013 \u0002\u0002\u0010\u0002$\u00101 \u000f\u0002\u0015\u0016\u0017\u0002\u0018\u000f\u0019\u0002\u001a\u001b\u0010 \u0002 \u0016\u0015\u000f \u0002 \u000f\u0012\u0010\n+\u000f\u0016 \u0002\u0010!#\u0002/>?\u0002 \u0002 \u0002\u0010\u0002\u0017\u0010\u00021\u0012 \u000e\u0010\u0002\u0015\u0016\u0017\u0002\u000f\u0016 \u001b\u0017\u000e\u0010\u000e\u0002\u0015\u0016\u0017\u0002\"\u000f \u0011+ \u0002 \u0016\u0017\u0016\u0011\u000e\u0012\u001b\u0002\u0012\u0002=\u0010\u0002\u000f\u0016'\u001b\u0016\u000f\u0012\u000e\u0002\u0010\u0002\u0017\u0010 \"\u0016\u000f\n\u0010 \u0002 \"\u000f \"\n\u0010\u0015\u0010 \u0002 \"\u0016\u000f \u0002 \u0010 \u0002 '\u001b7 \u0002 \"\u000f\u0016 \u0016 \u000e\u0012 \u0002 \u0017\u0010 \u0002 \u0015 \u0011\u001b!\u0016 \u000e\u0010\u0011\u0012\u0013 \u0002 \u000f\u0012&\u0012 \u0010\u0017 \u0002 \u0010\u0011\u000f\u0016\u0015\u0012\u000e\u0010\u000e\u00121\u0010 \u0002\u0015\u0016\u0017 \u0002 \u000f\u0016'\u001b\u0012 \u0012\u000e\n\u0015(\u0010\u0011\u0011+ \u0002\u0012\u0002\u0015 \u0011\u001b!\u0016 \u000e \u0002\u0016 !\u0016 \u000e\u0010\u000e \u0002\u0010\u0002\u0017\u0010\u0002#\u0010 \u0016\u0002 \u0016&\n\u0010\u0002\u0015\u0016\u0002\u0017\u0010\u0002\u0011\n1 \u0011\u0010\u000e2\u000f\u0012\u0010\u0019\u0019 \u0004\u0019\u0007\u00020 \u0002\u0015\u0010\u000e\u0010\u0002 \u0003\u0002\u0015\u0016\u0002!\u0010\u0012&\u0002\u0015\u0016\u0002 \u0006 \u0004 \u0002!\u0012\u000e8\u0010 5\u0010 \u000e\u0002\u000f\u0016&\u0012 \u000e\u000f\u0016\u0002\u0015(\u0016 \u000e\u000f\u0010\u0015\u0010\u00020 \u0006\u0006@\b\u0005\u0006\u0007 \u0006 \u0004 \u0002\u0016\u0017\u0002\u0018\u000f\u0019\u001a\u001b\u0010 \u0002 \u0016\u0015\u000f\n\u000f\u0012\u0010 \u0002 +\u000f\u0016 \u0002=\u0010\u0002\u0010\" \u000f\u000e\u0010\u000e\u0002\u0017\u0010\u0002\u0015 \u0011\u001b!\u0016 \u000e\u0010\u0011\u0012\u0013\u0002 \u000f\u0012&\u0012 \u0010\u0017\u0002\u000f\u0016'\u001b\u0016\u000f\u0012\u0015\u0010\u0019 A\u0019\u0007\u00020\u0017\u0002\u0018\u000f\u0019\u0002 \u000f\u0012\u0010 \u0002 +\u000f\u0016 \u0002 \u0002=\u0010\u0002 \u0016 \u000e\u0010\u000e\u0002\u0012 $ \u000f!\u0010\u000e\u0002\u0015\u0016\u0002\u0017\u0016 \u0002\u0011\n\u0015\u0012\u0011\u0012\n\u0002\"\u0016\u000f \u0002\u0017\u0010\u0002 \u00161\u0010\u0002\u0011\n\u000e\u000f\u0010\u0011\u000e\u0010\u0011\u0012\u0013\u0002\u0012\u0002\u0017\u0016 \u0002=\u0010 \u0010\u0011\u0011\u0016\"\u000e\u0010\u000e\u0019 @\u0019\u0007\u0002D\u001b\u0016\u0002\u0017\u0010\u0002\u0011\n\u000e\u000f\u0010\u0011\u000e\u0010\u0011\u0012\u0013\u0002\u0011 !\u0002\u0010\u0002\"\u0016\u000f\n\u0010\u0017\u0002\u0017\u0010# \u000f\u0010\u0017\u0002$\u0012%\u0002\u0016 \u0002\u0011\u0010\u000e\u0016& \u000f\u0012\u0010 \u0002\n\u0002*\"\u0016\u000f\n\u0010\u0017\u0002'\u001b\u0010\u0017\u0012$\u0012\u0011\u0010\u000e\u0002\u0015( $\u0012\u0011\u0012 , = \u0002\u0002+ \u0002\u0010!#\u0002\u0010\u0015 \u0011\u000f\u0012\"\u0011\u0012\u0013\u0002\u0002\"\u000f 1\u0012 \u0012\n\u0010\u0017\u0002\u0010\u0017\u0002\u0017\u0017 \u0011\u0002\u0015\u0016\u0002\u000e\u000f\u0016#\u0010\u0017\u0017\u0002\u0015\u0016\u0002 \u0010\"\u0002\u0015\u0016 \u0002\u0017\u0010\u0002#\u000f\u0012&\u0010\u0015\u0010\u0002\u0015(\u0016 \"\u0010\u0012 \u0002\")#\u0017\u0012\u0011 \u0002$\u0012\n\u0002\u0010 \u0017\u0010\u0002 \u00161\u0010\u0002\u0011 #\u0016\u000f\u000e\u001b\u000f\u0010\u0002\u0015\u0016$\u0012 \u0012\u000e\u00121\u0010\u0002\"\u0016\u0017\u0002 \u0012 \u000e\u0016!\u0010\u0002\u0015\u0016\u0002\u0011\n\u0011\u001b\u000f \u0002\u0015\u0016\u0002\"\u000f 1\u0012 \u0012\u0013\u0002\u0010\u0017 \u0002\u0017\u0017 \u0011 \u0002\u0015\u0016\u0002\u000e\u000f\u0016#\u0010\u0017\u0017\u0019 \u0005\u0019\u0007\u0002E\u0012 \u000e\u0002\u0017(\u0012 $ \u000f!\u0016\u0002\u0015\u0016\u0002\u0017\u0010\u0002\u000f\u0016 \"\n\u0010 #\u0017\u0016\u0002\u0015\u0016\u0002-\u0016\u0011\u001b\u000f\n\u0002.\u001b!\u0010\n\u0002\u0015\u0016\u0002\u0015\u0010\u000e\u0010 \u0002\b\u0002\u0015\u0016\u00028\u001b F\u0002\u0015\u0016\u0002 \u0006 \u0004\u0002\u0012\u0002'\u001b\u0016 \u0011\n\u000e\u0010\u0002\u0015\u0012\n\u0002\u0017(\u0016%\"\u0016\u0015\u0012\u0016 \u000e\u0019 %$\u0011\u0016 \u0010\u0011\u0012\n& !'\u000f\u0013\u0015\n\u0002\u0003 /\u0016\u0011\u000f\u0016\u000e\u0002 \u0003\u0004 \u0003BB\u0006 \u0002\u0015\u0016\u0002\b\u0006\u0002\u0015\u0016\u00028\u001b\u0017\u0012 \u0017\u0002\"\u0016\u0017\u0002'\u001b\u0010\u0017\u0002 (\u0010\"\u000f 1\u0010\u0002\u0016\u0017\u0002-\u0016&\u0017\u0010!\u0016 \u000e \u0002\u0015\u0016\u0017\u0002 \u0016\u000f\n\u0010\u0017\u0002\u0010\u0017\u0002\u0018\u0016\u000f1\u0016\u0012 \u0015\u0016\u0002\u0017\u0016 \u00020 \u000e\u0012\u000e\u0010\u000e \u0002;\n\u0011\u0010\u0017 \u0019\n\u0019 /\u0016\u0011\u000f\u0016\u000e\u0002;\u0016&\u0012 \u0017\u0010\u000e\u0012\u001b\u0002\u0003 B\u0005\u0002\u0015\u0016\u0002\b\u0003\u0002\u0015( \u0011\u000e\u001b#\u000f\u0016\u0002\"\u0016\u000f\u0002\u0016\u0017\u0002'\u001b\u0016\u0002 (\u0010\"\u000f 1\u0010\u0002\u0017\u0010\u0002\u000f\u0016$\n\u0010\u0002\u0016 \u0002\u001b \u0002\u000e\u0016%\u000e\u0002) \u0012\u0011\u0002\u0015\u0016\u0017\n\"\u000f\u0016\u0011\u0016\"\u000e\u0016 \u0002 \u0015\u0016 \u0002 \u0015\u0016\u000e\u0016\u000f!\u0012 \u0010\u000e \u0002 \u000e\u0016%\u000e\n\u0002 \u0017\u0016&\u0010\u0017 \u0002 1\u0012&\u0016 \u000e \u0002 \u0010 \u00