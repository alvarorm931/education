	$('body').on('keydown', '.lastFocusElement', function(e){
        if (e.keyCode == 9) {
			if (e.shiftKey) {
			}else{
				e.preventDefault();
				$(this).parents('div[role="dialog"]').find('.firstFocusElement').focus();
			}
        }
    });
	
	$('body').on('keydown', '.firstFocusElement', function(e){
        if (e.keyCode == 9) {
            if (e.shiftKey) {
				e.preventDefault();
				$(this).parents('div[role="dialog"]').find('.lastFocusElement').focus();
                   
            }else{
			}
        }
    });
	
	window.addEventListener('load', function () {
		setTimeout(function() {

			var divBarraaceptacion = document.querySelector("#barraaceptacion.lan-modal");
			var divModalbackdrop = document.querySelector(".modal-backdrop.fade.show");
			var divAvisocookies = document.querySelector("#aviso-cookies-cuadrocontenido");

			if (!divBarraaceptacion || !divModalbackdrop) {
				return;
			}
			var rect = divBarraaceptacion.getBoundingClientRect();
			var visible =
				rect.width > 0 &&
				rect.height > 0 &&
				rect.bottom > 0 &&
				rect.right > 0 &&
				rect.top < window.innerHeight &&
				rect.left < window.innerWidth;

			if (!visible) {
				divModalbackdrop.remove();
				document.body.classList.remove('modal-open');
				divBarraaceptacion.style.removeProperty('display');
				if (divAvisocookies) {
					divAvisocookies.style.removeProperty('display');
					divAvisocookies.classList.remove('show'); 
				}			
			}      

		}, 1000);
	});
	
