{
 "identificador": "BOE-A-2010-9869",
 "titulo": "Resolución de 28 de mayo de 2010, de la Universidad Complutense de Madrid, por la que se publica el plan de estudios de Graduado en Geología.",
 "fecha_publicacion": "20100621",
