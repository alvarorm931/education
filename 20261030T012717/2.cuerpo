			</div>
			<div class="modal-footer">
				<button id="cancelarBorrar" class="btn btn-default" data-dismiss="modal">Cancelar</button>
				<button id="aceptarBorrar" class="btn btn-primary" data-dismiss="modal">Aceptar</button>
			</div>
		</div>
	</div>
</div>
<div class="modal fade" id="modalFormTitulos" tabindex="-1" role="dialog" aria-labelledby="modalFormTitulosLabel" aria-hidden="true">
	<div class="modal-dialog" role="document">
		<div class="modal-content">
			<div class="modal-header">
				<h4 class="modal-title" id="modalFormTitulosLabel">Información</h4>
				<button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
			</div>
			<div class="modal-body">
				<p>Si usted necesita ampliar el plazo para subsanar la documentación requerida de su expediente deberá aportar, a través de la  <a href="https://universidades.sede.gob.es/login">Subsede Electrónica de la Secretaría General de Universidades (universidades.sede.gob.es)</a>, un documento firmado por el interesado solicitando la prórroga.</p>
				<p>Para ello, deberá acceder a su expediente desde la sección “Mis expedientes” y anexar el documento en “Aportar documentación”.</p>
				<p>Si su expediente no estuviera en la sede electrónica, puede aportar la solicitud a través del <a href="https://ciencia.sede.gob.es/pagina?id=Portada-104008">Registro Electrónico General (ciencia.sede.gob.es).</a></p>
				<p>Tenga en cuenta que se le conceden 35 días hábiles adicionales para subsanar la documentación sin necesidad de que se le responda a esta solicitud.</p>
				<p>Si su consulta no tuviera relación con esta información de solicitud de ampliación de plazo, podrá detallarla y completarla en el campo de “Contenido de su consulta”.</p>
			</div>
			<div class="modal-footer">
				<button class="btn btn-primary" data-dismiss="modal">Aceptar</button>
			</div>
		</div>
	</div>
</div>
<div class="footerScripts">
<div class="container-fluid htmlTxt">
	<style>
    
    #footer p.titulo {
        color: #1D1D1B;
    }
    
</style>
</div></div>


		<div class="cookies">
			<div class="cookiesContent">
				<form method="post" id="cookiesForm">
					<fieldset>
					<legend class="n1">Su privacidad es importante para nosotros</legend>
					</fieldset>
						
					<div class="text-container">

						<div class="text-box">
                                <div>
<p>Utilizamos cookies propias para el correcto funcionamiento y visualizaci&oacute;n del sitio web y cookies de terceros para la recogida de estad&iacute;sticas. Las cookies no almacenan ning&uacute;n tipo de datos personales sobre el usuario y se asocian &uacute;nicamente al navegador que est&aacute; utilizando.</p>

<p>Si se selecciona &quot;ACEPTAR&quot; estar&aacute; aceptando el uso tanto de las cookies propias como de las estad&iacute;sticas, mientras que si selecciona &quot;RECHAZAR&quot; solo se utilizar&aacute;n las cookies propias estrictamente necesarias para la navegaci&oacute;n por el sitio web.</p>

<p>Al navegar por nuestra web estar&aacute;s aceptando el uso de las cookies en las condiciones establecidas en esta <a href="
https://www.ciencia.gob.es/InfoGeneralPortal/Cookies.html">Pol&iacute;tica de Cookies</a> que puede ser actualizada, por lo que te invitamos a revisarla de manera regular.</p>
</div>

						</div>
						
						<div class="hidden">
							<label for="cookies-tecnicas">
								<strong><span class="underline">Cookies técnicas</span></strong> <span class="nota">Cookies técnicas</span>
							</label>
							<input type="checkbox" id="cookies-tecnicas" checked="checked">
							<span class="checkmark-disabled "></span>
						</div>
						<div class="hidden">
							<label for="cookies-analitica">
								<input type="checkbox" id="cookies-analitica" checked="checked">
								<span class="checkmark"></span>
								<span class="cookie-text"><strong>Cookies de analítica</strong></span><span class="nota">(Seleccionándolo dispones de una mejora en la experiencia de la navegación)</span>
							</label>
						</div>
					</div>
					<div class="buttons-container">
						<button id="aceptar-cookies" class="generic-button">Aceptar</button>
						<button id="rechazar-cookies" class="generic-button">Rechazar</button>
						<a id="personalizar-cookies" class="generic-button-2">Personalizar</a>
					</div>
				</form>
			</div>
		</div>
		

		<div class="modal fade" id="modalDescartar" tabindex="-1" role="dialog" aria-labelledby="modalDescartarLabel">
			<div class="modal-dialog" role="document">
				<div class="modal-content">
					<input type="hidden" name="batchUpdateIdsDerechos" id="batchUpdateIdsDerechos" value="">
					<div class="modal-header">
						<h4 class="modal-title" id="modalRegenerarLoteLabel">Cookies</h4>
					</div>
					<div class="modal-body">
						<p>Se han guardado sus preferencias en cuanto a cookies. Para cambiar sus preferencias en cualquier momento, consulte nuestra política de cookies o siga el enlace que figura a pie de página.</p>
					</div>

				</div>
			</div>
        </div>
		

<script>
var urlCookies = '/InfoGeneralPortal/Cookies/CookiesPersonalizar.html';
function cookiesConfig() {
	if (!(/usuario_mci=sesion_iniciada|digitalDataInfo;domain=ciencia\.gob\.es/).test(document.cookie)) {
		//si el usuario no ha aceptado todavía las cookies, muestra el pop-up de cookies

		var now = new Date().getTime();
		var expireDate = now + (1000*60*60*24*365);
		$('.cookies #personalizar-cookies').click(function () {
			var magnoliaInstance = window.location.origin;
			var magnoliaUrl = window.location.href;

			if (magnoliaUrl.indexOf("magnoliaPublic") > -1) {
				magnoliaInstance = magnoliaInstance + '/magnoliaPublic';
			} else if (magnoliaUrl.indexOf("magnoliaAuthor") > -1) {
				magnoliaInstance = magnoliaInstance + '/magnoliaAuthor';
			}

			setCookie('usuario_mci', 'sesion_iniciada', 365);
			window.location.href = magnoliaInstance + urlCookies;
		});
		$('.cookies button#aceptar-cookies').click(function (ev) {
			ev.preventDefault();
			$('.cookies').css('display','none');
			$('#modalDescartar').modal('show');
			let analiticaGlobal = $('#cookies-analitica').prop('checked');
			setTimeout(function () {
				$('#modalDescartar').modal('hide');
				setCookie('usuario_mci', 'sesion_iniciada', 365);
				if(analiticaGlobal) {
					/** setAnalyticsCookies(); */
					marketingTagAnalitica();
					var magnoliaInstance = window.location.origin;
					var url = window.location.href;
					window.location.href = url;
				}
			}, 3000);
		});
		$('.cookies button#rechazar-cookies').click(function (ev) {
			ev.preventDefault();
			$('.cookies').css('display','none');
			$('#modalDescartar').modal('show');
			$('#cookies-analitica').prop('checked', false);
			let analiticaGlobal = $('#cookies-analitica').prop('checked');
			setTimeout(function () {
				$('#modalDescartar').modal('hide');
				setCookie('usuario_mci', 'sesion_iniciada', 365);
				if(analiticaGlobal) {
					/** setAnalyticsCookies(); */
					marketingTagAnalitica();
					var magnoliaInstance = window.location.origin;
					var url = window.location.href;
					window.location.href = url;
				}
			}, 3000);
		});
	} else {
		//muestra avisos en función de las preferencias del usuario
		//carga idioma
		//deshabilita el formulario Feedback una vez has dado una vez
	}
	cookiesForms();
}
</script></body>
</html>
