<link rel="stylesheet" type="text/css" href="../../resources/css/menu.css">

<script type="text/javascript">

	window.addEventListener("message", (event) => { 
		var dato = event.data;
		var iframe = document.getElementById('bopIframe'); // Obtén el elemento iframe por su ID

		if (iframe) {
		  iframe.style.height = dato + 'px'; // Establece el alto del iframe
		}	
	});
	
	let menus = ["busqueda", "tramitacion", "otros"]
	
    function activaMenu(idMenu)
    {
        var  idPlus = "plus" + idMenu;
        var  idMinus = "minus" + idMenu;
        var item = document.getElementById(idMenu);
        var itemPlus = document.getElementById(idPlus);
        var itemMinus = document.getElementById(idMinus);

        for (var i=0; i< menus.length; i++)
        {
            if (menus[i]==idMenu)
            {
                if (item.classList.contains("open"))
                {
                    itemPlus.style.display="inline";
                    itemMinus.style.opacity="0";
                    item.classList.remove("open");
                }
                else
                {
                    itemPlus.style.display="none";
                    itemMinus.style.opacity="1";
                    item.classList.add("open");
                }
            }
            else
            {
                document.getElementById("plus" + menus[i]).style.display="inline";
                document.getElementById("minus" + menus[i]).style.opacity="0";
                document.getElementById(menus[i]).classList.remove("open");
            }
        }
    }
	
/*	function resizeIframe(obj) 
	{
    	obj.style.height = obj.contentWindow.document.documentElement.scrollHeight + 'px';
  	}
	*/
</script>

