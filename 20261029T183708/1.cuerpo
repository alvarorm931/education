	function loadPaginacio(numDOGC, dateStringDOGC, previousNumDOGC, laterNumDOGC, linkDownloadDOGCPDF, linkDownloadSummaryPDF, title) {
		var previousURL = "/" + localeSumari + pageDOGC + "?numDOGC=" + previousNumDOGC;
		var laterURL = "/" + localeSumari + pageDOGC + "?numDOGC=" + laterNumDOGC;

		if (previousNumDOGC != null) {
			$('#esquerre-' + title).prop('title', 'DOGC núm. ' + previousNumDOGC);
			$('#esquerre-' + title).prop('href', previousURL);
			$('#esquerre-' + title).text("DOGC núm. " + previousNumDOGC);
		}else{
			$('.esquerre').hide();
		}

		if (laterNumDOGC != null) {
			$('#dreta-' + title).prop('title', 'DOGC núm. ' + laterNumDOGC);
			$('#dreta-' + title).prop('href', laterURL);
			$('#dreta-' + title).text("DOGC núm. " + laterNumDOGC);
		}else{
			$('.dreta').hide();
		}


		$('#h1Num-' + title).prepend("DOGC núm. " + numDOGC);

		$('#fecha-' + title).text(dateStringDOGC+" - ISSN 1988-298X");

	}
	/**
	* Function that iterate ajax results and write in html
	* @param [string] section - Section to which the html will be added
	* @param [string] titleSection - The title of the section
	**/
	function iterar(section, titleSection) {
		for (let i = 0; i < section.length; i++) {
			var title = section[i].title.split(' ').join('_');
			title = title.split("'").join('');
			title = title.split("(").join('_');
			title = title.split(")").join('_');

			$('#panel-group-' + titleSection).append('<div id="panel' + i + titleSection + '" class="panel panel-default">');
			$('#panel' + i + titleSection).append('<div id="panel-heading' + i + titleSection + '" class="panel-heading">');
			$('#panel-heading' + i + titleSection).append('<h3 id="panel-title' + i + titleSection + '" class="panel-title">');
			$('#panel-title' + i + titleSection).append('<a id="' + title + '" class="js-scrollLink" href="#section-' + title + '">' + section[i].title + '</a>');
			$('#panel-title' + i + titleSection).append('<a id="' + title + '-collapse" data-toggle="collapse" href="#' + title + '-header' + titleSection + '" role="button" aria-expanded="false" class="collapsed"><span class="sr-only">collapse' + title + '</span></a>');
			$('#panel-heading' + i + titleSection).append('</h3>');
			$('#panel' + i + titleSection).append('</div>');
			$('#panel' + i + titleSection).append('<div id="' + title + '-header' + titleSection + '" class="panel-collapse collapse">');
			$('#' + title + '-header' + titleSection).append('<ul id="cos_bloc' + i + titleSection + '" class="cos_bloc">');

			for (let j = 0; j < section[i].header.length; j++) {
				var titleHeader = section[i].header[j].title.split(' ').join('_');
				if ("subheader" in section[i].header[j]) {
					$('#cos_bloc' + i + titleSection).append('<li id="li_cos_bloc' + replaceAll(titleHeader) + '_' + j + '_' + i + titleSection + '"><a href="#section_'+replaceAll(title) +"_"+ replaceAll(titleHeader) + '" class="js-scrollLink">' + section[i].header[j].title + '</a>');
					$('#li_cos_bloc' + replaceAll(titleHeader) + '_' + j + '_' + i + titleSection).append('<ul id="ul_' + replaceAll(titleHeader) + '_' + j + '_' + i + titleSection + '">');
					for (let k = 0; k < section[i].header[j].subheader.length; k++) {
						$('#ul_' + replaceAll(titleHeader) + '_' + j + '_' + i + titleSection).append('<li><a href="#section_'+replaceAll(title) +'_'+ replaceAll(section[i].header[j].title) +'_'+replaceAll(section[i].header[j].subheader[k].title) + '" class="js-scrollLink">' + section[i].header[j].subheader[k].title + '</a></li>');
					}
					$('#li_cos_bloc' + replaceAll(titleHeader) + '_' + j + '_' + i + titleSection).append('</ul>');
					$('#cos_bloc' + i + titleSection).append('</li>');
				} else {
					$('#cos_bloc' + i + titleSection).append('<li><a href="#section_'+replaceAll(title) +"_"+ replaceAll(titleHeader) + '" class="js-scrollLink">' + section[i].header[j].title + '</a></li>');
				}
			}

			$('#' + replaceAll(title) + '-header' + titleSection).append('</ul">');
			$('#panel' + i + titleSection).append('</div>');
			$('#panel-group' + i + titleSection).append('</div>');
		}
	}

	/**
	 * Función que muestra la lista de resultados de cada sección
	 */
	function listaResultados(section, titleSection) {
		var str = "";

		for (let i = 0; i < section.length; i++) {
			var sectionId = section[i].title;
			sectionId = sectionId.replace(/\ /g, '_');
			sectionId = sectionId.replace(/'/g, "");
			str += "<div id=\"llistat_destacat_text column\" class=\"llistat_destacat_text column\">" +
				'<div class="wrapper-disposicions"><span id="section-' + sectionId + '"></span><h2 id=\"' + section[i].title + '-title' + titleSection + '">' + section[i].title + '</h2>';
			for (let j = 0; j < section[i].header.length; j++) {
				//str+="</a>"
				str += '<span id="section"></span>';
				str += "<h3 id=\"section_"+replaceAll(sectionId) +"_"+ replaceAll(section[i].header[j].title) + "\">" + section[i].header[j].title + "</h3>";
				str += "<ul class=\"llistat_destacat_text_cont list-group\">";
				if(section[i].header[j].document != undefined){
					for(let z = 0; z < section[i].header[j].document.length; z++ ){
						var documentId = getDocumentId(section, i, j, undefined, z);
						var documentURL = "/" + localeSumari + pageDocument + "?" + documentId;
						//str += '<li class="destacat_text list-group-item filet_inf">'+ section[i].header[j].document[z].title+'</li>';
						str += "<li class=\"destacat_text list-group-item filet_inf\">"
						str += "<div class=\"destacat_text_cont\"><a  target='_blank' href=\"" + documentURL + "\">" + section[i].header[j].document[z].title + "</a>" +
								'<div class="download"><a href="' + section[i].header[j].document[z].linkDownloadDocumentPDF + '" target="_blank">' +
								"<img alt=\"pdf icon\" src=\"/system/modules/cat.gencat.wcmResponsive.formatters.httpFetch/resources/common/img/NG_ico_pdf.png\" class=\"icon-corrector\">" + downloadTextDes +
								"</a></div></div>";
						str += "</li>";
					}
				}
				str+= "</ul>";
				str += "<ul class=\"llistat_destacat_text_cont list-group\">";
				if ("subheader" in section[i].header[j]) {
					for (let l = 0; l < section[i].header[j].subheader.length; l++) {
						str += "<h4 id=\"section_"+replaceAll(sectionId) +"_"+ replaceAll(section[i].header[j].title) +"_"+ replaceAll(section[i].header[j].subheader[l].title) + "\">" + section[i].header[j].subheader[l].title + "</h4>";
						str += "<ul class=\"llistat_destacat_text_cont list-group\">";
						for (let k = 0; k < +section[i].header[j].subheader[l].document.length; k++) {
							var documentId = getDocumentId(section, i, j, l, k);
							var documentURL = "/" + localeSumari + pageDocument + "?" + documentId;
							str += "<li class=\"destacat_text list-group-item filet_inf\">"
							str += "<div class=\"destacat_text_cont\"><a  target='_blank' href=\"" + documentURL + "\">" + section[i].header[j].subheader[l].document[k].title + "</a>" +
								'<div class="download"><a href="' + section[i].header[j].subheader[l].document[k].linkDownloadDocumentPDF + '" target="_blank">' +
								"<img alt=\"pdf icon\" src=\"/system/modules/cat.gencat.wcmResponsive.formatters.httpFetch/resources/common/img/NG_ico_pdf.png\" class=\"icon-corrector\">" + downloadTextDes +
								"</a></div></div>";
							str += "</li>";
						}
						str += "</ul>";

					}
				} else {
					/*for (let k = 0; k < section[i].header[j].document.length; k++) {
						var documentId = getDocumentId(section, i, j, undefined, k);
						var documentURL = "/" + localeSumari + pageDocument + "?" + documentId;
						str += "<li class=\"destacat_text list-group-item filet_inf\">";
						str += "<div class=\"destacat_text_cont\"><a href=\"" + documentURL + "\">" + section[i].header[j].document[k].title + "</a>" +
							"<div class=\"download\"><a href=\"" + section[i].header[j].document[k].linkDownloadDocumentPDF + "\" target=\"_blank\">" +
							"<img alt=\"pdf icon\" src=\"/system/modules/cat.gencat.wcmResponsive.formatters.httpFetch/resources/common/img/NG_ico_pdf.png\" class=\"icon-corrector\">" + downloadTextDes +
							"<span class=\"sr-only\">" + section[i].header[j].document[k].title + "</span></a></div></div>";
						str += "</li>";
					}*/
				}

				str += "</ul>";

			}

		}
		str += "</div>";
		$('#inici-' + titleSection).append(str);
	}

	function error(jqXHR, textStatus, errorThrown) {
		var message;
		if (textStatus === 'timeout') {
			message = "Consulta no disponible en aquests moments. Si us plau, reformuleu-la o repetiu-la més tard";
		} else if (jqXHR.status == 404) {
			message = "El recurs demanat no es troba disponible en el servidor.";
		} else if (jqXHR.status == 500) {
			message = message = "En aquests moments el servidor no es troba disponible.";
		} else if (textStatus === 'parsererror') {
			message = "El contingut de la resposta no s’ha pogut processar correctament.";
		} else if (jqXHR.status === 0) {
			message = "En aquests moments no és possible establir connexió amb el servidor.";
		} else if (textStatus === 'abort') {
			message = "El servidor no ha processat la petició de sol·licitud d’informació.";
		} else {
			message = "S’ha donat un error en el servidor amb la següent descripció: " + jqXHR.responseText;
		}
		$(".errorSumari").text(message);
	}

	/**
	 * Function for getting documentId
	 */
	function getDocumentId(section, i, j, l, k) {
		var linkDownloadDocumentPDF = (l != undefined) ? section[i].header[j].subheader[l].document[k].linkDownloadDocumentPDF : section[i].header[j].document[k].linkDownloadDocumentPDF;
		var startIndex = linkDownloadDocumentPDF.indexOf("documentId");
		linkDownloadDocumentPDF = linkDownloadDocumentPDF.substring(startIndex);
		var finalIndex = linkDownloadDocumentPDF.indexOf("&");
		var documentId = (finalIndex != -1) ? linkDownloadDocumentPDF.substring(0, finalIndex) : linkDownloadDocumentPDF.substring(0);

		return documentId;
	}

	/**
	 * Function for replacing space to underscore and commas to nothing
	 * str: String with text
	 */
	function replaceAll(str) {
		str = str.replace(/'/g, "");
		str = str.replace(/,/g, "");
		return str.replace(/ /g, "_");
	}

	/**
	 * Getting specific parameter from URL
	 * @returns id
	 */
	function getParameterURL(param) {
		//var urlParams = new URLSearchParams(window.location.search);
		//var id = urlParams.get(param);

		var url = new URL(window.location.href);
		var id = url.searchParams.get(param);
		return id;
	}

	function getUrlParameter(location, name) {
		name = name.replace(/[\[]/, '\\[').replace(/[\]]/, '\\]');
		var regex = new RegExp('[\\?&]' + name + '=([^&#]*)');
		var results = regex.exec(location);
		console.log(results === null ? '' : decodeURIComponent(results[1].replace(/\+/g, ' ')))
		return results === null ? '' : decodeURIComponent(results[1].replace(/\+/g, ' '));
	};


	/**
	 * compartir amb facebook l'url
