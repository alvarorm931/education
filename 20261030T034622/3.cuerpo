        <div class="buscador_anuncios">
            <div id="spinnerBuscadorPublicoAnuncios" class="spinner"></div>
            <form class="formulario anuncios" action="/publica/buscador-anuncios/resultados-anuncios/" method="post" id="buscador_anuncios" autocomplete="off">

                <div class="fila termino ">
                    <div class="titulo-fila">
                        Términos y rango de fechas</div>
                    <div class="elemento termino">
                        <label for="busqueda">Término de búsqueda</label>
                        <input title="Introduzca el título, número o entidad de un anuncio" type="text" id="busqueda" name="busqueda" class="termino"
                               placeholder="Introduzca el título, número o entidad de un anuncio " onfocus="this.placeholder = ''"
                               onblur="this.placeholder = 'Introduzca el título, número o entidad de un anuncio'"/>
                    </div>
                    <div class="elemento fechas">
                        <label for="fechaDesde">Fecha desde</label>
                        <input title="Introduzca fecha de inicio de búsqueda" name="fechaDesde" id="fechaDesde" type="date" class="fechaDesde desdehasta"/>
                    </div>
                    <div class="elemento fechas">
                        <label for="fechaHasta">Fecha hasta</label>
                        <input title="Introduzca fecha de fin de búsqueda" name="fechaHasta" id="fechaHasta" type="date" class="fechaHasta desdehasta"/>
                    </div>
                </div>

                <div class="fila anunciantes ">
                    <div class="titulo-fila">
                        Anunciantes</div>

                    <div class="elemento termino administracionCat">
                        <label for="administracionCat">Anunciante</label>
                        <select title="Seleccione un anunciante" id="administracionCat" name="administracionCat">
                            <option value="" selected disabled>Seleccione un anunciante</option>
                            <option value="entidades/Administracion-Local/">Administración Local</option>
                            <option value="entidades/Administracion-Autonomica/">Administración Autonómica</option>
                            <option value="entidades/Administracion-del-Estado/">Administración del Estado</option>
                            <option value="entidades/Administracion-de-Justicia/">Administración de Justicia</option>
                            <option value="entidades/Otras-Entidades/">Anuncios Particulares</option>
                            <option value="entidades/Administracion-Electoral/">Administración Electoral</option>
                            </select>
                    </div>
                    <div class="elemento fechas seccion" style="display: none;">
                        <label for="seccionCat">Sección</label>
                        <select title="Sección" id="seccionCat" name="seccionCat">
                            <option value="" selected disabled>Sección</option>
                        </select>
                    </div>
                    <div class="elemento fechas subseccion" style="display: none;">
                        <label for="subseccionCat">Subsección</label>
                        <select title="Subsección" id="subseccionCat" name="subseccionCat">
                            <option value="" selected disabled>Subsección</option>
                        </select>
                    </div>
                    <div class="elemento fechas grupo" id="seccion_grupo" style="display: none;">
                        <label for="grupoCat">Grupo</label>
                        <select title="Grupo" id="grupoCat" name="grupoCat">
                            <option value="" selected disabled>Grupo</option>
                        </select>
                    </div>
                </div>

                <div class="fila">
                    <div class="acciones">
                        <input title="Buscar" id="lanzar_formulario" type="submit"
                               value="Buscar" id="lanzar_formulario"/>
                    </div>
                </div>

                <input type="hidden" name="fdesde" id="fdesde"/>
                <input type="hidden" name="fhasta" id="fhasta"/>
                <input type="hidden" name="BusquedaInicial" id="BusquedaInicial"/>
            </form>
        </div>
    </div>

    <script>
        const tipoAnuncioActivo = false;
        const metadatoAnuncioActivo = false;

        function borrarSeccion() {
            $('#seccionCat').empty();
            $('#seccionCat').html("<option value='' selected disabled>Seleccione una sección</option>");
        }

        function borrarSubSeccion() {
            $('#subseccionCat').empty();
            $('#subseccionCat').html("<option value='' selected disabled>Seleccione una subsección</option>");
        }

        function cabmioEnAdministracion(elto) {
            var datas = {
                optionSelected: $(elto).val(),
                paraBuscadorAnuncios: true
            };
            var urlSelect = "/system/modules/com.saga.inpro.theme.bop/elements/entidad-acciones/select-categorias-entidad-ajax.jsp";

            borrarSubSeccion();
            mostrarSpiner();
            $.ajax({
                type: 'POST',
                url: urlSelect,
                data: datas,
                dataType: 'HTML',

                success: function (res) {
                    // console.log('Éxito AJAX!', urlSelect);
                    /*console.log('La respuesta es: ', res);*/

                    // Generamos el HTML
                    $('#seccion_grupo').hide();
                    $('.seccion').show();
                    $('#seccionCat').empty();
                    $('#seccionCat').html("<option value='' selected disabled>Seleccione una sección</option>" + res);
                    $('#seccionCat').select2();
                },
                error: function (jqXHR, exception) {
                    var msg = '';
                    if (jqXHR.status === 0) {
                        msg = 'Sin conexión.\n verificar red.';
                    } else if (jqXHR.status === 404) {
                        msg = 'Página no encontrada. [404]';
                    } else if (jqXHR.status === 500) {
                        msg = 'Error Interno de Servidor [500].';
                    } else if (exception === 'parsererror') {
                        msg = 'Error en parseo de JSON.';
                    } else if (exception === 'timeout') {
                        msg = 'Time out.';
                    } else if (exception === 'abort') {
                        msg = 'Petición Ajax abortada.';
                    } else {
                        msg = 'Error no categorizado.\n' + jqXHR.responseText;
                    }
                    console.error(msg);
                },
                complete: function () {
                    ocultarSpiner();
                }
            });
            $('#administracion').val($('#administracionCat option:selected').val());
        }

        function cambioEnSeccion(elto) {
            var datas = {
                optionSelected: $(elto).val(),
                paraBuscadorAnuncios: true
            };
            var urlSelect = "/system/modules/com.saga.inpro.theme.bop/elements/entidad-acciones/select-categorias-entidad-ajax.jsp";

            mostrarSpiner();
            $.ajax({
                type: 'POST',
                url: urlSelect,
                data: datas,
                dataType: 'HTML',

                success: function (res) {
                    // console.log('Éxito AJAX!', urlSelect);
                    // console.log('La respuesta es: ', res);

                    // Generamos el HTML
                    $('#seccion_grupo').hide();
                    $('.subseccion').show();
                    $('#subseccionCat').empty();
                    $('#subseccionCat').html("<option value='' selected disabled>Seleccione una subsección</option>" + res);
                    $('#subseccionCat').select2();
                },
                error: function (jqXHR, exception) {
                    var msg = '';
                    if (jqXHR.status === 0) {
                        msg = 'Sin conexión.\n verificar red.';
                    } else if (jqXHR.status === 404) {
                        msg = 'Página no encontrada. [404]';
                    } else if (jqXHR.status === 500) {
                        msg = 'Error Interno de Servidor [500].';
                    } else if (exception === 'parsererror') {
                        msg = 'Error en parseo de JSON.';
                    } else if (exception === 'timeout') {
                        msg = 'Time out.';
                    } else if (exception === 'abort') {
                        msg = 'Petición Ajax abortada.';
                    } else {
                        msg = 'Error no categorizado.\n' + jqXHR.responseText;
                    }
                    console.error(msg);
                },
                complete: function () {
                    ocultarSpiner();
                }
            });
            $('#seccion').val($('#seccionCat option:selected').val());
        }

        function cambioEnSubSeccion(elto) {
            var datas = {
                optionSelected: $(elto).val(),
                paraBuscadorAnuncios: true
            };
            var urlSelect = "/system/modules/com.saga.inpro.theme.bop/elements/entidad-acciones/select-categorias-entidad-ajax.jsp";

            mostrarSpiner();
            $.ajax({
                type: 'POST',
                url: urlSelect,
                data: datas,
                dataType: 'HTML',

                success: function (res) {
                    // console.log('Éxito AJAX!', urlSelect);
                    // console.log('La respuesta es: ', res);

                    // Generamos el HTML
                    if (res != "") {
                        $('#seccion_grupo').show();
                    } else {
                        $('#seccion_grupo').hide();
                    }
                    $('#grupoCat').empty();
                    $('#grupoCat').append("<option value='' selected disabled>Seleccione un grupo</option>" + res);
                    $('#grupoCat').select2();
                },
                error: function (jqXHR, exception) {
                    var msg = '';
                    if (jqXHR.status === 0) {
                        msg = 'Sin conexión.\n verificar red.';
                    } else if (jqXHR.status === 404) {
                        msg = 'Página no encontrada. [404]';
                    } else if (jqXHR.status === 500) {
                        msg = 'Error Interno de Servidor [500].';
                    } else if (exception === 'parsererror') {
                        msg = 'Error en parseo de JSON.';
                    } else if (exception === 'timeout') {
                        msg = 'Time out.';
                    } else if (exception === 'abort') {
                        msg = 'Petición Ajax abortada.';
                    } else {
                        msg = 'Error no categorizado.\n' + jqXHR.responseText;
                    }
                    console.error(msg);
                },
                complete: function () {
                    ocultarSpiner();
                }
            });
            $('#subseccion').val($('#subseccionCat option:selected').val());
        }

        $(document).ready(function () {
            $('#administracionCat').on("change", function () {
                cabmioEnAdministracion(this);
            });

            $('#seccionCat').on("change", function () {
                cambioEnSeccion(this)
            });

            $('#subseccionCat').on("change", function () {
                cambioEnSubSeccion(this);
            });

            ocultarSpiner();
            window.addEventListener('pageshow', navegacionAtras);

        });

        function navegacionAtras(event) {
            if (event.persisted) {
                console.log('Navegación en el historial detectada:', event);
                ocultarSpiner()
            }
        }

        function ocultarSpiner() {
            console.log("Ocultamos spiner")
            $('#spinnerBuscadorPublicoAnuncios').addClass('d-none');
        }

        function mostrarSpiner() {
            console.log("Mostramos spiner")
            $('#spinnerBuscadorPublicoAnuncios').removeClass('d-none');
        }

        /**
         * value = fecha indicada en el input
         * element = el input
         * fechaDesdeMinima = rules.fechaDesde.fechaMayorQueFechaConcreta
         * devuelve false si hay un error
         */
        $.validator.addMethod("fechaMayorQueFechaConcreta", function (value, element, fechaDesdeMinima) {
            console.log('fechaMayorQueFechaConcreta', value, element, fechaDesdeMinima)
            console.log('INTERVALO_FECHAS_ACTIVO', INTERVALO_FECHAS_ACTIVO)
            if (INTERVALO_FECHAS_ACTIVO) {
                if (value !== '') {
                    const desde = obtenerTimestampEnMilisegundos(value);
                    return desde >= fechaDesdeMinima;
                } else {
                    return true;
                }
            } else {
                console.log('El intervalo de fechas no está activado. No validamos. Devolvemos "true"')
                return true;
            }
        }, $.validator.format("La fecha desde debe mayor a la fecha"));

        /**
         * value = fecha indicada en el input
         * element = el input
         * compararCon = rules.fechaHasta.fechaMayorQue o messages.fechaHasta.fechaMayorQue
         * devuelve false si hay un error
         */
        $.validator.addMethod("fechaMayorQue", function (value, element, compararCon) {
            var fechaComparar = new Date($('#' + compararCon + '').val());
            var fechaSeleccionada = new Date(value);

            if (fechaComparar <= fechaSeleccionada || value == '') {
                return true;
            } else {
                return false;
            }
        }, $.validator.format("La fecha debe ser superior a la fecha de inicio"));

        /**
         * value = fecha indicada en el input
         * element = el input
         * min = valor indicado en rules.fechaHasta.intervaloMeses
         * devuelve false si hay un error
         */
        $.validator.addMethod("intervaloMeses", function (value, element, min) {
            if (INTERVALO_FECHAS_ACTIVO) {
                if (min > -1) {
                    var valorFechaDesde = $('.fechaDesde').val();
                    var valorFechaHasta = $('.fechaHasta').val();
                    if (!valorFechaDesde || !valorFechaHasta) {
                        // No se realizan comprobaciones
                        return true;
                    } else {
                        const fechaDesde = new Date(valorFechaDesde);
                        const fechaHasta = new Date(valorFechaHasta);

                        // Si la fecha "hasta" es anterior a la fecha "desde", devolver true para que salte la validación de fechas anteriores
                        if (fechaHasta < fechaDesde) {
                            return true;
                        }

                        // Calcular la fecha límite sumando el número de meses a la fecha inicial
                        const fechaLimite = new Date(fechaDesde);
                        fechaLimite.setMonth(fechaLimite.getMonth() + min);

                        // Verificar si la fecha final es menor o igual a la fecha límite, pero no mayor
                        return fechaHasta < fechaLimite;
                    }
                } else {
                    return true;
                }
            } else {
                console.log('El intervalo de fechas no está activado. No validamos. Devolvemos "true"')
                return true;
            }
        }, $.validator.format("El intervalo de fechas no debe ser superior a {0} meses."));

        /**
         * Validación del formulario de búsqueda.
         * 1. Añadimos la obligatoriedad a los inputs de fecha ocultos y se lo quitamos a los visibles. Si se lo añadimos a estos últimos, como antes del submit se vacían para no enviárselos al VUE (los metería como filtros (fq) y fallaría la consulta a Solr porque esos campos no existen), los validaría y como se han vaciado, saltaría la validación de obligatoriedad.
         * 2. Al validar la obligatoriedad de los inputs ocultos, movemos el mensaje de validación al input visible.
         * 3. Añadimos los estilos en la propia validación, ya que jquery validator no nos permite añadirle la clase error al input visible porque interpreta que su validación es correcta.
         */
        $('form#buscador_anuncios').validate({
            ignore: "",
            rules: {
                
                fechaDesde: {
                    intervaloMeses: 5,
                    fechaMayorQueFechaConcreta: 1739746800000
                },
                fechaHasta: {
                    intervaloMeses: 5,
                    fechaMayorQue: 'fechaDesde'
                }
            },
            messages: {
                fechaDesde: {
                    fechaMayorQueFechaConcreta: "La fecha desde no puede ser anterior a 17/02/2025",
                    intervaloMeses: "El intervalo de fechas no debe ser superior a 5&nbsp;meses."
                },
                fechaHasta: {
                    fechaMayorQue: "La fecha 'hasta' no puede ser mayor a la fecha 'desde'",
                    intervaloMeses: "El intervalo de fechas no debe ser superior a 5&nbsp;meses."
                },
                fdesde: {
                    required: "Por favor indique una fecha desde"
                },
                fhasta: {
                    required: "Por favor indique una fecha hasta"
                }
            },
            errorPlacement: function (error, element) {
                if (element.attr("name") === "fdesde") {
                    // Coloca el mensaje de error debajo del campo fechaDesde
                    error.insertAfter("#fechaDesde"); // Ajusta el selector según tu estructura HTML
                } else if (element.attr("name") === "fhasta") {
                    // Usa la ubicación predeterminada para otros campos
                    error.insertAfter("#fechaHasta"); // Ajusta el selector según tu estructura HTML
                } else {
                    // Usa la ubicación predeterminada para otros campos
                    error.insertAfter(element);
                }

                // Aplica estilos directamente al objeto error
                error.css({
                    'background': '#c33',
                    'color': '#FFF',
                    'padding': '4px 8px',
                    'vertical-align': 'middle',
                    'font-size': '12px',
                    'width': '100%',
                });
            }
        });

        /**
         * Evento para detectar cambios en el input de la fecha desde. Se valida el final de este para que borre o muestre la validación pertinente
         */
        $('#fechaDesde').on('change', function () {
            var valorFechaDesde = $('.fechaDesde').val();

            if (valorFechaDesde != null && valorFechaDesde !== '') {
                var fechaDesdeMili = new Date(valorFechaDesde).getTime();
                $('#fdesde').val(fechaDesdeMili);
            }
            $('#buscador_anuncios').valid();
        });

        /**
         * Evento para detectar cambios en el input de la fecha hasta. Se valida el final de este para que borre o muestre la validación pertinente
         */
        $('#fechaHasta').on('change', function () {
            var valorFechaHasta = $('.fechaHasta').val();

            if (valorFechaHasta != null && valorFechaHasta !== '') {
                var fechaHastaMili = new Date(valorFechaHasta).getTime();
                $('#fhasta').val(fechaHastaMili);
            }
            $('#buscador_anuncios').valid();
        });

        $(document).on('click', '#lanzar_formulario', function (e) {
            e.preventDefault();

            if ($('#buscador_anuncios').validate().checkForm()) {
                var grupoCat = $('#grupoCat').val();
                var subseccionCat = $('#subseccionCat').val();
                var seccionCat = $('#seccionCat').val();
                var administracionCat = $('#administracionCat').val();
                var busquedaInicial = ''; // valor de la variable que enviamos al SagaListado para que marque los filtros indicados en el formulario
                var categoria = '';

                if (grupoCat && grupoCat !== '') {
                    categoria = grupoCat;
                } else {
                    if (subseccionCat && subseccionCat !== '') {
                        categoria = subseccionCat;
                    } else {
                        if (seccionCat && seccionCat !== '') {
                            categoria = seccionCat;
                        } else {
                            if (administracionCat && administracionCat !== '') {
                                categoria = administracionCat;
                            }
                        }
                    }
                }

                if (categoria !== undefined && categoria !== '') {
                    busquedaInicial = 'category_exact:' + categoria;
                }

                if (tipoAnuncioActivo) {
                    var tipoAnuncionVal = $('#tipoAnuncio option:selected').val();
                    if (tipoAnuncionVal !== undefined && tipoAnuncionVal !== '') {
                        busquedaInicial += (busquedaInicial !== '' ? '|' : '') + 'xmlTituloTipoAnuncio_es_s:' + $('#tipoAnuncio option:selected').text()
                    }
                    $('#tipoAnuncio').val('');
                }

                if (metadatoAnuncioActivo) {
                    var metadatoAnuncionVal = $('#metadatoAnuncio option:selected').val();
                    if (metadatoAnuncionVal !== undefined && metadatoAnuncionVal !== '') {
                        busquedaInicial += (busquedaInicial !== '' ? '|' : '') + 'xmlTituloMetadatoAnuncio_es_s:' + $('#metadatoAnuncio option:selected').text()
                    }
                    $('#metadatoAnuncio').val('');
                }
                // El parámetro 'BusquedaInicial' lo utiliza SagaListado para filtrar la busqueda inicial
                if (busquedaInicial !== '') {
                    $('#BusquedaInicial').val(busquedaInicial);
                }

                $('#administracionCat').val('');
                $('#seccionCat').val('');
                $('#subseccionCat').val('');
                $('#grupoCat').val('');
                $('#fechaDesde').val('');
                $('#fechaHasta').val('');

                // Hack: añadimos al action las fechas desde y hasta para obtenerlas con JavaScript en el SagaListado-bop.js
                var _fdesde = $('#fdesde');
                var _fhasta = $('#fhasta');
                var fDesde = formatearFecha(new Date(parseInt(_fdesde.val())));
                var fHasta = formatearFecha(new Date(parseInt(_fhasta.val())));
                var fechas = '';
                if (_fdesde.val() && _fhasta.val()) {
                    fechas = '?fdesde=' + fDesde + '&fhasta=' + fHasta
                } else {
                    if (_fdesde.val()) {
                        fechas = '?fdesde=' + fDesde
                    } else {
                        if (_fhasta.val()) {
                            fechas = '?fhasta=' + fHasta
                        }
                    }
                }
                console.log('Filtro fechas: ', fechas);

                $('#buscador_anuncios').attr('action',
                    $('#buscador_anuncios').attr('action') + fechas
                )

                // Mostramos spinner
                mostrarSpiner();
                $('#buscador_anuncios').submit();
            } else {
                $('#buscador_anuncios').validate().showErrors();
            }
        });

        ocultarSpiner();

    </script>

		
		
	

