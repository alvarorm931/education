			<chat-widget></chat-widget>
					<script>
						document.addEventListener('DOMContentLoaded', testMainWidget);
						let widget;
						  function testMainWidget() {
							widget = document.querySelector('chat-widget');

							requestUrlChange();
							chatStateChanged();
						  }

						  function chatStateChanged() {
							widget.addEventListener('chatStateChanged', event => {
							  const state = event.detail;
							  if (!state) return;
							  switch (state) {
								case 'open':
								  console.log('chat open');
								  break;
								case 'close':
								default:
								  console.log('chat close');
								  break;
							  }
							});
						  }

						  function requestUrlChange() {
							widget.addEventListener('requestUrlChange', function (event) {
							  const newUrl = event.detail;
							});
						  }

						  function _toggle() {
							if (widget.hasAttribute('toggle')) {
							  widget.removeAttribute('toggle');
							} else {
							  widget.setAttribute('toggle', true);
							}
						  }
					</script>

