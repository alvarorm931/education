    $("#goToPrevMonth").click(function() {
      $("#mes_calendario").val(12);
      $("#anyo_calendario").val(2021);
      $("#cambia_calendario").submit();
    });

    $("#goToNextYear").click(function() {
    $("#mes_calendario").val(1);
      $("#anyo_calendario").val(2023);
      $("#cambia_calendario").submit();
    });

    $("#goToNextMonth").click(function() {
      $("#mes_calendario").val(02);
      $("#anyo_calendario").val(2022);
      $("#cambia_calendario").submit();
    });
    });
    
