(function() {
var $ = AUI.$;var _ = AUI._;
//var selected = [];
var letterToFind = 'a';
var textToFind = '';

var resultadosDiv = $("#_IYBIWBCC_resultados");
var loadResultadosDiv = $("#_IYBIWBCC_loader-container");
var inputIssuesSelect = $("#_IYBIWBCC_issuersSelect");
var backUpItemsSelected = getIssuesTagSelected();

jQuery(".loader-container").hide();
    $(document).ready(function() {
        var initItemsSelectedOnInit = getIssuesValuesFromInput(inputIssuesSelect); //obtenemos los emisores al inicio
        addElementTagOnInit(initItemsSelectedOnInit); //anadimos esos emisores
        searchEmisores(letterToFind, textToFind);
        /**
            EVENTS
        **/
        $('button.letter').click(function() {
            var idItemSelected = $(this).attr('id');
            var letter = $(this).attr('data-letters');
            var lettersColletion = $(".letter");
            lettersColletion.each(function() {
               var id = $(this).attr('id');
               if(id === idItemSelected){
                    $(this).addClass( "active" );
               }else{
                    $(this).removeClass( "active" );
               }
            });
            letterToFind = letter;
            searchEmisores(letterToFind, '');
        });

        $("#_IYBIWBCC_addIssuesBtn").click(function() {
            var itemsSelected = getIssuesTagSelected();
            var issuesInputValue = getIssuesValuesFromArray(itemsSelected);
            inputIssuesSelect.val(issuesInputValue);
        });

        $("#bipoindices .close").click(function() {
        	textToFind = '';
            var itemsSelected = backUpItemsSelected;
            var issuesInputValue = getIssuesValuesFromArray(itemsSelected);
            inputIssuesSelect.val(issuesInputValue);
            $( "li.tag" ).each(function(index) {
               var liData = $( this ).attr("data-letters");
               if(itemsSelected.indexOf(liData) === -1) {
                     $(this).remove();
               }
            });
            setIssuesTagSelected(itemsSelected);
            searchEmisores(letterToFind, textToFind);
        });
 
        $("#bipoindices").on('shown.bs.modal', function(e){
        	$("#_IYBIWBCC_textToFind").val('');
        	$("#_IYBIWBCC_letter-a").addClass( "active" );
            backUpItemsSelected = JSON.parse(JSON.stringify(getIssuesTagSelected()));
            //searchEmisores(letterToFind, textToFind);
             document.getElementById("cerrarEmisores").focus(); 
        });
        
        $('body').on('keydown', function (e) {
		    // Encuentra el contenedor del modal
		    const container = $('div[role="document"]');
		    
		    // Encuentra el primer y el último elemento enfocable
		    const firstElement = container.find('#cerrarEmisores');  // Primer elemento enfocable
		    const lastElement = container.find('input[checked="checked"].checkbox');  // Último elemento enfocable
		
		    if (e.key === 'Tab') {
		        // Si el foco está en el primer elemento y presionas Shift + Tab
		        if (e.shiftKey && $(document.activeElement).is(firstElement)) {
		            e.preventDefault();  // Prevenir el comportamiento predeterminado
		            lastElement.focus();  // Mover el foco al último elemento
		        }
		        // Si el foco está en el último elemento y presionas Tab (sin Shift)
		        else if (!e.shiftKey && $(document.activeElement).is(lastElement)) {
		            e.preventDefault();  // Prevenir el comportamiento predeterminado
		            firstElement.focus();  // Mover el foco al primer elemento
		        }
		    }
		}); 

        $('#_IYBIWBCC_BuscarEmisores').click(function() {
            textToFind = $("#_IYBIWBCC_textToFind").val();
            var lettersColletion = $(".letter.active");
            lettersColletion.each(function() {
                $(this).removeClass( "active" );
            });
            searchEmisores('', textToFind);
        });
    });

    function searchEmisores(letterToFind, textToFind){
         var dataForm =  {};
        try{
            var itemsSelectedArray = getIssuesTagSelected();
            //JSON.stringify(itemsSelectedArray);
            var itemsSelected = itemsSelectedArray.join(';&&;');
            dataForm =  {
                '_IYBIWBCC_letter': letterToFind,
                '_IYBIWBCC_textToFind': textToFind,
                '_IYBIWBCC_itemsSelected': itemsSelected,
            };
            searchEmisoresAjaxCall('_IYBIWBCC_', 'https://www.bizkaia.eus/es/bob?p_p_id=IYBIWBCC&p_p_lifecycle=2&p_p_state=normal&p_p_mode=view&p_p_resource_id=%2Fiybiwbcc%2FresourceEmisores&p_p_cacheability=cacheLevelPage', dataForm, resultadosDiv, loadResultadosDiv);
        }catch(exception){

        }
    }

     function addElementTagOnInit(itemsSelectedArray){
        jQuery.each(itemsSelectedArray, function(i, itemName) {
              addElement('_IYBIWBCC_', '0', itemName, '<li id="_IYBIWBCC_Tag_TAG_ITEM_CODE" class="tag" data-item="TAG_ITEM_NAME"><div class="tag_delete_div"><span class="tag_delete" data-item="TAG_ITEM_NAME" data-role="remove" tabindex="0" aria-label="Eliminar TAG_ITEM_NAME" role="button"><span data-item="TAG_ITEM_NAME"></span></span></div><span aria-hidden="true">TAG_ITEM_NAME</span></li>');
        });
     }



})();
(function() {
var $ = AUI.$;var _ = AUI._;

    var dateInvalidRangeErrorDiv = $("#_IYBIWBCC_dateInvalidRangeError");
    dateInvalidRangeErrorDiv.hide();
    var dateDispInvalidRangeErrorDiv = $("#_IYBIWBCC_dateDispInvalidRangeError");
    dateDispInvalidRangeErrorDiv.hide();
    var isAdvanceSearch = 'false';
	var fmFiltros = $("#_IYBIWBCC_fmFiltros");
	var divFiltroOpciones = $("#_IYBIWBCC_filtroOpciones");
	var btnCerrarFiltro = $("#_IYBIWBCC_cerrarFiltro");
	var btnMostrarFiltros = $("#_IYBIWBCC_mostrarFiltros");
	var divBotonesSelector = $("#_IYBIWBCC_botonesSelector");
    var btnIndiceSelect = $("#_IYBIWBCC_indiceselect");
    var inputIssuesSelect = $("#_IYBIWBCC_issuersSelect");
    var btnBuscar = $("#_IYBIWBCC_buscar");
    var btnBuscarFiltro = $("#_IYBIWBCC_buscarFiltro");
    var errorMessageDiv = $("#_IYBIWBCC_errorMessage .row .col-xs-12");
    
    var fromDatePicker = Liferay.component('_IYBIWBCC_fromDateDatePicker');
	var toDatePicker = Liferay.component('_IYBIWBCC_toDateDatePicker');
	var fromDispDatePicker = Liferay.component('_IYBIWBCC_fromDateDispDatePicker');
	var toDispDatePicker = Liferay.component('_IYBIWBCC_toDateDispDatePicker');



     $( document ).ready(function() {
        $('.bipo_modal#bipoindices').hide();
        $('#dateInvalidRangeError').hide();
        $('#dateDispInvalidRangeError').hide();

        fmFiltros.on("focusout","#_IYBIWBCC_fromDate", function() {
            //console.log("formFieldFromDateName focusout");
            //var isValid = validateDate();
            //console.log("isValid " + isValid);
        });

        fmFiltros.on("focusout","#_IYBIWBCC_toDate", function() {
            //console.log("formFieldToDateName focusout");
            //var isValid = validateDate();
            //console.log("isValid " + isValid);
        });

        fmFiltros.on("focusout","#_IYBIWBCC_fromDateDisp", function() {
            //console.log("formFieldFromDispDateName focusout");
            //var isValid = validateDateDisp();
            //console.log("isValid " + isValid);
         });

         fmFiltros.on("focusout","#_IYBIWBCC_toDateDisp", function() {
            //console.log("formFieldToDispDateName focusout");
            //var isValid = validateDateDisp();
            //console.log("isValid " + isValid);
         });

         $("#_IYBIWBCC_buscarFiltro").click(function(e) {
           realizarBusquedaForm(true);
         });

         $("#_IYBIWBCC_buscar").click(function() {
             realizarBusquedaForm(false);
         });

    });


	A.one('#_IYBIWBCC_FromDateButton').on('click', clickFromDateButton);
	A.one('#_IYBIWBCC_ToDateButton').on('click', clickToDateButton);
	A.one('#_IYBIWBCC_FromDateDispButton').on('click', clickFromDateDispButton);
	A.one('#_IYBIWBCC_ToDateDispButton').on('click', clickToDateDispButton);
	

	function clickFromDateButton() {
	    A.one('#_IYBIWBCC_fromDate').focus();
		fromDatePicker.show();
	}
	
	function clickToDateButton() {
	   A.one('#_IYBIWBCC_toDate').focus();
		toDatePicker.show();
	}
	
	function clickFromDateDispButton() {
	    A.one('#_IYBIWBCC_fromDateDisp').focus();
		fromDispDatePicker.show();
	}
	
	function clickToDateDispButton() {
	   A.one('#_IYBIWBCC_toDateDisp').focus();
		toDispDatePicker.show();
	}


	/*MostrarFiltrosOpciones*/
	if(isAdvanceSearch === 'true'){
       mostrarFiltrosFunc();
	}else{
	   cerrarFiltroFunc();
	}

	btnMostrarFiltros.click(mostrarFiltrosFunc);
    btnCerrarFiltro.on('click', cerrarFiltroFunc);
    //btnIndiceSelect.on('click', loadIssuesIndice);


	function mostrarFiltrosFunc() {
		divFiltroOpciones.show();
		divBotonesSelector.hide();
		btnCerrarFiltro.show();
		btnCerrarFiltro.addClass("d-inline-block");
	}

	function cerrarFiltroFunc() {
		divFiltroOpciones.hide();
		divBotonesSelector.show();
		btnCerrarFiltro.hide();
		btnCerrarFiltro.removeClass("d-inline-block");
	}

	function clearElement(item) {
		var element = $('#_IYBIWBCC_' + item.value);
		if (element.is("input")) {
			if (element.attr('type') === "text") {
				element.val('');
			} else if (element.attr('type') === "checkbox") {
				element.attr('checked', false);
			}
		} else if (element.is("select")) {
			element.selectpicker('val', '');
		}
	}

	//var selSeccionCategoryId = $('#_IYBIWBCC_');

	function getFieldValues() {
		//keywordsValue = txtFiltrosKeywords.val();
		//tematicaSubcategoryIdValue = selTematica.val();
		//plazoAbiertoValue = chkPlazoAbierto.is(':checked');
		//plazoProximoCerrarValue = chkProximoCerrar.is(':checked');
	}

	var btnBuscarFiltros = $('#_IYBIWBCC_buscarFiltro');
	var btnBuscar = $('#_IYBIWBCC_buscar');


    function realizarBusquedaForm(busquedaAvanzada){
        try{
        	errorMessageDiv.html('');
            var isValid = isFormValid();
            var isDateValid = validateDate();
           	var isDateDispValid = validateDateDisp();
            //console.log("isValid " + isValid + " date " + isDateValid + " dateDisp " + isDateDispValid);
            if(isValid && isDateValid && isDateDispValid){
                fmFiltros.submit();
            }else if(!isValid){
                errorMessageDiv.html('<div class="form-validator-stack help-block"><div role="alert">Introduzca algún criterio de búsqueda</div></div>');
            }
        }catch(err){
            console.error(err);
        }
    }

    function isFormValid() {
        //console.log("checkFields");
        var inputs = fmFiltros.find('input, textarea, select').not(':input[type=hidden], :input[type=button], :input[type=submit], :input[type=reset]');

        var filled = inputs.filter(function(){
            return $.trim($(this).val()).length > 0;
        });

        if(filled.length === 0) {
            return false;
        }
        return true;
    }



	function validateDate() {
        var isValid = false;
        dateInvalidRangeErrorDiv.hide();
        dateInvalidRangeErrorDiv.addClass("hidden");
        isValid = validateRangeDate(
            "_IYBIWBCC_fromDate",
            "_IYBIWBCC_dateFromBolDay",
            "_IYBIWBCC_dateFromBolMonth",
            "_IYBIWBCC_dateFromBolYear",
            "_IYBIWBCC_toDate",
            "_IYBIWBCC_dateToBolDay",
            "_IYBIWBCC_dateToBolMonth",
            "_IYBIWBCC_dateToBolYear"
        );
        showInputValidationResult('_IYBIWBCC_fromDate', isValid);
        showInputValidationResult('_IYBIWBCC_toDate', isValid);
        if(!isValid){
            dateInvalidRangeErrorDiv.show();
            dateInvalidRangeErrorDiv.removeClass("hidden");
        }
        //console.log("validateDate bob "  + isValid);
        return isValid;
	}
	
	
	function validateDateDisp(){
        var isValid = false;
        dateDispInvalidRangeErrorDiv.addClass("hidden");
        dateDispInvalidRangeErrorDiv.hide();
        isValid = validateRangeDate(
            "_IYBIWBCC_fromDateDisp",
            "_IYBIWBCC_dateFromDispDay",
            "_IYBIWBCC_dateFromDispMonth",
            "_IYBIWBCC_dateFromDispYear",
            "_IYBIWBCC_toDateDisp",
            "_IYBIWBCC_dateToDispDay",
            "_IYBIWBCC_dateToDispMonth",
            "_IYBIWBCC_dateToDispYear"
        );
        showInputValidationResult('_IYBIWBCC_fromDateDisp', isValid);
        showInputValidationResult('_IYBIWBCC_toDateDisp', isValid);
        if(!isValid){
            dateDispInvalidRangeErrorDiv.show();
            dateDispInvalidRangeErrorDiv.removeClass("hidden");
        }
        //console.log("validateDate disp bob "  + isValid);
        return isValid;
	}

	function showInputValidationResult(inputIdFieldId, isValid){
	    try{
	        //console.log("showInputValidationResult");
            var field = $("#" + inputIdFieldId);
            if (isValid) {
                 field.removeClass('error-field');
                 field.addClass('success-field');
                 var parent = field.parent().parent();
                 parent.removeClass('has-error');
                 parent.addClass('has-success');
                 var divMain = parent.parent().parent().parent();
                 divMain.removeClass('has-error');
                 divMain.addClass('has-success');
            } else {
                field.removeClass('success-field');
                field.addClass('error-field');
                var parent = field.parent().parent();
                parent.removeClass('has-success');
                parent.addClass('has-error');
                var divMain = parent.parent().parent().parent();
                divMain.removeClass('has-success');
                divMain.addClass('has-error');
            }
        }catch(exception){
            console.error(exception);
        }
	}



})();
});

</script>









