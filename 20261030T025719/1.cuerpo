  }

  function descargarJSONAnuncio(obj, nombreAnuncio) {
    downloadObjectAsJson(obj, 'Datos_Abiertos');
  }

  function downloadObjectAsJson(exportObj, exportName) {
    var dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(exportObj));
    var downloadAnchorNode = document.createElement('a');
    downloadAnchorNode.setAttribute("href", dataStr);
    downloadAnchorNode.setAttribute("download", exportName + ".json");
    document.body.appendChild(downloadAnchorNode); // required for firefox
    downloadAnchorNode.click();
    downloadAnchorNode.remove();
  }

  function enlacePadre() {
    window.top.location.href = "https://des-sede.diphuelva.es/opencms/opencms/sede#";
  }

  function ini() {
    for (i = 0; ele = document.getElementsByClassName('anuncio_izq')[i]; i++)
      if (ele.onclick != undefined)
        ele.style.cursor = 'pointer';
  }

  function medicion() {

    const targetFrame = window.top;

    var altura = document.body.scrollHeight;

    targetFrame.postMessage(altura, "https://sede.diphuelva.es");

    // Para rehacer los enlaces ancla
    var enlaces = document.querySelectorAll('a[href^="#"]'); // Obtén todos los enlaces con atributo href que comienza con "#"

    enlaces.forEach(function(enlace) {
      enlace.addEventListener('click', function(event) {
        event.preventDefault(); // Evita el comportamiento predeterminado del enlace

        var elementoDestino = document.querySelector(this.getAttribute('href'));

        if (elementoDestino) {
          elementoDestino.scrollIntoView({
            behavior : 'smooth'
          }); // Desplázate al elemento destino de manera suave
        }
      });
    });

  }
</script>





