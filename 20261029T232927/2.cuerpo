{"hits":1,"total_hits":1,"schema":{"fields":[{"name":"id","type":"str"},{"name":"title","type":"str"},{"name":"number","type":"str"},{"name":"startPageDisposition","type":"str"},{"name":"dateDispositionUTC","type":"str"},{"name":"date","type":"date"},{"name":"dateUTC","type":"date"},{"name":"lawDisposition","type":"str"},{"name":"endPageDisposition","type":"str"},{"name":"titleSec","type":"str"},{"name":"organisation","type":"str"},{"name":"year","type":"str"},{"name":"type","type":"str"},{"name":"dispositionNumber","type":"str"},{"name":"hasPdf","type":"str"},{"name":"section","type":"str"},{"name":"sectionN1","type":"str"},{"name":"sectionN2","type":"str"},{"name":"sectionN3","type":"str"},{"name":"subsection","type":"str"},{"name":"organism","type":"str"},{"name":"summary","type":"str"},{"name":"summaryNoHtml","type":"str"},{"name":"body","type":"str"},{"name":"bodyNoHtml","type":"str"},{"name":"subtitle","type":"str"},{"name":"headsup","type":"str"},{"name":"version","type":"str"},{"name":"internal","type":"str"},{"name":"pdf.id_file","type":"str"},{"name":"pdf.pathPdf","type":"str"},{"name":"pdf.hashPdf","type":"str"},{"name":"pdf.signatureFile","type":"str"},{"name":"pdf.publicUrl","type":"str"}]},"results":[{"id":"disposition.2026.219201.1","title":"disposition.2026.219201.1","number":219201,"startPageDisposition":1,"dateDispositionUTC":"2026-09-30T00:00:00Z","date":"02/10/2026","dateUTC":"2026-10-02T00:00:00Z","lawDisposition":0,"endPageDisposition":1,"titleSec":"2. Autoridades y personal","organisation":"Consejería de Vivienda, Juventud y Ordenación del Territorio","year":2026,"type":"Órdenes","dispositionNumber":1,"hasPdf":true,"section":"<p styleClass=\"SECCION_N1\">2. Autoridades y personal</p>","sectionN1":"2. Autoridades y personal","sectionN2":"2.1. Nombramientos, situaciones e incidencias","organism":"<p styleClass=\"ORGANISMO\">Consejería de Vivienda, Juventud y Ordenación del Territorio</p>","summary":"<p styleClass=\"ASUMARIO\">Orden de 30 de septiembre de 2026, por la que se nombra a doña Nombre Apellido Segundo como personal eventual en el puesto de Jefa del Gabinete de la Consejera de Vivienda, Juventud y Ordenación del Territorio.</p>","summaryNoHtml":"Orden de 30 de septiembre de 2026, por la que se nombra a doña Nombre Apellido Segundo como personal eventual en el puesto de Jefa del Gabinete de la Consejera de Vivienda, Juventud y Ordenación del Territorio.","body":"<p styleClass=\"sinEstilo\">En virtud del artículo 12.3 del texto refundido de la Ley del Estatuto Básico del Empleado Público, aprobado por el Real Decreto Legislativo 5/2015, de 30 de octubre, del artículo 18 de la Ley 5/2023, de 7 de junio, de la Función Pública de Andalucía, y de conformidad con lo establecido en el artículo 2.1 del Decreto 439/2019, de 2 de abril, por el que se determina los puestos de personal eventual de la Junta de Andalucía y sus condiciones retributivas,</p><p styleClass=\"sinEstilo\">DISPONGO</p><p styleClass=\"sinEstilo\">El nombramiento de doña Nombre Apellido Segundo, con DNI **000***, como personal eventual en el puesto «Jefa de Gabinete», código 13663510, del Gabinete de la Consejera, con efectos administrativos y económicos del día 1 de octubre de 2026.</p><p styleClass=\"sinEstilo\">Sevilla, 30 de septiembre de 2026</p><table><tbody><tr info=\"index:1. n_cols:2. n_cells:4. n_max_cells:4\"><td/><td colspan=\"1\" rowspan=\"1\">ROCÍO DÍAZ JIMÉNEZ</td></tr><tr info=\"index:3. n_cols:2. n_cells:4. n_max_cells:4\"><td/><td colspan=\"1\" rowspan=\"1\">Consejera de Vivienda, Juventud <br/>y Ordenación del Territorio</td></tr></tbody></table>","bodyNoHtml":"En virtud del artículo 12.3 del texto refundido de la Ley del Estatuto Básico del Empleado Público, aprobado por el Real Decreto Legislativo 5/2015, de 30 de octubre, del artículo 18 de la Ley 5/2023, de 7 de junio, de la Función Pública de Andalucía, y de conformidad con lo establecido en el artículo 2.1 del Decreto 439/2019, de 2 de abril, por el que se determina los puestos de personal eventual de la Junta de Andalucía y sus condiciones retributivas, DISPONGO El nombramiento de doña Nombre Apellido Segundo, con DNI **000***, como personal eventual en el puesto «Jefa de Gabinete», código 13663510, del Gabinete de la Consejera, con efectos administrativos y económicos del día 1 de octubre de 2026. Sevilla, 30 de septiembre de 2026 ROCÍO DÍAZ JIMÉNEZ Consejera de Vivienda, Juventud y Ordenación del Territorio","subtitle":"2.1. Nombramientos, situaciones e incidencias","headsup":false,"version":4,"internal":344239,"pdf":[{"signatureFile":"","pathPdf":"BOJA26-219201-00001-13009-01_00344239","id_file":1,"publicUrl":"https://juntadeandalucia.es/eboja/2026/219201/BOJA26-219201-00001-13009-01_00344239.pdf","hashPdf":"ObKfLGdu4ohQCNRq2YsPzpE4IYI="}]}]}