  "estado": "candidato",
  "semillas": [
   "https://www.kellogg.northwestern.edu/-/media/files/executive-education/bios/tom-turmell-bio.ashx",
   "https://www.kellogg.northwestern.edu/~/media/files/executive-education/ksi-recommended-reading.pdf",
   "https://www.mccormick.northwestern.edu/events/ics-download.php?title=CS+Seminar%3A+What+25+Days+of+Optimisations+Taught+Me+About+Compilers+%28Matt+Godbolt%29&desc=Monday+%2F+CS+Seminar%5CnSeptember+28+%2F+12%3A00+PM%5CnHybrid+%2F+Mudd+3514%5CnSpeaker%5CnMatt+Godbolt%2C+Hudson+River+Trading%5CnTalk+Title%5CnWhat+25+Days+of+Optimisations+Taught+Me+About+Compilers%5CnAbstract%5CnIn+December+last+year+I+posted+a+short+video+every+day+about+a+different+compiler+optimisation.+Some+were+obvious%2C+some+surprised+me%2C+a+handful+caught+me+out+completely%2C+and+some+turned+out+to+be+compiler+bugs.+This+talk+distils+the+most+interesting+into+one+story+about+where+modern+optimisers+are+scarily+good%2C+where+they%27re+stubbornly+bad%2C+and+what+we+can+do+as+C%2B%2B+programmers+to+help+them.%5CnBiography%5CnMatt+Godbolt+is+the+creator+and+primary+maintainer+of+Compiler+Explorer.+A+C%2B%2B+developer+based+in+Chicago%2C+he+works+at+Hudson+River+Trading+and+is+one+half+of+the+Two%27s+Complement+podcast.+His+career+has+been+a+steady+journey+deeper+into+the+machine%3A+from+writing+rendering+engines+for+video+games+to+years+of+low-latency+trading+systems.+When+not+hacking+on+Compiler+Explorer%2C+Matt+likes+to+write+emulators+for+the+computers+he+grew+up+on%2C+the+ZX+Spectrum%2C+BBC+Micro+and+Sega+Master+System.%5Cn%5CnPiP+URL%3A+https%3A%2F%2Fplanitpurple.northwestern.edu%2Fevent%2F642867&start=20260928T120000&end=20260928T130000&group=Department%20of%20Computer%20Science%20(CS)&location=3514,%20Mudd%20Hall%20(%20formerly%20Seeley%20G.%20Mudd%20Library)&pipurl=https://planitpurple.northwestern.edu/event/642867",
   "https://www.mccormick.northwestern.edu/events/ics-download.php?title=IEMS+Seminar+%7C+Rene+Caldentey&desc=Bio%3A+Ren%C3%A9+Caldentey+is+a+Professor+of+Operations+Management.+His+primary+research+interests+include+stochastic+modeling+with+applications+to+revenue+and+retail+management%2C+queueing+theory%2C+and+finance.+He+has+been+published+in+numerous+journals+including+Advances+in+Applied+Probability%2C+Econometrica%2C+Management+Science%2C+Mathematics+of+Operations+Research%2C+M%26SOM%2C+Operations+Research+and+Queueing+Systems.+He+has+served+on+the+editorial+board+of+Management+Science%2C+M%26SOM%2C+Operations+Research%2C+Production+and+Operations+Management+and+the+Journal+of+Systems+and+Engineering+%28in+Spanish%29.%5CnPrior+to+joining+Booth%2C+Caldentey+was+a+professor+in+the+department+of+Information%2C+Operations+and+Management+Science+at+New+York+University+Stern+School+of+Business.+Before+joining+NYU+Stern+in+2001%2C+he+worked+for+the+Chilean+Central+Bank+and+taught+at+the+University+of+Chile+and+The+Sloan+School+of+Management+at+Massachusetts+Institute+of+Technology+%28MIT%29.%5CnProfessor+Caldentey+received+his+Master+of+Arts+in+civil+industrial+engineering+from+the+University+of+Chile+and+his+Doctor+of+Philosophy+in+operations+management+from+MIT.%5Cn%5CnPiP+URL%3A+https%3A%2F%2Fplanitpurple.northwestern.edu%2Fevent%2F645113&start=20261201T110000&end=20261201T120000&group=Department%20of%20Industrial%20Engineering%20and%20Management%20Sciences%20(IEMS)&location=TBD,%20Technological%20Institute&pipurl=https://planitpurple.northwestern.edu/event/645113",
   "https://www.mccormick.northwestern.edu/events/ics-download.php?title=NICO+Reading+Group+-+Fall+2026+First+Meeting&desc=The+NICO+Reading+Group+meets+for+the+first+this+fall+on+Wednesday%2C+September+23%2C+2026.+Please+contact+Jaeseon+Ha+if+you+are+interested+in+joining+our+group.%5Cn%5CnAbout%3A%5CnThe+NICO+Reading+Group+brings+together+people+across+disciplines+to+read+and+discuss+important+ideas+in+modern+AI.+We+focus+on+topics+such+as+AI+agents%2C+tuning%2C+harnesses%2C+evaluation%2C+AI+for+scientific+discovery%2C+and+applications+of+AI+across+different+fields.+The+goal+is+to+understand+important+ideas+in+AI+more+deeply+by+learning+and+thinking+across+disciplines.%5CnLeadership%3A%5CnJaeseon+Ha%2C+a+Kellogg+MBA+%2B+AI+student%2C+will+lead+the+reading+group+during+the+Fall+2026+term.+Please+contact+Jaeseon+with+any+questions+or+reach+out+to+us+at+nico%40northwestern.edu.%5CnMeeting+Times%3A%5CnDate%3A+Biweekly+on+Wednesday+evening%2C+starting+on+September+23%2C+2026%5CnTime%3A+6-7pm%5CnLocation%3A+NICO+main+office%2C+Chambers+Hall%2C+%5Cn600+Foster+St%2C+Evanston%2C+IL+60208%5Cn%5CnPiP+URL%3A+https%3A%2F%2Fplanitpurple.northwestern.edu%2Fevent%2F646225&start=20260923T180000&end=20260923T190000&group=Northwestern%20Institute%20on%20Complex%20Systems%20(NICO)&location=Chambers%20Hall&pipurl=https://planitpurple.northwestern.edu/event/646225"
