	var extractRules = function(boletines, anyo, mes) {
		var keys = Object.keys(boletines);
		var boletinrule = {};
		boletinrule[anyo] = {};
		boletinrule[anyo][mes] = {};
		var days = jQuery.map( keys, function(key){
			return new Date(key).getDate();
		}).join(',');
		boletinrule[anyo][mes][days] = 'boletin-' + anyo + '-' + mes;

		return boletinrule;
	}

	var boletines = {"2026-10-30":[{"boletinId":"2026.218","extraordinario":null,"numero":218}],"2026-10-29":[{"boletinId":"2026.217","extraordinario":"EXTRAORDINARIO","numero":217},{"boletinId":"2026.216","extraordinario":null,"numero":216}],"2026-10-28":[{"boletinId":"2026.215","extraordinario":null,"numero":215}],"2026-10-27":[{"boletinId":"2026.214","extraordinario":null,"numero":214}],"2026-10-26":[{"boletinId":"2026.213","extraordinario":null,"numero":213}],"2026-10-23":[{"boletinId":"2026.212","extraordinario":null,"numero":212}],"2026-10-22":[{"boletinId":"2026.211","extraordinario":null,"numero":211}],"2026-10-21":[{"boletinId":"2026.210","extraordinario":null,"numero":210}],"2026-10-20":[{"boletinId":"2026.209","extraordinario":null,"numero":209}],"2026-10-19":[{"boletinId":"2026.208","extraordinario":null,"numero":208}],"2026-10-16":[{"boletinId":"2026.207","extraordinario":null,"numero":207}],"2026-10-15":[{"boletinId":"2026.206","extraordinario":null,"numero":206}],"2026-10-14":[{"boletinId":"2026.205","extraordinario":null,"numero":205}],"2026-10-13":[{"boletinId":"2026.204","extraordinario":null,"numero":204}],"2026-10-12":[{"boletinId":"2026.203","extraordinario":"EXTRAORDINARIO","numero":203}],"2026-10-10":[{"boletinId":"2026.202","extraordinario":"EXTRAORDINARIO","numero":202}],"2026-10-09":[{"boletinId":"2026.201","extraordinario":null,"numero":201}],"2026-10-08":[{"boletinId":"2026.200","extraordinario":null,"numero":200}],"2026-10-07":[{"boletinId":"2026.199","extraordinario":null,"numero":199}],"2026-10-06":[{"boletinId":"2026.198","extraordinario":null,"numero":198}],"2026-10-05":[{"boletinId":"2026.197","extraordinario":null,"numero":197}],"2026-10-02":[{"boletinId":"2026.196","extraordinario":null,"numero":196}],"2026-10-01":[{"boletinId":"2026.195","extraordinario":null,"numero":195}]};
	var defaultYear = 2026;
	var defaultMonth = 9;
	var defaultEnabledRulename = 'boletin-' + defaultYear + '-' + defaultMonth;
	var boletinrulenames = [defaultEnabledRulename];
	var boletinrules = extractRules(boletines, defaultYear, defaultMonth);
	var fecha = new Date('2026-10-01');


	// realiza llamada ajax para recuperar los boletines de un mes y refresca el calendario
	var getBoletines = function (anyo, mes) {
		var rulename = 'boletin-' + anyo + '-' + mes;

		if (boletinrulenames.indexOf(rulename) == -1) {
			A.io.request('https://bon.navarra.es/es/inicio?p_p_id=es_navarra_bon_calendario_portlet_CalendarioPortlet_INSTANCE_6JrV16g0duGz&p_p_lifecycle=2&p_p_state=normal&p_p_mode=view&p_p_resource_id=getBoletines&p_p_cacheability=cacheLevelPage', {
