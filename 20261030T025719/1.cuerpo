  var jsonGlobal;

  function DescargarPDF(trabajoFirma) {

    /*
    var fr = document.getElementById("frDocumento");
    if (fr)
      fr.src = "/lib/bope/anuncios_bop/anuncioBop-doc.php?trabajofirma="+trabajoFirma;
