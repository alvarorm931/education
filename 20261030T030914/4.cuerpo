                var htmlCalendarioFuturo = $('.CalendarioSAGA[data-cssid="calendario_saga-n151130"] .CalendarioSAGA-futuro').html();
                var htmlCalendarioFuturoReplace = htmlCalendarioFuturo.replace(/<script>([^<]*)<\/script>/g, '');


                $('<div class="CargandoCalendario oculto"><lottie-player src="/export/system/modules/com.saga.contenidos/resources/json/cargando-calendario.json" background="transparent" loop autoplay></lottie-player></div>').appendTo($('.CalendarioSAGA[data-cssid="calendario_saga-n151130"] .calendar-events'));

                $('#CalendarioSAGA-calendario_saga-n151130 .calendar-events .event-list').html(htmlCalendarioFuturoReplace);
                $('.CalendarioSAGA[data-cssid="calendario_saga-n151130"] .CalendarioSAGA-futuro').remove();
                $('#CalendarioSAGA-calendario_saga-n151130 .event-header').html($('.CalendarioSAGA[data-cssid="calendario_saga-n151130"] .CalendarioSAGA-futuro-titulo').html());
                $('.CalendarioSAGA[data-cssid="calendario_saga-n151130"] .CalendarioSAGA-futuro-titulo').remove();


                $("#CalendarioSAGA-calendario_saga-n151130").CalendarioSaga({
                    urlAjax: '/system/modules/com.saga.contenidos/elements/CalendarioSaga-element.jsp',
                    urlActual: '/publica/consulta-de-bops/index.html',
                    urlBase: '',
                    subSiteActual: '/publica/',
