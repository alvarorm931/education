    <script>
      function quitatodos( id ) {
        var children = document.body.getElementsByTagName('div');
        for (var i = 0, length = children.length; i < length; i++) {
          child = children[i];
          if (child.id.substr(0, id.length) == id)
            child.setAttribute("class","");
        }
      }
      function selsimple(selector){
          quitatodos("search-extrafield-" + selector);
          var selActual = document.getElementById('sel_' + selector);
          var valor = selActual.value;
          var destino = document.getElementById("search-extrafield-" + valor);
          destino.setAttribute("class","selected");
      }
    </script>
