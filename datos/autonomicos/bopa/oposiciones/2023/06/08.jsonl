{"id": "BOPA-2023-04817", "codigo": "2023-04817", "seccion": "I. Principado de Asturias", "apartado": "OTRAS DISPOSICIONES", "organismo": "UNIVERSIDAD DE OVIEDO", "suborganismo": null, "titulo": "Resolución de 26 de mayo de 2023, del Secretario General de la Universidad de Oviedo, por la que se emplaza a los interesados en los recursos de alzada 63/2023 y 65/2023, interpuestos contra las Resoluciones de 3 de mayo de 2023, del Tribunal, en las que se desestiman sus alegaciones frente al Acuerdo de 23 de marzo de 2023 sobre las puntuaciones provisionales de los aspirantes en el proceso selectivo convocado por Resolución del Rector de la Universidad de Oviedo, de fecha 18 de octubre de 2022 (BOPA de 31 de octubre de 2022), para la provisión por el sistema general de acceso libre de quince plazas de la Escala de Auxiliares Administrativos, Subgrupo C2, en el marco de estabilización de empleo temporal, por el sistema de concurso. También, se emplaza a los interesados en los recursos de reposición 64/2023 y 66/2023 interpuestos contra la Resolución del Rector de la Universidad de Oviedo, de 11 de mayo de 2023, que aprueba la lista definitiva de puntuaciones de los aspirantes a la convocatoria citada anteriormente.", "fuente": "BOPA", "fecha": "2023-06-08", "boletin": 109, "extraordinario": false, "url_html": "https://miprincipado.asturias.es/bopa/disposiciones?p_p_id=pa_sede_bopa_web_portlet_SedeBopaDispositionWeb&p_p_lifecycle=0&_pa_sede_bopa_web_portlet_SedeBopaDispositionWeb_mvcRenderCommandName=%2Fdisposition%2Fdetail&p_r_p_dispositionText=2023-04817&p_r_p_dispositionReference=2023-04817&p_r_p_dispositionDate=08%2F06%2F2023", "url_pdf": "https://miprincipado.asturias.es/bopa/2023/06/08/2023-04817.pdf", "captura_sha256": "771061f44f4efc0679de9c975e15b46911cc2dc5d465bcff85a66f3d5e6f392d", "ambito": "universidad", "tipo_acto": "admitidos", "modalidad": "estabilizacion", "alcance": "acceso", "convocante": null}
