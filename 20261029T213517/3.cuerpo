		<frame src="main1.php" name="mainFrame" id="mainFrame" title="mainFrame" />
		<frame src="pie.php" name="bottomFrame" scrolling="No" noresize="noresize" id="bottomFrame" title="bottomFrame" />
	</frameset>
</frameset>
