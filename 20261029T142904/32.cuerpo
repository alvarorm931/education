<script language="JavaScript" type="text/javascript">
	function fnContarResultados( ){
		var urlCount="/p43aBOPVWebWar/realizarBusquedaAvanzada.do";
		var parametrosurl="idioma=1&R01HNoPortal=true&submit=Contar&textoDisposicion="+$('#textoDisposicionID').val();
		var respuesta=$.ajax( {
			async: true,
			url: urlCount,
	        crossDomain: true,
	        type: 'GET',
   	        data: parametrosurl,
   	        dataType: 'jsonp', 
			error: function (XMLHttpRequest, textStatus, errorThrown) {
				alert('Error al obtener numero total de registros');
			},
			success:function (data, textStatus, jqXHR) {
				if (data.count!=0 && data.count!='Error') {
					$('#formConsultaSimple').submit();
				} else {
					if (data.count==0) {
						alert('No se han encontrado resultados');
					}
				}
			}
		} );
	}
   document.write("<a href='javascript:fnContarResultados()'><img src='/appcont/servibopvi/images/buscarPrinci.gif' alt='Buscar' /></a>");
</script>
