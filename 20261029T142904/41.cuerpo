	    function setIdioma() {
	        var tableReg = document.getElementById('tabla_cabeceras_tablas');			
			var cellsOfRow="";
			var indiceIdioma = 0; //('ES' == "ES") ? 0 : 1;
	        // Recorremos todas las filas y ocultamos la columna que no corresponde con el idioma.
			for (var i = 0; i < tableReg.rows.length; i++)
			{
				cellsOfRow = tableReg.rows[i].getElementsByTagName('td');
				cellsOfRow[indiceIdioma].style.display = "none";
            }

            
            //Ahora la segunda tabla, la de los boletines
            tableReg = document.getElementById('grdAnuncios');
            if (tableReg != null) {
                for (var i = 0; i < tableReg.rows.length; i++) {
                    cellsOfRow = tableReg.rows[i].getElementsByTagName('td');
                    cellsOfRow[indiceIdioma].style.display = "none";
                }
            }

            var tagBoletines = document.getElementById('boletines');
            if (tagBoletines != null) {
                tagBoletines.style.visibility = "visible";
            }

            //Boletin2
            if ('N' != "N") {
                var tableReg_2 = document.getElementById('tabla_cabeceras_tablas_2');
                var cellsOfRow_2 = "";
                var indiceIdioma_2 = 0; //('ES' == "ES") ? 0 : 1;
                // Recorremos todas las filas y ocultamos la columna que no corresponde con el idioma.
                for (var i = 0; i < tableReg_2.rows.length; i++) {
                    cellsOfRow_2 = tableReg_2.rows[i].getElementsByTagName('td');
                    cellsOfRow_2[indiceIdioma_2].style.display = "none";
                }


                //Ahora la segunda tabla, la de los boletines
                tableReg_2 = document.getElementById('grdAnuncios_2');
                if (tableReg_2 != null) {
                    for (var i = 0; i < tableReg_2.rows.length; i++) {
                        cellsOfRow_2 = tableReg_2.rows[i].getElementsByTagName('td');
                        cellsOfRow_2[indiceIdioma_2].style.display = "none";
                    }
                }

                var tagBoletines_2 = document.getElementById('boletines_2');
                if (tagBoletines_2 != null) {
                    tagBoletines_2.style.visibility = "visible";
                }
                var tagAnuncios_2 = document.getElementById('anuncios_2');
                if (tagAnuncios_2 != null) {
                    tagAnuncios_2.style.visibility = "visible";
                }
            }
            else {
                var tagBoletines_2 = document.getElementById('boletines_2');
                if (tagBoletines_2 != null) {
                    tagBoletines_2.style.visibility = "hidden";
                }
                var tagAnuncios_2 = document.getElementById('anuncios_2');
                if (tagAnuncios_2 != null) {
                    tagAnuncios_2.style.visibility = "hidden";
                }
            }    
        }

        function setIdiomaBilingue() {
            var tableReg = document.getElementById('tabla_cabeceras_tablas');
            var cellsOfRow = "";
            var indiceIdioma = ('ES' == "ES") ? 0 : 1;
            // Recorremos todas las filas y ocultamos la columna que no corresponde con el idioma.
            for (var i = 0; i < tableReg.rows.length; i++) {
                cellsOfRow = tableReg.rows[i].getElementsByTagName('td');
                cellsOfRow[indiceIdioma].style.display = "table-cell";
                cellsOfRow[1 - indiceIdioma].style.display = "table-cell";
            }

            //Ahora la segunda tabla, la de los boletines
            tableReg = document.getElementById('grdAnuncios');
            if (tableReg != null) {
                for (var i = 0; i < tableReg.rows.length; i++) {
                    cellsOfRow = tableReg.rows[i].getElementsByTagName('td');
                    cellsOfRow[indiceIdioma].style.display = "table-cell";
                    cellsOfRow[indiceIdioma].style.verticalAlign = "baseline";
                    cellsOfRow[1 - indiceIdioma].style.display = "table-cell";
                    cellsOfRow[1 - indiceIdioma].style.verticalAlign = "baseline";
                }
            }
            // Hay que ocultar la celda de bilinguismo.
            var bilingue = document.getElementById('columnaBilin');
            bilingue.style.display = "none";
            bilingue = document.getElementById('columnaBilin2');
            bilingue.style.display = "none";
            
            //Si venimos de idioma euskera, invertir la columna, puesto que la de castellano estará primero y debe estar la de euskera siempre.
            if (indiceIdioma == 1) {
                tableReg = document.getElementById('tabla_cabeceras_tablas');
                for (var i = 0; i < tableReg.rows.length - 1; i++) {
                    cellsOfRow = tableReg.rows[i].getElementsByTagName('td');
                    var textAux = cellsOfRow[0].innerHTML;
                    cellsOfRow[0].innerHTML = cellsOfRow[1].innerHTML;
                    cellsOfRow[1].innerHTML = textAux;
                }
                //Fila de la celda de sumario, bilingue, imprimir

                tableReg = document.getElementById('tabla_cabeceras_tablas');

                var celda1 = document.getElementById('celdaBilingue');
                var celda2 = document.getElementById('celdaBilingue2');
                textAux = celda2.innerHTML;
                celda2.innerHTML = celda1.innerHTML;
                celda1.innerHTML = textAux;

                tableReg = document.getElementById('grdAnuncios');
                if (tableReg != null) {
                    for (var i = 0; i < tableReg.rows.length; i++) {
                        cellsOfRow = tableReg.rows[i].getElementsByTagName('td');
                        var textAux = cellsOfRow[0].innerHTML;
                        cellsOfRow[0].innerHTML = cellsOfRow[1].innerHTML;
                        cellsOfRow[1].innerHTML = textAux;
                    }
                }
           }

           var col1 = document.getElementById('menubilingueCol1');
           col1.style.width = "90%";
           col1 = document.getElementById('menubilingue2Col1');
           col1.style.width = "90%";
           
            //Boletin2
           if ('N' != "N") {
               var tableReg_2 = document.getElementById('tabla_cabeceras_tablas_2');
               var cellsOfRow_2 = "";
               var indiceIdioma_2 = ('ES' == "ES") ? 0 : 1;
               // Recorremos todas las filas y ocultamos la columna que no corresponde con el idioma.
               for (var i = 0; i < tableReg_2.rows.length; i++) {
                   cellsOfRow_2 = tableReg_2.rows[i].getElementsByTagName('td');
                   cellsOfRow_2[indiceIdioma_2].style.display = "table-cell";
                   cellsOfRow_2[1 - indiceIdioma_2].style.display = "table-cell";
               }

               //Ahora la segunda tabla, la de los boletines
               tableReg_2 = document.getElementById('grdAnuncios_2');
               if (tableReg_2 != null) {
                   for (var i = 0; i < tableReg_2.rows.length; i++) {
                       cellsOfRow_2 = tableReg_2.rows[i].getElementsByTagName('td');
                       cellsOfRow_2[indiceIdioma_2].style.display = "table-cell";
                       cellsOfRow_2[indiceIdioma_2].style.verticalAlign = "baseline";
                       cellsOfRow_2[1 - indiceIdioma_2].style.display = "table-cell";
                       cellsOfRow_2[1 - indiceIdioma_2].style.verticalAlign = "baseline";
                   }
               }
               // Hay que ocultar la celda de bilinguismo.
               var bilingue_2 = document.getElementById('columnaBilin_2');
               bilingue_2.style.display = "none";
               bilingue_2 = document.getElementById('columnaBilin2_2');
               bilingue_2.style.display = "none";

               //Si venimos de idioma euskera, invertir la columna, puesto que la de castellano estará primero y debe estar la de euskera siempre.
               if (indiceIdioma_2 == 1) {
                   tableReg_2 = document.getElementById('tabla_cabeceras_tablas_2');
                   for (var i = 0; i < tableReg_2.rows.length - 1; i++) {
                       cellsOfRow_2 = tableReg_2.rows[i].getElementsByTagName('td');
                       var textAux_2 = cellsOfRow_2[0].innerHTML;
                       cellsOfRow_2[0].innerHTML = cellsOfRow_2[1].innerHTML;
                       cellsOfRow_2[1].innerHTML = textAux_2;
                   }
                   //Fila de la celda de sumario, bilingue, imprimir

                   tableReg_2 = document.getElementById('tabla_cabeceras_tablas_2');

                   var celda1_2 = document.getElementById('celdaBilingue_2');
                   var celda2_2 = document.getElementById('celdaBilingue2_2');
                   textAux_2 = celda2_2.innerHTML;
                   celda2_2.innerHTML = celda1_2.innerHTML;
                   celda1_2.innerHTML = textAux_2;

                   tableReg_2 = document.getElementById('grdAnuncios_2');
                   if (tableReg_2 != null) {
                       for (var i = 0; i < tableReg_2.rows.length; i++) {
                           cellsOfRow_2 = tableReg_2.rows[i].getElementsByTagName('td');
                           var textAux_2 = cellsOfRow_2[0].innerHTML;
                           cellsOfRow_2[0].innerHTML = cellsOfRow_2[1].innerHTML;
                           cellsOfRow_2[1].innerHTML = textAux_2;
                       }
                   }
               }

               var col1_2 = document.getElementById('menubilingueCol1_2');
               col1_2.style.width = "90%";
               col1_2 = document.getElementById('menubilingue2Col1_2');
               col1_2.style.width = "90%";
           }
           else {
               var tagBoletines_2 = document.getElementById('boletines_2');
               if (tagBoletines_2 != null) {
                   tagBoletines_2.style.visibility = "hidden";
               }
               var tagAnuncios_2 = document.getElementById('anuncios_2');
               if (tagAnuncios_2 != null) {
                   tagAnuncios_2.style.visibility = "hidden";
               }
           }
        }										
    </script>
