    .state('home.transparencia', {
      url: '/transparencia', views: {
        "content": {
          templateUrl: 'views/transparencia/transparencia.html',
        }, "footer": {
          templateUrl: 'views/footerInterior.html'
        }
      }
    });

    $urlRouterProvider
    .otherwise('/home');

  }]).run(function ($rootScope) {

  $rootScope.$on('$stateChangeSuccess', function () {
    document.body.scrollTop = document.documentElement.scrollTop = 0;
  });

  $rootScope.$on('$stateChangeStart', function () {
    $rootScope.metaEli = false;
    $rootScope.metaCorrigendumEli = false;
  });

}).filter('filterEncodeURI', function () {
  return function (x) {
    console.log(encodeURIComponent(x));
    return encodeURIComponent(x);
  };
}).filter('monthValue', function () {
  var month = ["", "Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio",
    "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"];
  return function (x) {
    return month[x];
  };
});
