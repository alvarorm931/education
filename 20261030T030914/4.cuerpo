                    that: 'CalendarioSAGA-calendario_saga-n151130',
                    IndexacionFecha: 'xmlFechaListado_es_dt',
                    ResultadosPorPagina: '4',
                    mostrarImagen: 'false',
                    mostrarDescripcion: 'false',
                    mostrarDianas: 'true',
