					<div class="modal-header">
						<h4 class="modal-title" id="modalRegenerarLoteLabel">Cookies</h4>
					</div>
					<div class="modal-body">
						<p>Se han guardado sus preferencias en cuanto a cookies. Para cambiar sus preferencias en cualquier momento, consulte nuestra política de cookies o siga el enlace que figura a pie de página.</p>
					</div>

				</div>
			</div>
        </div>
		

<script>
var urlCookies = '/InfoGeneralPortal/Cookies/CookiesPersonalizar.html';
function cookiesConfig() {
	if (!(/usuario_mci=sesion_iniciada|digitalDataInfo;domain=ciencia\.gob\.es/).test(document.cookie)) {
		//si el usuario no ha aceptado todavía las cookies, muestra el pop-up de cookies

		var now = new Date().getTime();
		var expireDate = now + (1000*60*60*24*365);
		$('.cookies #personalizar-cookies').click(function () {
			var magnoliaInstance = window.location.origin;
			var magnoliaUrl = window.location.href;

			if (magnoliaUrl.indexOf("magnoliaPublic") > -1) {
				magnoliaInstance = magnoliaInstance + '/magnoliaPublic';
			} else if (magnoliaUrl.indexOf("magnoliaAuthor") > -1) {
				magnoliaInstance = magnoliaInstance + '/magnoliaAuthor';
			}

			setCookie('usuario_mci', 'sesion_iniciada', 365);
			window.location.href = magnoliaInstance + urlCookies;
		});
		$('.cookies button#aceptar-cookies').click(function (ev) {
			ev.preventDefault();
			$('.cookies').css('display','none');
			$('#modalDescartar').modal('show');
			let analiticaGlobal = $('#cookies-analitica').prop('checked');
			setTimeout(function () {
				$('#modalDescartar').modal('hide');
				setCookie('usuario_mci', 'sesion_iniciada', 365);
				if(analiticaGlobal) {
					/** setAnalyticsCookies(); */
					marketingTagAnalitica();
					var magnoliaInstance = window.location.origin;
					var url = window.location.href;
					window.location.href = url;
				}
			}, 3000);
		});
		$('.cookies button#rechazar-cookies').click(function (ev) {
			ev.preventDefault();
			$('.cookies').css('display','none');
			$('#modalDescartar').modal('show');
			$('#cookies-analitica').prop('checked', false);
			let analiticaGlobal = $('#cookies-analitica').prop('checked');
			setTimeout(function () {
				$('#modalDescartar').modal('hide');
				setCookie('usuario_mci', 'sesion_iniciada', 365);
				if(analiticaGlobal) {
					/** setAnalyticsCookies(); */
					marketingTagAnalitica();
					var magnoliaInstance = window.location.origin;
					var url = window.location.href;
					window.location.href = url;
				}
			}, 3000);
		});
	} else {
		//muestra avisos en función de las preferencias del usuario
		//carga idioma
		//deshabilita el formulario Feedback una vez has dado una vez
	}
	cookiesForms();
}
</script></body>
</html>
