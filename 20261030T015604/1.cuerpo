MATRIX="RENDIMI";
TITLE="Tasas de abandono del estudio (cohortes de nuevo ingreso en el estudio) por ámbito de estudio y sexo";
CONTENTS="Tasas de abandono del estudio (cohortes de nuevo ingreso en el estudio)";
CODEPAGE="iso-8859-15";
DESCRIPTION="Tasas de abandono del estudio (cohortes de nuevo ingreso en el estudio) por ámbito de estudio y sexo";
COPYRIGHT=YES;
NOTE="1) (.) : Dato no aplicable en dicha desagregación. (..) : Dato no disponible "
"por tener una población insuficiente para su cálculo"
"1) ~'Indicador,Tasa de abandono el 1º año'~Proporción de estudiantes de nuevo"
" ingreso en el curso X, no titulados en ese curso y no matriculados en ese es"
"tudio en el curso X+1 ni X+2"
"1) ~'Indicador,Tasa de abandono el 2º año'~Proporción de estudiantes de nuevo"
" ingreso en el curso X, matriculados en el mismo estudio en el curso X+1 y no"
" titulados, y no matriculados en ese estudio en el curso X+2 ni X+3"
"1) ~'Indicador,Tasa de abandono el 3º año'~Proporción de estudiantes de nuevo"
" ingreso en el curso X, matriculados en el mismo estudio en el curso X+2 y no"
" titulados, y no matriculados en ese estudio en el curso X+3 ni X+4"
"1) ~'Indicador,Tasa global de abandono'~Tasa de abandono el 1º año + Tasa de "
"abandono el 2º año + Tasa de abandono el 3º año";
DECIMALS=2;
SHOWDECIMALS=2;
