<script type="text/javascript"  data-senna-track="permanent">

var locale = 'es_ES';
var calendarId = '#_IYBIWBCC_datepicker';

var eventDates = {};
   $( function() {
       // datepicker
       $(calendarId).datepicker({
           dateFormat: 'yymmdd',
           changeMonth: true,
           changeYear: true,
           yearRange: '1982:+0',
           todayHighlight: true,
           hideIfNoPrevNext: true,
           beforeShowDay: function(date) {
               var yearCalendar = date.getFullYear();
               var monthCalendar = ((date.getMonth() + 1) < 10 ? '0' : '') + (date.getMonth() + 1);
               var dayCalendar = (date.getDate()  < 10 ? '0' : '') + date.getDate();
               var dateFormatedToFind = yearCalendar + monthCalendar + dayCalendar;
               var highlight = eventDates[dateFormatedToFind];
               if( highlight ) {
                  return [true, "ui-datepicker-week-end boletin_day", "Boletín día " +dayCalendar];
               } else {
                  return [false, '', ''];
               }
           },
           onChangeMonthYear: function (year, month, inst) {
               // Modify the datepicker every time the month/year is changed
               loadEvents(month, year);
              },
           onSelect: function(date) {
                var boletin = eventDates[date];
                if(boletin && boletin.fecha && boletin.num){
                    detailBoletin('https://www.bizkaia.eus/es/bob/resultados?p_p_id=IYBIWBCC&p_p_lifecycle=0&p_p_state=normal&p_p_mode=view&_IYBIWBCC_mvcRenderCommandName=%2Fdetail&_IYBIWBCC_bdate=___DATE__BOLETIN__&_IYBIWBCC_bnum=___NUM__BOLETIN__',  boletin.fecha, boletin.num);
                }
           }
       }).datepicker('setDate', new Date());
       $.datepicker.setDefaults($.datepicker.regional[locale]);
       loadEvents('10', '2026');    
              
				$('.ui-datepicker-next').on('click', function(e) {
					   e.preventDefault(); 
					   setTimeout(function() {
               $( ".ui-datepicker-next" ).focus();	
							$this.focus();
						}, 500);
					});
				
				$('.ui-datepicker-prev').on('click', function(e) {
					   e.preventDefault();					   					   
					   setTimeout(function() {
                $( ".ui-datepicker-prev" ).focus();
							$this.focus();
						}, 500);
					});
				
				$('.ui-datepicker-month').on('change', function(e) {
				    e.preventDefault(); // Prevenir comportamiento predeterminado si aplica 
				    setTimeout(function() {
				    	$( ".ui-datepicker-month" ).focus();
								$this.focus();
							}, 500);
						});  
				$('.ui-datepicker-year').on('change', function(e) {
				    e.preventDefault(); // Prevenir comportamiento predeterminado si aplica 
				    setTimeout(function() {
				    	$( ".ui-datepicker-year" ).focus();
								$this.focus();
							}, 500);
						});  
   });


   function loadEvents(month, year) {
	   eventDates = {};
	   $.ajax({
	     url: 'https://www.bizkaia.eus/es/bob?p_p_id=IYBIWBCC&p_p_lifecycle=2&p_p_state=normal&p_p_mode=view&p_p_resource_id=%2Fiybiwbcc%2FresourceBoletin&p_p_cacheability=cacheLevelPage',
	     type: 'POST',
	     dateType: 'application/json; charset=utf-8',
	     data: {
	       '_IYBIWBCC_year': year,
	       '_IYBIWBCC_month': month
	     },
	     cache: false,
	     beforeSend: function beforeSend() {//$("#calendar_loader").show();
	     }
	   }).done(function (data) {
	     if (data.length) {
	       events = JSON.parse(data);
	       $.each(events, function (index, item) {
	         if (item.fechaBoletin) {
	           var boletin = {};
	           boletin.fecha = item.fechaBoletin;
	           boletin.num = item.numeroBoletin;
	           eventDates[item.fechaBoletin] = boletin;
	         }
	       });
	       $(calendarId).datepicker("refresh");
         
         $('.ui-datepicker-next').on('click', function(e) {
					   e.preventDefault(); 
					   setTimeout(function() {
               $( ".ui-datepicker-next" ).focus();	
							$this.focus();
						}, 500);
					});
				
				$('.ui-datepicker-prev').on('click', function(e) {
					   e.preventDefault();					   					   
					   setTimeout(function() {
                $( ".ui-datepicker-prev" ).focus();
							$this.focus();
						}, 500);
					});
				
				$('.ui-datepicker-month').on('change', function(e) {
				    e.preventDefault(); // Prevenir comportamiento predeterminado si aplica 
				    setTimeout(function() {
				    	$( ".ui-datepicker-month" ).focus();
								$this.focus();
							}, 500);
						});  

				$('.ui-datepicker-year').on('change', function(e) {
				    e.preventDefault(); // Prevenir comportamiento predeterminado si aplica 
				    setTimeout(function() {
				    	$( ".ui-datepicker-year" ).focus();
								$this.focus();
							}, 500);
						});  

	     }
	   }).fail(function (jqXHR, textStatus, errorThown) {
	     console.error(errorThown);
	   });
	 }
</script>

	
	
					
				
			
		
	
	


