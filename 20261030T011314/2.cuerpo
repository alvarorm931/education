					formId: event.formId,
					title: event.title
				}
			);
		}
	}
);

</script><script>

</script>


 


<script>
    //leer cookies
    function getCookieGA(cname) {
        var name = cname + "=";
        var decodedCookie = decodeURIComponent(document.cookie);
        var ca = decodedCookie.split(';');
        for (var i = 0; i < ca.length; i++) {
            var c = ca[i];
            while (c.charAt(0) === ' ') {
                c = c.substring(1);
            }
            if (c.indexOf(name) === 0) {
                var arrayCookie = c.substring(name.length, c.length);
                return arrayCookie.includes('_ga');
                //return c.substring(name.length, c.length);
            }
        }
        return "";
    }
    //consent google analytics
    function allConsentGranted() {
                    gtag('consent', 'update', {
                'ad_user_data': 'granted',
                'ad_personalization': 'granted',
                'ad_storage': 'granted',
                'analytics_storage': 'granted'
            });
    }
</script>   

