    <script type="text/javascript">
        //<![CDATA[
        var texts = new Array('BOIB','LEY','DECRETO');
        
        function busquedaRapida(){
            document.getElementById("boibRapidaForm").submit();   
        }
        
        var recercaPerTipus = {
        	iniciar: function() {
        		jQuery("#ct_tipus").bind("change",recercaPerTipus.canviar);
        	},
        	canviar: function() {
        		valor = document.getElementById('ct_tipus').options[document.getElementById('ct_tipus').selectedIndex].value;
        		texte = document.getElementById('ct_tipus').options[document.getElementById('ct_tipus').selectedIndex].text.toUpperCase();
        		
        		if (valor == 0) {
        			
        			document.getElementById('tipusNumText').innerHTML = 'Número BOIB';
        			//document.getElementById('ct_numero').style.display = 'inline';
        			jQuery("#cajaCampoNumero").show();
        			
        		} else {
        			if (texte == texts[1].toUpperCase()) {
        				
        				document.getElementById('tipusNumText').innerHTML = 'N&uacute;m. ' + texts[1];
        				//document.getElementById('ct_numero').style.display = 'inline';
        				jQuery("#cajaCampoNumero").show();
        				
        			} else if (texte == texts[2].toUpperCase()) {
        				
        				document.getElementById('tipusNumText').innerHTML = 'N&uacute;m. ' + texts[2];
        				//document.getElementById('ct_numero').style.display = 'inline';
        				jQuery("#cajaCampoNumero").show();
        				
        			} else {
        				
        				document.getElementById('tipusNumText').innerHTML = '';
        				//document.getElementById('ct_numero').style.display = 'none';
        				jQuery("#cajaCampoNumero").hide();
        				
        			}
        		}
        	}
        };

        //addEvent(window,'load',recercaPerTipus.iniciar,false);
        jQuery(document).ready(function(){
        	recercaPerTipus.iniciar();
        });
    
    
    	function cercaTipus( formCercaTipus, formCERCA )
    	{
    		
    		if (  formCercaTipus.tip.options[ formCercaTipus.tip.selectedIndex ].value == '0' )
    		
    		//if ( ( formCercaTipus.p_numero.value != null && formCercaTipus.p_numero.value != '' ) || formCercaTipus.p_tipus.options[ formCercaTipus.p_tipus.selectedIndex ].value == '0' )
    		{
    			// Establecemos numero
    			formCERCA.num_ini.value = formCercaTipus.num_ini.value;
    			// Establecemos anyo
    			formCERCA.any_ini.value = formCercaTipus.any_ini.options[ formCercaTipus.any_ini.selectedIndex ].value;
    			
    			formCERCA.submit();
    			return true;
    		}
    		
    		
    		formCercaTipus.submit();
    		return true;
    	}
        //]]>
    </script>
	
