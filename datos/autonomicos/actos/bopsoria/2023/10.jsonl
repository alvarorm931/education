{"id": "bopsoria:BOPSORIA-2023-2355", "fecha": "2023-10-30", "fuente": "BOP-SORIA", "boletin": 124, "url": "https://bop.dipsoria.es/index.php/mod.documentos/mem.descargar/fichero.documentos_2355_827777c1%232E%23pdf", "url_pdf": "https://bop.dipsoria.es/index.php/mod.documentos/mem.descargar/fichero.documentos_2355_827777c1%232E%23pdf", "titulo": "Convocatoria plaza informador turístico", "organismo": null, "seccion": "II. ADMINISTRACIÓN LOCAL", "ambito": "local", "convocante": {"tipo": "Ayuntamiento", "nombre": "Garray", "provincia": "Soria", "organismo": "AYUNTAMIENTO DE GARRAY"}, "tipo_acto": "convocatoria", "alcance": "acceso", "modalidad": null, "tiene_texto": true, "extraccion": "titulo", "pendiente": ["plazo", "extraccion_ia"], "citas": [{"boletin": "Boletín Oficial de la Provincia de Soria Lunes", "numero": null, "fecha": "2023-10-30"}], "total_plazas": 1, "plazas": [{"numero": 1, "denominacion": "INFORMADOR TURÍSTICO en régimen de personal laboral fijo discontinuo", "puesto_clave": "informador-turistico-regimen-personal-laboral-fijo-discontinuo", "puesto": "informador turistico en regimen de personal laboral fijo discontinuo", "especialidad": null, "grupo": null, "grupo_fuente": null, "turno": null}], "cita_plazas": "4220 BOPSO-124-30102023 Boletín Oficial de la Provincia de Soria Lunes, 30 de octubre de 2023 GARRAY Por acuerdo del Pleno de fecha 16 de diciembre de 2022, se aprobaron las bases y la convocatoria para la selección de UNA PLAZA DE INFORMADOR TURÍSTICO en régimen de personal laboral fijo discontinuo por el sistema de concurso de valoración de méritos dentro del proceso de estabilización de empleo temporal aprobado por la Ley 20/2021, de 28 de diciembre, de medidas urgentes para la reducción de la temporalidad en el empleo público."}
