<script type="text/javascript">
	// <![CDATA[ 
	function cambiaMesAnt(){
		$('fechaNueva').setValue($('idBean').fechaMesAnterior.value);		
		$('idBean').action="/docm/cambioFecha.do";
		$('idBean').submit();
	}
	
	function cambiaMesSig(){
		$('fechaNueva').setValue($('idBean').fechaMesSiguiente.value);	
		$('idBean').action="/docm/cambioFecha.do";
		$('idBean').submit ();
	}
	
	function cambiaAnioAnt(){
		$('fechaNueva').setValue($('idBean').anioAnterior.value);		
		$('idBean').action="/docm/cambioFecha.do";
		$('idBean').submit ();
	}
	
	function cambiaAnioSig(){
		$('idBean').fechaNueva.value = $('idBean').anioSiguiente.value;	
		$('idBean').action="/docm/cambioFecha.do";
		$('idBean').submit ();
	}
	
	function cambiaMesCombo(){
		fecha = $('idBean').fechaNueva.value;
		mesCombo = $('idBean').mes.value;
		if(mesCombo<10){
			mesCombo = "0"+mesCombo;
		}
		arrFecha = fecha.split("/");
		fecha = arrFecha[0] + "/" + mesCombo + "/" + arrFecha[2];
		$('idBean').fechaNueva.value=fecha;
		$('idBean').action="/docm/cambioFecha.do?cambioMes=si";
		$('idBean').submit();
	}
	
	function cambiaAnioInput(){
		anio = $('idBean').anioInput.value;
		
		if (anio.length != 4) {
			alert($('idBean').msjNumAnio.value);
			return false;
		}
		
		var string="1234567890";
		
		for(i=0;i<4;i++){
			if (string.indexOf(anio.charAt(i))==-1){
				alert($('idBean').msjNumAnio.value);
				return false;
			}
		}
		
		fecha = $('idBean').fechaNueva.value;
		arrFecha = fecha.split("/");
		fecha = arrFecha[0] + "/" + arrFecha[1] + "/" + anio;
		
		$('idBean').fechaNueva.value=fecha;
		$('idBean').action="/docm/cambioFecha.do";
		$('idBean').submit();
		
		return true;
	}
	
	function tecla(e){
		if(window.event) {
			keyCode = window.event.keyCode;
		}
		else if(e) {
			keyCode = e.which;
		}
		
		if(keyCode == 13) {
			cambiaAnioInput();
		}
	}
	
	// ]]> 

</script>
	
