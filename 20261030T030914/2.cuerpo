function cargaComboAnioHist() {
        $.ajax({
        url: '/bop/services/boletineshistoricos/comboHistYear',
        method: 'GET',
        dataType: 'json',
        timeout: 0, // sin tiempo de espera
        success: function (resultado, textStatus, jqXHR) {
            // Llamar al servicio y Cargar EVENTOS.
            var anio = obtenerValorParametro("anio");
            if (resultado !== null && resultado.data !== null && resultado.data.length > 0) {
                select = document.getElementById('calendarioHist');
                for (x in resultado.data) {
                    var option = document.createElement('option'),
                    yearText = document.createTextNode(resultado.data[x]);
                    if (anio == yearText.data) {
                        option.selected = true;
                    }
                    option.appendChild(yearText);
                    select.appendChild(option);
                }
            }
        },
        error: function (jqXHR, textStatus, errorThrown) {
            console.log("Error: cargaComboAnioHist() -> services/boletineshistoricos/comboBolHistYear", textStatus);
        }
    });
}

function cargaComboAnio() {
        $.ajax({
        url: '/bop/services/boletines/comboYear',
        method: 'GET',
        dataType: 'json',
        timeout: 0, // sin tiempo de espera
        success: function (resultado, textStatus, jqXHR) {
            // Llamar al servicio y Cargar EVENTOS.
            if (resultado !== null && resultado.data !== null && resultado.data.length > 0) {
                select = document.getElementById('calendarioAnual');
                var option = document.createElement('option'),
                yearText = document.createTextNode("Seleccione un año");
                option.appendChild(yearText);
                select.appendChild(option);
                for (x in resultado.data) {
                    option = document.createElement('option'),
                    yearText = document.createTextNode(resultado.data[x]);
                    option.appendChild(yearText);
                    select.appendChild(option);
                }
            }
        },
        error: function (jqXHR, textStatus, errorThrown) {
            console.log("Error: cargaComboAnio() -> services/boletines/comboAnio", textStatus);
        }
    });
}

