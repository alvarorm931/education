<script type="text/javascript" src="/export/system/modules/com.saga.grid/resources/js/grid.js"></script><div id="modalLogout" class="modal">
        <div class="contenido_modal">
            <div class="mensajeInfo">
                Para cerrar la sesión activa con certificado correctamente deberá cerrar el navegador</div>
        </div>
        <div class="acciones_modal centradas cerrar_sesion">
            <a href="/login-?accion=logoff" class="boton_generico positivo">
                Aceptar</a>
            <a class="boton_generico" rel="modal:close">
                Cerrar</a>
        </div>
    </div>

    <script>
        function applySelect2(element) {
            $(element).not('.select2-hidden-accessible').select2();
        }

        
        $(document).ready(function () {
            // Inicializar Select2 en todos los selects presentes
            applySelect2('select');

            $(document).on('DOMNodeInserted', function (e) {
                if ($(e.target).is('select')) {
                    applySelect2(e.target);
                } else {
                    $(e.target).find('select').each(function () {
                        applySelect2(this);
                    });
                }
            });
        });
    </script>
    </body>
    </html>
