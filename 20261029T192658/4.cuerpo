  'BormApp.BuzonInformanteModule']).constant("Constantes", {
  "PAGE_SIZE": 7, "FORMAT_DATE": "dd/MM/yyyy", "TIMEOUT_ALERTS": 20000,
}).config(['$stateProvider', '$urlRouterProvider', '$ocLazyLoadProvider',
  '$httpProvider', '$translateProvider', 'tmhDynamicLocaleProvider',
  function ($stateProvider, $urlRouterProvider, $ocLazyLoadProvider,
      $httpProvider, $translateProvider, tmhDynamicLocaleProvider) {

    // Todas las peticiones y respuestas se tratan a través de un objeto XMLHttpRequest,
    // en JavaScript, sin que intervenga el navegador
    $httpProvider.defaults.headers.common["X-Requested-With"] = 'XMLHttpRequest';

    // Se añade un interceptor para controlar las respuestas HTTP erróneas
    // Configuración necesaria para controlar cuando nos devuelven un recurso en 401
    $httpProvider.interceptors.push('HttpResponseErrorHandler');

    $ocLazyLoadProvider.config({
      debug: false, events: true,
    });

    // Configuracion para i18n
    $translateProvider.preferredLanguage('es');

    // IMPORTANTE: Evita vulnerabilidad XSS en el aplicativo
    $translateProvider.useSanitizeValueStrategy('sanitizeParameters');
    translateBundle_es.messages_translate_es($translateProvider); //Bundle para Castellano
    translateBundle_en.messages_translate_en($translateProvider); //Bundle para Ingles
    tmhDynamicLocaleProvider.localeLocationPattern(
        'bower_components/angular-i18n/angular-locale_{{ locale }}.js');

    //Mapa de navegación del aplicativo
    $stateProvider
    .state('home', {
      templateUrl: 'views/home.html',
      url: '/home',
      controller: 'homeController',
      resolve: {
        loadMyFiles: function ($ocLazyLoad) {
          return $ocLazyLoad.load({
            name: 'BormApp.HomeModule',
            files: ['scripts/homeBorm/controllers/homeController.js',
              'scripts/boletines/factories/boletinFactory.js',
              'scripts/noticias/factories/noticiasFactory.js']
          })
        }
      }
    })
    .state('home.boletines', {
      url: '/boletines', views: {
        "content": {
          templateUrl: 'views/boletines/boletines.html',
          controller: 'boletinController',
          resolve: {
            loadMyFiles: function ($ocLazyLoad) {
              return $ocLazyLoad.load({
                name: 'BormApp.BoletinesModule',
                files: ['scripts/boletines/controllers/boletinController.js',
                  'scripts/boletines/factories/boletinFactory.js']
              })
            }
          }
        }, "footer": {
          templateUrl: 'views/footerInterior.html'
        }
      }
    })
    .state('home.suplementos', {
      url: '/suplementos', views: {
        "content": {
          templateUrl: 'views/suplementos/suplementos.html',
          controller: 'suplementoController',
          resolve: {
            loadMyFiles: function ($ocLazyLoad) {
