<script type="text/javascript">var searchForm = document.forms["search-form"];function submitSearchForm() {searchForm.submit();document.getElementById("dialogCarga").showModal();}</script><script type ="text/javascript">
	
		function buscar() {
			var textobusqueda = "";
			
			// TIPO
			if (textobusqueda.length > 0) {
				textobusqueda = textobusqueda + "-----";
			}
			var tipos = document.getElementById("busqTipos");
			var tipoValor = tipos.value;
			if (tipoValor === 'Seleccione el tipo') {
				textobusqueda = textobusqueda + "TIPOS";
			} else {
				textobusqueda = textobusqueda + tipoValor;
			}

			// AÑO
			if (textobusqueda.length > 0) {
				textobusqueda = textobusqueda + "-----";
			}
			var anios = document.getElementById("busqAnios");
			var anioValor = anios.value;
			if (anioValor === 'Seleccione un año') {
				textobusqueda = textobusqueda + "ANIOS";
			} else {
				textobusqueda = textobusqueda + anioValor;
			}

			// PROCEDENCIA
			if (textobusqueda.length > 0) {
				textobusqueda = textobusqueda + "-----";
			}
			var procedencias = document.getElementById("busqProcedencias");
			var procedenciaValor = procedencias.value;
			if (procedenciaValor === 'Seleccione una procedencia') {
				textobusqueda = textobusqueda + "PROCEDENCIAS";
			} else {
				textobusqueda = textobusqueda + procedenciaValor;
			}

			// NÚMERO DE BOLETÍN
			if (textobusqueda.length > 0) {
				textobusqueda = textobusqueda + "-----";
			}
			var numBoletin = document.getElementById("busqNumBoletin");
			var numBoletinValor = numBoletin.value;
			if (numBoletinValor === '') {
				textobusqueda = textobusqueda + "NUMBOLETIN";
			} else {
				textobusqueda = textobusqueda + numBoletinValor;
			}

			// CALENDARIO
			if (textobusqueda.length > 0) {
				textobusqueda = textobusqueda + "-----";
			}
			var calendario = document.getElementById("busqCalendario");
			var calendarioValor = calendario.value;
			if (calendarioValor === '' || calendarioValor === 'dd/mm/aaaa') { //  || calendarioValor === fechaFormateada(new Date(), false)
				textobusqueda = textobusqueda + "CALENDARIO";
			} else {
				// Si el input es de tipo "date"
				var fechaSplit = calendarioValor.split("-");
				textobusqueda = textobusqueda + fechaSplit[2] + "/" + fechaSplit[1] + "/" + fechaSplit[0];
				// Si el input es de tipo "text"
				//textobusqueda = textobusqueda + calendarioValor;
				textobusqueda = textobusqueda.replace(anioValor, "ANIOS") // Si se establece una fecha en el calendario se "anula" el año
			}
			
			// ORGANISMO
			if (textobusqueda.length > 0) {
				textobusqueda = textobusqueda + "-----";
			}
			var organismo = document.getElementById("busqOrganismo");
			var organismoValor = organismo.value;
			if (organismoValor === '') {
				textobusqueda = textobusqueda + "ORGANISMO";
			} else {
				textobusqueda = textobusqueda + organismoValor;
			}
			
			document.getElementById("filtros").value = textobusqueda;
			
			submitSearchForm();
		}
		
		function buscarCalendario(calendarioValor) {
			var textobusqueda = "";
			
			// TIPO
			if (textobusqueda.length > 0) {
				textobusqueda = textobusqueda + "-----";
			}
			textobusqueda = textobusqueda + "TIPOS";

			// AÑO
			if (textobusqueda.length > 0) {
				textobusqueda = textobusqueda + "-----";
			}
			textobusqueda = textobusqueda + "ANIOS";

			// PROCEDENCIA
			if (textobusqueda.length > 0) {
				textobusqueda = textobusqueda + "-----";
			}
			textobusqueda = textobusqueda + "PROCEDENCIAS";

			// NÚMERO DE BOLETÍN
			if (textobusqueda.length > 0) {
				textobusqueda = textobusqueda + "-----";
			}
			textobusqueda = textobusqueda + "NUMBOLETIN";		

			// CALENDARIO
			if (textobusqueda.length > 0) {
				textobusqueda = textobusqueda + "-----";
			}
			textobusqueda = textobusqueda + calendarioValor;
			
			// ORGANISMO
			if (textobusqueda.length > 0) {
				textobusqueda = textobusqueda + "-----";
			}
			textobusqueda = textobusqueda + "ORGANISMO";
			
			document.getElementById("filtros").value = textobusqueda;
			
			submitSearchForm();
		}
		
		function limpiarFiltros() {
			document.getElementById("busqTipos").value = 'Seleccione el tipo';
			document.getElementById("busqAnios").value = 'Seleccione un año';
			document.getElementById("busqProcedencias").value = 'Seleccione una procedencia';
			document.getElementById("busqNumBoletin").value = "";
			//document.getElementById('busqCalendario').valueAsDate = new Date();
			//document.getElementById('busqCalendario').value = 'dd/mm/aaaa';
			document.getElementById('busqCalendario').value = "";
			document.getElementById("busqOrganismo").value = "";
			document.getElementById("busqTexto").value = "";			
			document.getElementById("filtros").value = "";
		}
		
		function fechaFormateada(fecha, text) {
			
			var dd = fecha.getDate();
			var mm = fecha.getMonth() + 1; //Enero es el 0!
			var yyyy = fecha.getFullYear();

			if (dd < 10) {
				dd = '0' + dd;
			}

			if (mm < 10) {
				mm = '0' + mm;
			}			

			if (!text) {
				// Si el input es de tipo "date"
				fecha = yyyy + '-' + mm + '-' + dd;
			} else {
				// Si el input es de tipo "text"
				fecha = dd + '/' + mm + '/' + yyyy;
			}
			
			return fecha;
		}
		
		document.addEventListener('DOMContentLoaded', function() {
			const urlParams = new URL(document.URL).searchParams;
			const lq = urlParams.get('lq');
			
			var mostrarResultados = false;
		
			if (null != lq && lq.length > 0) {
				var filtros = lq.split('-----');
				var filtroTipo = filtros[0];
				var filtroAnio = filtros[1];
				var filtroProcedencia = filtros[2];
				var filtroNumBoletin = filtros[3];
				var filtroCalendario = filtros[4];
				var filtroOrganismo = filtros[5];

				if (filtroTipo != 'TIPOS') {
					document.getElementById("busqTipos").value = filtroTipo;
					mostrarResultados = true;
				}
				if (filtroAnio != 'ANIOS') {
					document.getElementById("busqAnios").value = filtroAnio;
					mostrarResultados = true;
				}
				if (filtroProcedencia != 'PROCEDENCIAS') {
					document.getElementById("busqProcedencias").value = filtroProcedencia;
					mostrarResultados = true;
				}
				if (filtroNumBoletin != 'NUMBOLETIN') {
					document.getElementById("busqNumBoletin").value = filtroNumBoletin;
					mostrarResultados = true;
				}
				if (filtroCalendario != 'CALENDARIO') {
					// Si el input es de tipo "date"
					var fechaSplit = filtroCalendario.split("/");
					filtroCalendario = fechaSplit[2] + "-" + fechaSplit[1] + "-" + fechaSplit[0];
					
					document.getElementById("busqCalendario").value = filtroCalendario;
					mostrarResultados = true;
				}
				if (filtroOrganismo != 'ORGANISMO') {
					document.getElementById("busqOrganismo").value = filtroOrganismo;
					mostrarResultados = true;
				}
			}
			
			const q = urlParams.get('q');
			if (null != q && q.length > 0) {
				mostrarResultados = true;
			}
			
			if (mostrarResultados) {
				var contador = document.getElementsByClassName("search-result").length;
				if(contador > 0) {
					document.getElementById("search-results-count").innerHTML = "Resultados: " + contador;
				} else {
					document.getElementById("search-results-count").innerHTML = "No hay resultados";
				}
			}
			
			const form = document.getElementById('search-form');
			form.addEventListener('keypress', function(e) {
				if (e.keyCode === 13) {
					e.preventDefault();
				}
			});
			
			const dialogCarga = document.getElementById("dialogCarga");
			dialogCarga.close();
			
		}, false);
		
	</script>
	
