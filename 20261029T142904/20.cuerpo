			             <div class="col-md-8 col-md-offset-2">
			                 <h1 class="titol-component">Cerca la normativa a tots els àmbits
			                 <button class="btn btn-info-popover" type="button"><span class="infoTooltip" title='Manual del cercador del Portal Jurídic de Catalunya'></span></button></h1>
			                 <p class="subtitol">Dret de Catalunya i una selecció de dret estatal, dret de la Unió Europea i internacional</p>
			                 <div class="cercador-capcalera-juridic">     
			                   <label for="value" class="form-label sr-only">Cercador jurídic</label>
			                   <input id="value" type="text" name="Establiu el contigut de la cerca" placeholder="Mínim 2 i màxim 120 caràcters"
			                   		  aria-label="Establiu el contigut de la cerca" class="cercador-juridic" title="Empleneu aquest camp"/>
			                   <button id="searchButton" value="Aplica filtres" title="Cerca"
					           		  aria-label="Aplica filtres" class="btn btn-default"></button>
									  <div id="errorNormative"><span class="errorNormative"></span></div>
			                 </div>
			                 <div class="filtres-capcalera-juridic">
			                   <fieldset>
			                     <legend class="sr-only">Aplica filtres</legend>
			                     <div class="wrapper-filtres-capcalera-juridic">
			                       <div class="filtre-capcalera-juridic">
			                         <input id="title" type="checkbox" name="title" checked="checked"/>
				                     <label for="title">Només al títol</label>
			                       </div>
			                       <div class="filtre-capcalera-juridic">
			                         <input id="current" type="checkbox" name="current" checked="checked"/>
				                     <label for="current">Només vigents</label>
			                       </div>
			                     </div>
			                     <!-- inici +opcions  -->
				                 <div class="mes-opcions">
				                   <button type="button" data-toggle="collapse" data-target="#collapseMoreOptions"
				                   			data-label="Menys opcions" 
				                  			aria-expanded="false" class="btn btn-enllac js-swap-txt collapsed">
				                  			<span>Més opcions</span>
				                   </button>
				                   <div id="collapseMoreOptions" class="collapseMesOpcions collapse">
				                  	 <fieldset>
	                           			<legend class="sr-only">Més opcions de cerca</legend>
	                         		 </fieldset>
	                         		 <div class="form-group">
				                       <label class="form-label">Àmbit</label>
				                       <div id="scope"></div>
				                     </div>
				                     <div id="form-group-range" class="form-group">
				                       <label for="range" class="form-label">Tipus de document</label>
				                       <select title="Tipus de document" id="range" class="custom_select">
				                         <option value=""></option>
				                       </select>
				                     </div>
				                     <div class="form-group">
				                       <div class="row">
				                         <div class="col-xs-12"><span class="form-label">Data de publicació</span></div>
				                         <div class="col-xs-12 col-sm-6">
