		const fecha = new Date();
		function hoy() {
			const dateLocale = fecha.toLocaleDateString();// fecha con formato local => dd/mm/yyyy
			return dateLocale;
		}

		const elem = document.getElementById('picker');
		const datepicker = new Datepicker(elem, {
			language: 'es',
			prevArrow: '❮',
			nextArrow: '❯',
			disableTouchKeyboard: 'true',
			minDate: "01/01/2004",
			//maxDate: fechaActualCalendario(),
			//daysOfWeekHighlighted:[1,3,5]
		});
		
		const picker = document.getElementById('picker');
		picker.addEventListener('changeDate', function(e) {
			
			//console.log('select', e.detail.date);
			var fechaSeleccionada = fechaFormateada(e.detail.date, false);
			document.getElementById("busqCalendario").value = fechaSeleccionada;
			//console.log(fechaSeleccionada);

			var calendarioValor = fechaFormateada(e.detail.date, true);			
			buscarCalendario(calendarioValor)
		});
		
		function dobleDigito(texto) {
			if (texto.length === 1) {
				texto = "0" + texto;
			}
			return texto;
		}
	
	</script>
	
    
