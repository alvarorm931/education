function repintarUnCalendario(anio, mes) {
// var anio = fecha.getFullYear();
//var mes = fecha.getMonth() + 1;
    var eventos = {};
    // Solicitar Boletines del mes/año para Rellenar eventos.
    $.ajax({
        url: '/bop/services/boletines/bopMesAntSig',
        method: 'GET',
        dataType: 'json',
        data: {"mes":mes, "anio":anio},
        timeout: 0, // sin tiempo de espera
        success: function (resultado, textStatus, jqXHR) {

            // Cargar EVENTOS via servicio.
            if (resultado !== null && resultado.data !== null && resultado.data.length > 0) {
                for (x in resultado.data) {
//                  var clave = anio + "-" + mes + "-" + resultado.data[x].diaBop;
                    var clave = anio + "-";
                    if (mes < 10)
                        clave = clave + "0";
                    clave = clave + mes + "-";
                    if (resultado.data[x].diaBop < 10)
                        clave = clave + "0";
                    clave = clave + resultado.data[x].diaBop;
                    // Añadir llamada a servicio en cada evento del calendario.
                    eventos[clave] = {"url": "sumario.html?busqueda=numBop" + "&id=" + resultado.data[x].idBoletin};
                }
            }

            $(".responsive-calendar").responsiveCalendar('edit', eventos);
        },
        error: function (jqXHR, textStatus, errorThrown) {
            console.log("Error: repintarUnCalendario() -> /services/boletines/bopMes", textStatus);
        }
    });
    $(function () {
        $('#fechaEntrada').datetimepicker({
            locale: 'es',
            format: 'DD/MM/YYYY'
        });
    });
    $(function () {
        $('#fechaPrevista').datetimepicker({
            locale: 'es',
            format: 'DD/MM/YYYY'
        });
    });
    $(function () {
        $('#idBOPDia').datetimepicker({
            locale: 'es',
            format: 'DD/MM/YYYY'
        });
    });
    $(function () {
        $('#idBOP').datetimepicker({
            locale: 'es',
            format: 'DD/MM/YYYY'
        });
    });
}
function mostrarAnunciosAnunciantes(dataAnunciosAnunciantes, grande) {
// Función que recoge un JSON con la lista de los anuncios, 
// los estructura y los añade a la web.

// ESTRUCTURAS Utilizadas:
//     
//     dicTipos[idTipoEntidad]    >> Sección; Adm.Local, Adm.Autonómica ...
//     dicGrupos[idGrupoEntidad]  >> SubSección: Provincias, Aytos ...
//     dicEntidades[idEntidad]    >> SubsubSec: DipProv.CC, Ayto de Cachorrilla ...
//     dicAnuncios[id]            >> DATOS del Anuncio.

// ÁRBOL que crearemos:
//     
//     dicTipos = {
//        nombreTipo:"",
//        dicGrupos : {
//            nombreGrupo:"",
//            dicEntidades:{
//                nombreEntidad:"",
//                dicAnuncios:{
//                    id,titulo,linkHtml,linkPdf,pos
//                }
//            }
//        }
//    }

// ESTRUCTURA del HTML final.
//
//<div class="sumario">
//    <section>             // N0
//        <h1>              // tipo
//        <section>         // N1
//            <h2>          // grupo
//            <section>     // N2
//                <h3>      // Entidad
//                <ul>
//                    <li>
//                        <a href="#" class="tituloAnuncio" title="Enlace a anuncio versión HTML"> tituloAnuncio </a>
//                        <a href="#" class="iconoAnuncio"><img src="imagenes/puntoPDF.gif" class="img-responsive" alt="Icono PDF firmado" title="Descargar anuncio original firmado"></a>
//                    </li>
//                </ul>
//            </section> 
//        </section>
//    </section>
//</div>

// <!> POR HACER:
//  - Añadir <section> de los niveles N1 & N2.

// Preparación de la respuesta JSON de la consulta:
// Recorre (dataAnunciosAnunciantes) y va añadiendo los anuncios en una estructura de árbol.

    // Árbol raíz con los anuncios.
    var dicTipos = {};

    // Anuncios destacados de la diputación.
    var hayDiputacion = false;
    var dicAnunciosDiputacion = {};

    // Referencia a la tupla(anuncio) actual.
    var tupla;

    // Lista con los Ids.
    var lista;

    var pos = 0;
    // Recorrer el JSON:
    var tam = dataAnunciosAnunciantes.length;

    for (x in dataAnunciosAnunciantes) {
// Actualizar referencia a tupla actual.
        tupla = dataAnunciosAnunciantes[x];
        // Crear los datos del Anuncio.
        pos = pos + 1;
        if (pos == tam) {
            pos = -1;
        }
        var anuncio = {
            id: tupla.idAnuncio,
            csv: tupla.csv,
            titulo: tupla.tituloAnuncio,
            linkHtml: "#html",
            linkPdf: "#pdf",
            posicion: pos
        }
        
        
        //intercambiamos los "pesos" de los id para que Provincia salga antes que Municipios
        if (tupla.idGrupoEntidad== 1)
            tupla.idGrupoEntidad= 2;
        else
            if(tupla.idGrupoEntidad== 2)
               tupla.idGrupoEntidad= 1;
        

            // Si No se encuentra la Seccion (Tipo):
            if (dicTipos[tupla.idTipoEntidad] == null) {
                // Creamos el nuevo diccionario de Grupos(SubSec).
                var tmpDicGrupos = {};
                // Añadimos el campo para el Título del tipo.
                tmpDicGrupos["nombreTipo"] = tupla.nombreTipoEntidad;
                // Creamos el nuevo diccionario de Entidades.
                var tmpDicEntidades = {};
                // Añadimos el campo para el Título del grupo.
                tmpDicEntidades["nombreGrupo"] = tupla.nombreGrupoEntidad;
                // Creamos el nuevo diccionario de Anuncios.
                var tmpDicAnuncios = {};
                // Añadimos el campo para el Título de la entidad.
                tmpDicAnuncios["nombreEntidad"] = tupla.nombreEntidad;
                // Cargamos los datos del anuncio.
                tmpDicAnuncios[tupla.idAnuncio] = anuncio;
                // Añadimos Anuncio a Entidades.
                tmpDicEntidades[tupla.idEntidad] = tmpDicAnuncios;
                // Añadimos Entidad a Grupo.
                tmpDicGrupos[tupla.idGrupoEntidad] = tmpDicEntidades;
                // Añadimos Grupo a Tipos.
                dicTipos[tupla.idTipoEntidad] = tmpDicGrupos;
            } // Si No se encuentra la Subseccion (Grupo):
            else if (dicTipos[tupla.idTipoEntidad][tupla.idGrupoEntidad] == null) {
                // Tratamiento de las Entidades.
                var tmpDicEntidades = {};
                tmpDicEntidades["nombreGrupo"] = tupla.nombreGrupoEntidad;
                // Tratamiento de los Anuncios.
                var tmpDicAnuncios = {};
                tmpDicAnuncios["nombreEntidad"] = tupla.nombreEntidad;
                // Añadimos al Árbol (dicTipos)
                tmpDicAnuncios[tupla.idAnuncio] = anuncio;
                tmpDicEntidades[tupla.idEntidad] = tmpDicAnuncios;
                dicTipos[tupla.idTipoEntidad][tupla.idGrupoEntidad] = tmpDicEntidades;
            } // Si No se encuentra la Entidad:
            else if (dicTipos[tupla.idTipoEntidad][tupla.idGrupoEntidad][tupla.idEntidad] == null) {
                // Tratamiento de los Anuncios.
                var tmpDicAnuncios = {};
                tmpDicAnuncios["nombreEntidad"] = tupla.nombreEntidad;
                // Añadimos al Árbol (dicTipos)
                tmpDicAnuncios[tupla.idAnuncio] = anuncio;
                dicTipos[tupla.idTipoEntidad][tupla.idGrupoEntidad][tupla.idEntidad] = tmpDicAnuncios;
            } // Si Solo falta el anuncio.
            else {
                dicTipos[tupla.idTipoEntidad][tupla.idGrupoEntidad][tupla.idEntidad][tupla.idAnuncio] = anuncio;
            }
        
    }
// guardar extructura.
    localStorage.setItem("listaAnuncios", JSON.stringify(dicTipos));
// Presentación de los Anuncios:
// Recorre el árbol y va añadiendo sus elementos al Html.

// Titulos de las Secciones.
    var txTipo, txGrupo, txEntidad;
    // Variable que sigue el punto de insercción en el Html.
    var insercion;
    // Lo apuntamos al div Sumario. (Contenedor padre de los anuncios).
    insercion = document.getElementsByClassName("sumario")[0];
    // Vaciamos el sumario de los posibles datos anteriores.
    insercion.innerHTML = "";
    // Pintar los Anuncios de la diputación de cáceres.
    // Recorremos el Árbol de anuncios.
    for (var tipo in dicTipos) {
// Crear la Seccion del Tipo Nivel 0.
//        var seccion = document.createElement("section");
        var preInsert = insercion;
//        insercion = insercion.appendChild(seccion);
        // Asignar el título <h1> de Tipo.
        txTipo = dicTipos[tipo]["nombreTipo"];
        var cabecera = document.createElement("h1");
        var text = document.createTextNode(txTipo);
        cabecera.appendChild(text);
        insercion.appendChild(cabecera);
        if (txTipo == "Sección I - Administración Local") {
      
        }
        for (var grupo in dicTipos[tipo]) {
// Obviamos el elemento del título.
            if (grupo == "nombreTipo")
                continue;
            // Asignar el título <h2> del Grupo.
            txGrupo = dicTipos[tipo][grupo]["nombreGrupo"];
            var cabecera = document.createElement("h2");
            var text = document.createTextNode(txGrupo);
            
            cabecera.appendChild(text);
            insercion.appendChild(cabecera);
            for (var entidad in dicTipos[tipo][grupo]) {
                // Obviamos el elemento del título.
                if (entidad == "nombreGrupo")
                    continue;
                // Título de Entidad.
                txEntidad = dicTipos[tipo][grupo][entidad]["nombreEntidad"];
                var cabecera = document.createElement("h3");
                var text = document.createTextNode(txEntidad);
                cabecera.appendChild(text);
                insercion.appendChild(cabecera);
                // Creamos la Lista <ul>.
                var lista = document.createElement("ul");
                for (var anuncio in dicTipos[tipo][grupo][entidad]) {
                    // Obviamos el elemento del título.
                    if (anuncio == "nombreEntidad")
                        continue;
                    // Crear Anuncio:
                    // Creamos el Elemento <li>, con el contenido del anuncio.
                    var elemento = document.createElement("li");
                    // Link al html del anuncio.
                    var enlace = document.createElement("a");
                    var text = document.createTextNode(dicTipos[tipo][grupo][entidad][anuncio]["titulo"]);
                    enlace.setAttribute("href", "anuncio.html?csv=" + dicTipos[tipo][grupo][entidad][anuncio].csv);
                    enlace.setAttribute("class", "tituloAnuncio");
                    enlace.setAttribute("title", "Enlace a anuncio versión HTML.");
                    enlace.appendChild(text);
                    elemento.appendChild(enlace);
                    // Link al Pdf del anuncio.
                    enlace = document.createElement("a");
                    enlace.setAttribute("class", "iconoAnuncio");
                    enlace.setAttribute("href", "/bop/services/anuncios/contenidoPdfIdAnuncio?csv=" + dicTipos[tipo][grupo][entidad][anuncio].csv);
                    imagenPDf = document.createElement("img");
                    if(grande == undefined)
                        imagenPDf.setAttribute("src", "imagenes/puntoPDF.gif");
                    else
                        imagenPDf.setAttribute("src", "imagenes/puntoPDFbig.png");
                    imagenPDf.setAttribute("class", "img-responsive");
                    imagenPDf.setAttribute("alt", "Icono Pdf firmado.");
                    imagenPDf.setAttribute("title", "Enlace a anuncio versión PDF.");
                    enlace.appendChild(imagenPDf);
                    elemento.appendChild(enlace);
                    // Añadimos el <li>
                    lista.appendChild(elemento);
                }
                // Añadimos a la lista <ul>
                insercion.appendChild(lista);
            }
        }
        insercion = preInsert;
    }
}

function mostrarAnunciosAnunciantesPorFecha(dataAnunciosAnunciantes) {
// Función que recoge un JSON con la lista de los anuncios, 
// los estructura y los añade a la web.

// ESTRUCTURAS Utilizadas:
//      
//     dicFechas[fechaAnuncio]
//     dicTipos[idTipoentidad]    >> Sección; Adm.Local, Adm.Autonómica ...
//     dicGrupos[idGrupoEntidad]  >> SubSección: Provincias, Aytos ...
//     dicEntidades[idEntidad]    >> SubsubSec: DipProv.CC, Ayto de Cachorrilla ...
//     dicAnuncios[id]            >> DATOS del Anuncio.
//     anuncio

// ÁRBOL que crearemos:
//    dicFechas = {
//        nombreFecha : "",
//        dicTipos = {
//            nombreTipo: "",
//            dicGrupos: {
//                nombreGrupo: "",
//                dicEntidades: {
//                    nombreEntidad: "",
//                    dicAnuncios: {
//                       anuncio: { id, titulo, linkHtml, linkPdf }
//                    }
//                }
//            }
//        }
//    }


// Árbol raíz con los anuncios por fecha.
    var dicFechas = {};
    // Referencia a la tupla(anuncio) actual.
    var tupla;
    // Mostrar la salida del servicio.

    // Recorrer el JSON:
    for (x in dataAnunciosAnunciantes) {
// Actualizar referencia a tupla actual.
        tupla = dataAnunciosAnunciantes[x];
        // Crear los datos del Anuncio.
        var anuncio = {
            id: tupla.idAnuncio,
            csv: tupla.csv,
            titulo: tupla.tituloAnuncio,
            linkHtml: "#html",
            linkPdf: "#pdf"
        }

// Establecemos un formato Natural para Mostrar la fecha.
        var monthNames = ["Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio",
                    "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"];
        var date = new Date(tupla.fechaPublicacion);
        var y = date.getYear() + 1900;
        var m = date.getMonth() + 1;
        var d = date.getDate();
        var mn = monthNames[date.getMonth()];
        var fechaTexto = d + " de " + mn + " de " + y;
        // Crear la estructura: Fecha/Tipo/Grupo/Entidad/Anuncio.

        // Si No se encuentra la entrada de la Fecha..
        // ..creamos todos.
        if (dicFechas[tupla.fechaPublicacion] == null) {
// Creamos el diccionario de Tipos.
            var tmpDicTipos = {};
            // Añadimos el campo para el Título de Fecha.
            tmpDicTipos["nombreFecha"] = fechaTexto;
            // Creamos diccionario de Grupos.
            var tmpDicGrupos = {};
            // Añadimos el campo para el Título del tipo.
            tmpDicGrupos["nombreTipo"] = tupla.nombreTipoEntidad;
            // Creamos el nuevo diccionario de Entidades.
            var tmpDicEntidades = {};
            // Añadimos el campo para el Título del grupo.
            tmpDicEntidades["nombreGrupo"] = tupla.nombreGrupoEntidad;
            // Creamos el nuevo diccionario de Anuncios.
            var tmpDicAnuncios = {};
            // Añadimos el campo para el Título de la entidad.
            tmpDicAnuncios["nombreEntidad"] = tupla.nombreEntidad;
            // Añadimos al Árbol:
            // Cargamos los datos del anuncio.
            tmpDicAnuncios[tupla.idAnuncio] = anuncio;
            // Añadimos Anuncio a Entidades.
            tmpDicEntidades[tupla.idEntidad] = tmpDicAnuncios;
            // Añadimos Entidad a Grupo.
            tmpDicGrupos[tupla.idGrupoEntidad] = tmpDicEntidades;
            // Añadimos Grupo a Tipos.
            tmpDicTipos[tupla.idTipoEntidad] = tmpDicGrupos;
            // Añadimos Tipos a Fechas.
            dicFechas[tupla.fechaPublicacion] = tmpDicTipos;
            // Si no se encuentra el Tipo:
        } else if (dicFechas[tupla.fechaPublicacion][tupla.idTipoEntidad] == null) {
            var tmpDicGrupos = {};
            // Añadimos el campo para el Título del tipo.
            tmpDicGrupos["nombreTipo"] = tupla.nombreTipoEntidad;
            // Creamos el nuevo diccionario de Entidades.
            var tmpDicEntidades = {};
            // Añadimos el campo para el Título del grupo.
            tmpDicEntidades["nombreGrupo"] = tupla.nombreGrupoEntidad;
            // Creamos el nuevo diccionario de Anuncios.
            var tmpDicAnuncios = {};
            // Añadimos el campo para el Título de la entidad.
            tmpDicAnuncios["nombreEntidad"] = tupla.nombreEntidad;
            // Añadimos al Árbol
            tmpDicAnuncios[tupla.idAnuncio] = anuncio;
            tmpDicEntidades[tupla.idEntidad] = tmpDicAnuncios;
            tmpDicGrupos[tupla.idGrupoEntidad] = tmpDicEntidades;
            // tmpDicTipos[tupla.idTipoEntidad] = tmpDicGrupos;
            dicFechas[tupla.fechaPublicacion][tupla.idTipoEntidad] = tmpDicGrupos; //tmpDicTipos;

            // Si no se encuentra el Grupo:
        } else if (dicFechas[tupla.fechaPublicacion][tupla.idTipoEntidad][tupla.idGrupoEntidad] == null) {
// Tratamiento de las Entidades.
            var tmpDicEntidades = {};
            tmpDicEntidades["nombreGrupo"] = tupla.nombreGrupoEntidad;
            // Tratamiento de los Anuncios.
            var tmpDicAnuncios = {};
            tmpDicAnuncios["nombreEntidad"] = tupla.nombreEntidad;
            // Añadimos al Árbol
            tmpDicAnuncios[tupla.idAnuncio] = anuncio;
            tmpDicEntidades[tupla.idEntidad] = tmpDicAnuncios;
            //tmpDicGrupos[tupla.idGrupoEntidad] = tmpDicEntidades;
            dicFechas[tupla.fechaPublicacion][tupla.idTipoEntidad][tupla.idGrupoEntidad] = tmpDicEntidades; //tmpDicGrupos;

            // Si no se encuetra la Entidad.
        } else if (dicFechas[tupla.fechaPublicacion][tupla.idTipoEntidad][tupla.idGrupoEntidad][tupla.idEntidad] == null) {
// Tratamiento de los Anuncios.
            var tmpDicAnuncios = {};
            tmpDicAnuncios["nombreEntidad"] = tupla.nombreEntidad;
            // Añadimos al Árbol
            tmpDicAnuncios[tupla.idAnuncio] = anuncio;
            dicFechas[tupla.fechaPublicacion][tupla.idTipoEntidad][tupla.idGrupoEntidad][tupla.idEntidad] = tmpDicAnuncios;
            // Solo falta el anuncio.
        } else if (dicFechas[tupla.fechaPublicacion][tupla.idTipoEntidad][tupla.idGrupoEntidad][tupla.idEntidad][tupla.idAnuncio] == null) {
// Añadimos al Árbol
            dicFechas[tupla.fechaPublicacion][tupla.idTipoEntidad][tupla.idGrupoEntidad][tupla.idEntidad][tupla.idAnuncio] = anuncio;
        }

    }
// Presentación de los Anuncios:
// Recorre el árbol y va añadiendo sus elementos al Html.
// Titulos de las Secciones.
    var txFecha, txTipo, txGrupo, txEntidad;
    // Variable que sigue el punto de insercción en el Html.
    var insercion;
    // Lo apuntamos al div Sumario. (Contenedor padre de los anuncios).
    //insercion = document.getElementsByClassName("sumario")[0];
    insercion = document.getElementById("resultados");
    // Vaciamos el sumario de los posibles datos anteriores.
    insercion.innerHTML = "";
    var fechaOrdenada = [];
    for (var f in dicFechas) {
        fechaOrdenada.push(f);
    }
    fechaOrdenada.sort();
    fechaOrdenada.reverse();
    // TODO: ADAPTAR el FOR para usar las fechas ordenadas que acabamos de crear
    // Recorremos el Árbol de anuncios.
    for (var i = 0; i < fechaOrdenada.length; i += 1) {
        var fecha = fechaOrdenada[i];
        //for (var fecha in fechaOrdenada) {
        // Crear la Seccion.
//        var seccion = document.createElement("section");
        var preInsert = insercion;
//        insercion = insercion.appendChild(seccion);
        // Asignar el título <h1> de Fecha.
        txFecha = dicFechas[fecha]["nombreFecha"];
        var cabecera = document.createElement("h1");
        var text = document.createTextNode(txFecha);
        cabecera.appendChild(text);
        insercion.appendChild(cabecera);
        for (var tipo in dicFechas[fecha]) {
// Obviamos el elemento del título.
            if (tipo == "nombreFecha")
                continue;
            // Crear la Seccion.
//            var seccion = document.createElement("section");
            var preInsert = insercion;
//            insercion = insercion.appendChild(seccion);
            // Asignar el título <h1> de Tipo.
            txTipo = dicFechas[fecha][tipo]["nombreTipo"];
            /*Comentamos estas 4 líneas para no mostrar las Secciones*/
//            var cabecera = document.createElement("h1");
//            var text = document.createTextNode(txTipo);
//            cabecera.appendChild(text);
//            insercion.appendChild(cabecera);
            for (var grupo in dicFechas[fecha][tipo]) {
// Obviamos el elemento del título.
                if (grupo == "nombreTipo")
                    continue;
                // Asignar el título <h2> del Grupo.
//                txGrupo = dicFechas[fecha][tipo][grupo]["nombreGrupo"];
//                var cabecera = document.createElement("h2");
//                var text = document.createTextNode(txGrupo);
//                cabecera.appendChild(text);
//                insercion.appendChild(cabecera);
                for (var entidad in dicFechas[fecha][tipo][grupo]) {
// Obviamos el elemento del título.
                    if (entidad == "nombreGrupo")
                        continue;
                    // Título de Entidad.
                    txEntidad = dicFechas[fecha][tipo][grupo][entidad]["nombreEntidad"];
                    var cabecera = document.createElement("h3");
                    var text = document.createTextNode(txEntidad);
                    cabecera.appendChild(text);
                    insercion.appendChild(cabecera);
                    // Creamos la Lista <ul>.
                    var lista = document.createElement("ul");
                    for (var anuncio in dicFechas[fecha][tipo][grupo][entidad]) {
// Obviamos el elemento del título.
                        if (anuncio == "nombreEntidad")
                            continue;
                        // Crear Anuncio:
                        // Creamos el Elemento <li>, con el contenido del anuncio.
                        var elemento = document.createElement("li");
                        // Link al html del anuncio.
                        var enlace = document.createElement("a");
                        var text = document.createTextNode(dicFechas[fecha][tipo][grupo][entidad][anuncio]["titulo"]);
                        enlace.setAttribute("href", "anuncio.html?csv=" + dicFechas[fecha][tipo][grupo][entidad][anuncio].csv + "&sm=" + 1);
                        enlace.setAttribute("class", "tituloAnuncio");
                        enlace.setAttribute("title", "Enlace a anuncio versión HTML.");
                        enlace.appendChild(text);
                        elemento.appendChild(enlace);
                        // Link al Pdf del anuncio.
                        enlace = document.createElement("a");
                        enlace.setAttribute("class", "iconoAnuncio");
                        enlace.setAttribute("href", "/bop/services/anuncios/contenidoPdfIdAnuncio?csv=" + dicFechas[fecha][tipo][grupo][entidad][anuncio].csv);
                        imagenPDf = document.createElement("img");
                        imagenPDf.setAttribute("src", "imagenes/puntoPDF.gif");
                        imagenPDf.setAttribute("class", "img-responsive");
                        imagenPDf.setAttribute("alt", "Icono Pdf firmado.");
                        imagenPDf.setAttribute("title", "Enlace a anuncio versión PDF.");
                        enlace.appendChild(imagenPDf);
                        elemento.appendChild(enlace);
                        // Añadimos el <li>
                        lista.appendChild(elemento);
                    }
// Añadimos a la lista <ul>
                    insercion.appendChild(lista);
                }
            }
            insercion = preInsert;
        }
    }
}

function getUrlWordPressIndex() {
    $.ajax({
        url: '/bop/services/anuncios/urlwordpress',
        method: 'GET',
        dataType: 'json',
        timeout: 0, // sin tiempo de espera
        success: function (resultado, textStatus, jqXHR) {
            if (resultado !== null && resultado.data !== null && resultado.data.length > 0) {
                $('#ruta1').attr('href', resultado.data + 'normativa-reglamento/');
                $('#ruta2').attr('href', resultado.data + 'anunciantes-autorizaciones/');
                $('#ruta3').attr('href', resultado.data + 'el-anuncio/');
                $('#ruta4').attr('href', 'busqueda.html');
                $('#ruta5').attr('href', 'resultados.html');
                $('#ruta6').attr('href', resultado.data + 'normativa-reglamento/');
                $('#ruta7').attr('href', resultado.data + 'anunciantes-autorizaciones/');
                $('#ruta8').attr('href', resultado.data + 'el-anuncio/');
                $('#ruta9').attr('href', 'busqueda.html');
                $('#ruta10').attr('href', 'resultados.html');                
                $("#slidedipcc").load(resultado.data + ' #advps_container5.advps-slide-container');
            }
            
        },
        error: function (jqXHR, textStatus, errorThrown) {
            console.log("Error: getUrlWordPress() -> /services/urlwordpress", textStatus);
        }
    });
}

