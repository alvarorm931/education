                <div class="sgsection-main_container seccion-cve-suscripcion-home escritorio publica gris  anchoCompleto"  data-cssid="sgsection_n1253176">
                <div class="sgsection-main_wrapper">
                <div class="cms_container-section" ><div class="sgrow-main_container doscol-home fila-cve-suscripcion      " id="sgrow_n1259430" data-cssid="sgrow_n1259430" >
        <div class="sgrow-wrapper">


        <div class="sgrow-columna col_xxs-12 col_xs-12 col_sm-12 col_md-6 col_lg-6"  data-cssid="sgrowcolumn_n1424580" data-recursos-tipo="content">

                    <div class="cms_container-row" ><div class="destacado-bop">
                    <div class="contenedor-destacado">
                        <h2>
                            Buscador por CVE</h2>
                    <div class="contenido h2">
                            <p style="text-align: center;">Busca anuncios, boletines y sumarios publicados en el BOP por su código CVE. Introduce el código en el siguiente campo y pulsa buscar.</p></div>
                    </div>
                </div>

            

	
	
		
			<div class="zona_publica cve">
        <div class="buscador_anuncios cve">
            <form class="formulario" action="/publica/resultados-busqueda-de-anuncios-por-cve/" method="post" id="buscador_anuncios_cve">

                <div class="fila cve">
                    <div class="elemento termino col_sm-12 col_lg-12 col_md-12 col_sm-12">
                        <input title="Busca anuncios" type="text" id="cve_es_s" name="cve_es_s" class="termino"
                               value=""
                               placeholder="Introduce el código CVE"
                               onfocus="this.placeholder = 'Introduce el código CVE'"
                               onblur="this.placeholder = 'Introduce el código CVE'"
                        />
                        <input type="hidden" id="queryExtra" name="queryExtra">
                    </div>
                </div>

                <div class="fila boton">
                    <div class="acciones">
                        <input id="buscarPorCve" type="submit" value="Buscar" id="lanzar_formulario"/>
                    </div>
                </div>
            </form>
        </div>
    </div>
    <script>
        const cveRegex = '^BOP-LE-(E-)?\\d{4}-\\d{3}(\\d{3})?$';

        $.validator.addMethod(
            "validaCve",
            function (value, element, regexp) {
                if (value) {
                    let re = new RegExp(regexp);
                    return re.test(value);
                } else {
                    return true
                }
            },
            "<div><p>El CVE debe tener el siguiente formato: <b>BOP-LE-E-YYYY-###XXX</b></p><p>Donde:</p><ul><li><b>BOP-LE</b>: es un valor fijo. Todos los boletines empezarán de la misma forma.</li><li><b>E</b>: indica que se trata de un boletín extraordinario. Es opcional y se puede omitir.</li><li><b>YYYY</b>: año de publicación del BOP.</li><li><b>###</b>: número del BOP de hasta tres dígitos, completando por la izquierda con 0.</li><li><b>XXX</b>: número secuencial del anuncio de tres dígitos, completando por la izquierda con 0. Para boletines y sumarios se puede omitir.</li></ul></div>"
        );

        $('form#buscador_anuncios_cve').validate({
            rules: {
                cve_es_s: {
                    required: true,
                    validaCve: "^BOP-LE-(E-)?\\d{4}-\\d{3}(\\d{3})?$"
                }
            },
            messages: {
                cve_es_s: {
                    required: "Debe indicar un CVE",
                    validaCve: "<div><p>El CVE debe tener el siguiente formato: <b>BOP-LE-E-YYYY-###XXX</b></p><p>Donde:</p><ul><li><b>BOP-LE</b>: es un valor fijo. Todos los boletines empezarán de la misma forma.</li><li><b>E</b>: indica que se trata de un boletín extraordinario. Es opcional y se puede omitir.</li><li><b>YYYY</b>: año de publicación del BOP.</li><li><b>###</b>: número del BOP de hasta tres dígitos, completando por la izquierda con 0.</li><li><b>XXX</b>: número secuencial del anuncio de tres dígitos, completando por la izquierda con 0. Para boletines y sumarios se puede omitir.</li></ul></div>"
                }
            }
        });

        // Convertimos lo que se introduzca en el campo del CVE a mayúsculas porque así lo requiere la validación
        $('#cve_es_s').on('input', function () {
            this.value = this.value.toUpperCase();
        });

        $(document).on('click', '#buscarPorCve', function (e) {
            e.preventDefault();

            if ($('form#buscador_anuncios_cve').validate().checkForm()) {
                // Si se valida el formulario, generamos: queryExtra
                // Ejemplo: &fq=cve_es_s:"BOP-LE-2024-054009"
                let valorQueryExtra = '&fq=(cve_es_s:"' + $('#cve_es_s').val() + '" OR bop.cve_prop:"' + $('#cve_es_s').val() + '")'
                $('#queryExtra').val((valorQueryExtra));
                $('form#buscador_anuncios_cve').submit();
            } else {
                $('form#buscador_anuncios_cve').validate().showErrors();
            }
        });


    </script>

		
		
	

