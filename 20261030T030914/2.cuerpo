function reportAnunciosCsv() {
    var busqueda = obtenerValorParametro("busqueda");
    if (busqueda == "numBop") {
        var numBoletin = obtenerValorParametro("num");
//        loadAnunciosAnunciantes(numBoletin);
    } else if (busqueda == "fechaBop") {
        var fechaBop = obtenerValorParametro("fecha");
//        loadBopFecha(fechaBop);
    } else if (busqueda == "tge") {
        var tipo = obtenerValorParametro("tipo");
        var grupo = obtenerValorParametro("grupo");
        var entidad = obtenerValorParametro("entidad");
        var desde = obtenerValorParametro("desde");
        var hasta = obtenerValorParametro("hasta");
        if (grupo == "null") {
            grupo = -1;
        }
        if (entidad == "null") {
            entidad = -1;
        }
        loadAnunciosTipoGrupoEntidadCSV(tipo, grupo, entidad, desde, hasta);
    } else if (busqueda == "tc") {
        var tipos = obtenerValorParametro("tipos");
        var desde = obtenerValorParametro("desde");
        var hasta = obtenerValorParametro("hasta");
        loadAnunciosTipoContenidoCsv(tipos, desde, hasta);
    } else if (busqueda == "ba") {
        var texto = obtenerValorParametro("texto");
        var tipo = obtenerValorParametro("tipo");
        var grupo = obtenerValorParametro("grupo");
        if (grupo == "null") {
            grupo = -1;
        }
        var entidad = obtenerValorParametro("entidad");
        if (entidad == "null") {
            entidad = -1;
        }
        var tipos = obtenerValorParametro("tipos");
        var desde = obtenerValorParametro("desde");
        var hasta = obtenerValorParametro("hasta");
        loadAnunciosBusqAvanzadaCSV(texto, tipo, grupo, entidad, tipos, desde, hasta);
    }

//    $.ajax({
//        url: '/bop/services/anuncios/report/csv',
//        method: 'GET',
//        dataType: 'json',
//        data: {"dataAnunciosAnunciantes": dataAnunciosAnunciantes},
//        timeout: 0, // sin tiempo de espera
//        success: function (resultado, textStatus, jqXHR) {
//            
//        },
//        error: function (jqXHR, textStatus, errorThrown) {
//            console.log("Error: reportAnunciosCsv() -> /services/anuncios/report/csv", textStatus);
//        }
//    });
}

