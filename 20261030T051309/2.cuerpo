              <div class="row">
          <div class="col-12">
              <div class="region region-content">
    

<div id="block-themag-st-content" class="block block-system block-system-main-block">
  
    
      <div class="block-content">
<div data-history-node-id="85194" class="layout--a">

        <div class="layout-region layout-region--featured">
    
  </div>

  <div class="container">

                      <div class="row">
        <div class="col-12 layout-region layout-region--top">
          
            <div class="field field--name-node-title field--type-ds field--label-hidden field__item"><h2>
  BOP DE 29/10/2026
</h2>
</div>
      
        </div>
      </div>
    
    <div class="row">
      <div class="col-12 col-lg-4 layout-region layout-region--top-left">
        
  <div class="field field--name-field-ail-codigo field--type-integer field--label-inline">
    <div class="field__label">Código</div>
              <div class="field__item">248</div>
          </div>

      </div>
      <div class="col-12 col-lg-4 layout-region layout-region--top-middle">
        
            <div class="field field--name-field-bop-castelan field--type-file field--label-hidden field__item">
<span class="file file--mime-application-pdf file--application-pdf"> <a href="https://deputacionlugo.gal/sites/deputacionlugo.org/files/2026-10/29-10-2026%20spa.pdf" type="application/pdf; length=372787">29-10-2026 spa.pdf</a></span>
</div>
      
      </div>
      <div class="col-12 col-lg-4 layout-region layout-region--top-middle">
        
  <div class="field field--name-field-ail-bop-fecha-publicacion field--type-datetime field--label-inline">
    <div class="field__label">Fecha publicación</div>
              <div class="field__item">Xoves, 29 de Outubro de 2026</div>
          </div>

      </div>
    </div>

                <div class="row">
      <div class="col-12 col-lg-8 layout-region layout-region--middle-left">
        
      </div>
      <div class="col-12 col-lg-4 layout-region layout-region--middle-right">
        <div class="inner "></div>
      </div>
    </div>

    <div class="row">
      <div class="col-12 layout-region layout-region--middle">
        
            <div class="clearfix text-formatted field field--name-field-ail-bop-contenido field--type-text-long field--label-hidden field__item"><ul><li><strong>EXCMA. DEPUTACIÓN PROVINCIAL DE LUGO</strong>
	<ul><li><strong>ÁREA DE MULLER E IGUALDADE</strong>
		<ul><li><a class="file file--mime-application-pdf file--application-pdf" data-entity-type="file" data-entity-uuid="c825247b-1bd7-4aba-bba5-5ddb65722d11" href="/sites/deputacionlugo.org/files/inline-files/29-10-2026.pdf#page=1">RELACIÓN DE SUBVENCIÓNS DIRECTAS (NOMINATIVAS E EXCEPCIONAIS) DE IGUALDADE TRAMITADAS NO 2.º TRIMESTRE 2026 (PÁX. 1, R. 2925)</a></li>
			<li><a href="/sites/deputacionlugo.org/files/inline-files/29-10-2026.pdf#page=1">RELACIÓN DE SUBVENCIÓNS DIRECTAS (NOMINATIVAS E EXCEPCIONAIS) DE IGUALDADE TRAMITADAS NO 3.º TRIMESTRE 2026 (PÁX. 1, R. 2927)</a></li>
		</ul></li>
		<li><strong>ÁREA DE PROMOCIÓN ECONÓMICA E SOCIAL</strong>
		<ul><li><a href="/sites/deputacionlugo.org/files/inline-files/29-10-2026.pdf#page=2">RELACIÓN DE SUBVENCIÓNS DIRECTAS (NOMINATIVAS E EXCEPCIONAIS) DE BENESTAR SOCIAL TRAMITADAS NO 2.º TRIMESTRE 2026 (PÁX. 2, R. 2924)</a></li>
			<li><a href="/sites/deputacionlugo.org/files/inline-files/29-10-2026.pdf#page=4">RELACIÓN DE SUBVENCIÓNS DIRECTAS (NOMINATIVAS E EXCEPCIONAIS) DE BENESTAR SOCIAL TRAMITADAS NO 3.º TRIMESTRE 2026 (PÁX. 4, R. 2926)</a></li>
		</ul></li>
	</ul></li>
	<li><strong>CONCELLOS</strong>
	<ul><li><strong>MONFORTE DE LEMOS</strong>
		<ul><li><a href="/sites/deputacionlugo.org/files/inline-files/29-10-2026.pdf#page=5">APROBACIÓN PROVISIONAL DA MODIFICACIÓN DAS ORDENANZAS FISCAIS E NON FISCAIS 2027 (PÁX. 5, R. 2962)</a></li>
			<li><a href="/sites/deputacionlugo.org/files/inline-files/29-10-2026.pdf#page=5">APROBACIÓN DEFINITIVA DO EXPEDIENTE DE MODIFICACIÓN DE CRÉDITOS 45/2026 (PÁX. 5, R. 2951)</a></li>
		</ul></li>
		<li><strong>OUROL</strong>
		<ul><li><a href="/sites/deputacionlugo.org/files/inline-files/29-10-2026.pdf#page=6">APROBACIÓN DEFINITIVA DO EXPEDIENTE DE MODIFICACIÓN DO ORZAMENTO (PÁX. 6, R. 2952)</a></li>
		</ul></li>
		<li><strong>A POBRA DO BROLLÓN</strong>
		<ul><li><a href="/sites/deputacionlugo.org/files/inline-files/29-10-2026.pdf#page=6">APROBACIÓN DO PADRÓN FISCAL DO SAF DE SETEMBRO 2026 (PÁX. 6, R. 2928)</a></li>
		</ul></li>
		<li><strong>SOBER</strong>
		<ul><li><a href="/sites/deputacionlugo.org/files/inline-files/29-10-2026.pdf#page=7">APROBACIÓN DO PADRÓN FISCAL DO SAF DE SETEMBRO 2026 (PÁX. 7, R. 2929)</a></li>
		</ul></li>
		<li>O <strong>VALADOURO</strong>
		<ul><li><a href="/sites/deputacionlugo.org/files/inline-files/29-10-2026.pdf#page=7">PROGRAMA DE CARÁCTER TEMPORAL: MANTEMENTO E ROZADO DE CAMIÑOS MUNICIPAIS 2026 (PÁX. 7, R. 2930)</a></li>
		</ul></li>
	</ul></li>
	<li><strong>COMUNIDADE DE USUARIOS DA TRAÍDA DE AUGAS DE SANTA MARIÑA</strong>
	<ul><li><a href="/sites/deputacionlugo.org/files/inline-files/29-10-2026.pdf#page=8">CONVOCATORIA DE ASEMBLEAS (PÁX. 8, R. 2912)</a></li>
	</ul></li>
</ul></div>
      
