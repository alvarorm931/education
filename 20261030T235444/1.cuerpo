		<div id="titulo"><h3>Calendario</h3></div>
		<div id="calendario">            <td align="center"  colspan="0" >
            <link rel="stylesheet" type="text/css" href="/comunCSS/calendario/jscal2.css" />
            <link rel="stylesheet" type="text/css" href="/comunCSS/calendario/border-radius.css" />
            <link rel="stylesheet" type="text/css" href="/comunCSS/calendario/diputacion/diputacion.css" />
            <script type="text/javascript" src="/comunJS/calendario/jscal2.js"></script>
            <script type="text/javascript" src="/comunJS/calendario/lang/es.js"></script>
            <script>
            window.__cal_desact = function(fecha)
            {
              var desactivadas = {};
              fecha = Calendar.dateToInt(fecha);
              return fecha in desactivadas;
            }

            window.__cal_marcada = function(fecha, desde, hasta)
            {
              var dia = Calendar.dateToInt(fecha);
              if ((dia < desde) || (dia > hasta)) return null;
              var marcadas = {};
              return marcadas[dia];
            }

            window.__cal_selfecha = function(cal)
            {
              // 1- Deseleccionamos las fechas desactivadas.
              var fechas = cal.selection.getDates();
              for (var i = 0; i < fechas.length; ++i)
              {
                if (cal.isDisabled(fechas[i]))
                  cal.selection.unselect(fechas[i]);
              }

              // 2.- Calculamos el total de días seleccionados en todos los calendarios.
              var id  = cal.args.cont.substring(6,7);
              var multiple = (__cal_sel[id].cals > 1)
              var diasSel = 0;
              for(var i=1; i<=__cal_sel[id].cals; i++)
              {
                if(!multiple)
                  objCal = eval('__o__cal_' + id);
                else                  objCal = eval('__o__cal_' + id + '_' + i);
                diasSel += objCal.selection.countDays();
              }

              // 3.- Si el total supera el máximo, hay que deseleccionar.
              if ((__cal_sel[id].max >= 0)&&(diasSel>__cal_sel[id].max))
              {
                var fechasSel=cal.selection.getDates();
                for(i=0; i<=(diasSel - __cal_sel[id].max);i++)
                  cal.selection.unselect(fechasSel[fechasSel.length-i]);
                diasSel = __cal_sel[id].max;
              }
              __cal_sel[id].total = diasSel;

              // 4.- Actualizamos el contador visual.
              if (__cal_sel[id].div != '')
              {
                oDiv = document.getElementById(__cal_sel[id].div);
                if (oDiv.tagName == 'INPUT')
                  oDiv.value = diasSel;
                else
                  oDiv.innerHTML=diasSel;
              }

              // 5.- Actualizamos el campo hidden con el contenido de las fechas seleccionadas.
              var aFechas = new Array();
              for(var i=1; i<=__cal_sel[id].cals; i++)
              {
                if(multiple)
                  objCal = eval('__o__cal_' + id + '_' + i);
                else
                  objCal = eval('__o__cal_' + id);
                var aAux = objCal.selection.getDates();
                for (var j=0; j<aAux.length; j++)
                  aFechas[aFechas.length] = Calendar.printDate(aAux[j],'%Y-%m-%d');
              }
              var oCampo = document.getElementById(cal.args.nombre);
              oCampo.value=aFechas.join(',');
              // 6.- Si el calendario tiene asociada una acción, la ejecutamos pasándole la fecha
              fechaSeleccionada(fechas);
            }
            window.__cal_sel = new Array();
            </script>
            <style>
            .__calMes
            {
    	        float: left;
    	        margin: 2px;
            }
            </style>
              <div id="__cal_1" class="__calMes"></div>
              <script>
              __o__cal_1 = Calendar.setup({
                                cont:          "__cal_1",
                                weekNumbers:   false,
                                selectionType: Calendar.SEL_SINGLE,
																 date:					20261031,
                                min:           20010102,
                                max:           20261231,
                                titleFormat:   "%B %Y",
                                bottomBar:     false,
                                disabled:      __cal_desact,
                                onSelect:      function() { __cal_selfecha(this); },
                                nombre:        'calenda'
                              });
              </script>
              <script>__cal_sel[1] = {max: -1,cals: 1,total: 0,div: ''};</script>
              <input type='hidden' name='calenda' id='calenda' />
            </td>
</div>
