on:.25s ease-in-out;-o-transition:.25s ease-in-out;transition:.25s ease-in-out}.menuheader .menu-mobile-trigger span:nth-child(1){top:0}.menuheader .menu-mobile-trigger span:nth-child(2),.menuheader .menu-mobile-trigger span:nth-child(3){top:.5rem}.menuheader .menu-mobile-trigger span:nth-child(4){top:1rem}.header-item-right{-webkit-box-align:center;-ms-flex-align:center;align-items:center}.menuheader .menu{position:fixed;top:0;left:0;width:50%;min-width:28rem;height:100%;z-index:1099;overflow:hidden;background:#fafafa;-webkit-transform:translate(-100%);-ms-transform:translate(-100%);transform:translate(-100%);-webkit-transition:all .5s ease-in-out;-o-transition:all .5s ease-in-out;transition:all .5s ease-in-out}.menuheader .menu.active{-webkit-transform:translate(0%);-ms-transform:translate(0%);transform:translate(0%)}.menuheader .menu>ul>li{display:block;line-height:1;margin:0}.menuheader .menu>ul>li>a{display:block;line-height:3.125rem;height:3.125rem;padding:0 3.125rem 0 1rem;border-bottom:1px solid rgba(0,0,0,0.1)}.menuheader .menu>ul>li>a i.fa{position:absolute;font-size:1.25rem;line-height:3.125rem;top:0;right:0;width:3.125rem;height:3.125rem;text-align:center;-webkit-transform:rotate(-90deg);-ms-transform:rotate(-90deg);transform:rotate(-90deg)}.menuheader .menu .menu-mobile-header{position:relative;position:-webkit-sticky;position:sticky;display:-webkit-box;display:-ms-flexbox;display:flex;-webkit-box-align:center;-ms-flex-align:center;align-items:center;-webkit-box-pack:justify;-ms-flex-pack:justify;justify-content:space-between;top:0;height:3.125rem;z-index:501;border-bottom:1px solid rgba(0,0,0,0.1);background:#fafafa}.menuheader .menu .menu-mobile-header.active .menu-mobile-arrow{display:block}.menuheader .menu .menu-mobile-header .menu-mobile-arrow{display:none;font-size:1.25rem;line-height:3.125rem;width:3.125rem;height:3.125rem;cursor:pointer;border-right:1px solid rgba(0,0,0,0.1);color:#121212;text-align:center}.menuheader .menu .menu-mobile-header .menu-mobile-title{font-family:inherit;font-size:1rem;font-weight:500;line-height:inherit;color:#121212;text-rendering:optimizeLegibility}.menuheader .menu .menu-mobile-header .menu-mobile-close{font-size:2.25rem;line-height:3.125rem;cursor:pointer;width:3.125rem;height:3.125rem;border-left:1px solid rgba(0,0,0,0.1);color:#121212;text-align:center}.menuheader .menu .menu-section{height:100%;overflow-y:auto;overflow-x:hidden;margin:0}.menuheader .menu>ul>li .menu-subs{position:absolute;display:none;top:0;left:0;max-width:none;min-width:auto;width:100%;height:100%;margin:0;padding:1rem;padding-top:4rem;opacity:1;overflow-y:auto;visibility:visible;-webkit-transform:translateX(0%);-ms-transform:translateX(0%);transform:translateX(0%);-webkit-box-shadow:none;box-shadow:none}.menuheader .menu>ul>li .menu-subs.menu-mega{position:absolute;display:none;top:0;left:0;max-width:none;min-width:auto;width:100%;height:100%;margin:0;padding:1rem;padding-top:4rem;opacity:1;overflow-y:auto;visibility:visible;-webkit-transform:translateX(0%);-ms-transform:translateX(0%);transform:translateX(0%);-webkit-box-shadow:none;box-shadow:none}.menuheader .menu>ul>li .menu-subs.active{display:block}.menuheader [class^="menu-column-"].active{display:block}.menuheader .menu>ul>li .menu-subs.menu-column-4>.list-item{-webkit-box-flex:0;-ms-flex:0 0 100%;flex:0 0 100%;padding:0rem}.menuheader .menu>ul>li .menu-subs.menu-column-4>.list-item img.responsive{margin-top:0}.menuheader .menu>ul>li .menu-subs.menu-column-4>.list-item .title{margin-bottom:1.25rem}.menuheader .menu>ul>li .menu-subs.menu-column-4>.list-item:last-child .title{margin-bottom:0rem}.menuheader .menu>ul>li .menu-subs>ul>li>a{display:block}.menuheader .menu>ul>li .menu-subs.menu-mega>.list-item>ul{margin-bottom:1rem}.menuheader .menu>ul>li .menu-subs.menu-mega>.list-item>ul>li>a{display:block}.overlay{position:fixed;top:0;left:0;width:100%;height:100%;z-index:1098;opacity:0;visibility:hidden;background:rgba(0,0,0,0.55);-webkit-transition:all .5s ease-in-out;-o-transition:all .5s ease-in-out;transition:all .5s ease-in-out}.overlay.active{opacity:1;visibility:visible}}.menuheader .main{display:block;width:100%;min-height:100vh;background-image:url("https://source.unsplash.com/pkhBlvTLyog/1920x1280");background-size:cover;background-position:center right;background-repeat:no-repeat}@media only screen and (max-width:493px){div.container.cabecera-bottom .row:nth-child(2){background-image:url(/wres/transparencia/img/logoAgrupadoMovil.png);background-size:cover;min-height:60px}.logotipo,.logotipo-carm{display:none}.transparencia .v-center{display:none!important}}div.navLinkLevel1{width:100%;background-color:#fafafa}li.separador{height:1px;background-color:#c0c0c0;padding:0;margin:0}</style> </div> <div class="entry-links"> </div> </div> </div> </div> <div id="content"> <nav id="breadcrumbs" role="menubar" aria-hidden="true"> <ul aria-label="Camino de migas" class="breadcrumb breadcrumb-horizontal"> <li class="first breadcrumb-truncate"><a href="https://transparencia--carm--es.insuit.net/">Portal de la Transparencia</a><span class="divider" aria-hidden="true">/</span></li><li><a href="https://transparencia--carm--es.insuit.net/normativa">Normativa</a><span class="divider" aria-hidden="true">/</span></li><li class="current-parent breadcrumb-truncate"><a href="https://transparencia--carm--es.insuit.net/menonlynormativa-principal">Normativa Principal</a><span class="divider" aria-hidden="true">/</span></li><li class="active last breadcrumb-truncate"><a href="https://transparencia--carm--es.insuit.net/legislacion-regional">Normativa regional</a><span class="divider" aria-hidden="true">/</span></li> </ul> </nav> <div class="columns-1" id="main-content" role="main" aria-label="Contenido principal."> <div class="col-xs-12 margen-contenedor-cabecera"> <div class="contenedor-imagen-cabecera no-padding-left no-padding-right"> <img class="imagen-contenedor-grande" src="https://transparencia--carm--es.insuit.net/documents/184026/184312/icon_100_-32.jpg/0ffaab86-bb09-4cfb-870f-9783a80a07e0?t=1420618463597" alt="Normativa regional" aria-hidden="true"> </div> <div class="col-xs-10 no-padding-left"> <h1 class="cabecera-pagina">Normativa regional</h1> </div> </div> <div class="portlet-layout row-fluid"> <div class="portlet-column portlet-column-first col-md-12" id="column-1" style="min-height:100px;" role="region" aria-live="polite"> <div class="portlet-dropzone portlet-column-content portlet-column-content-first" id="layout-column_column-1"> <div class="i4t_descripcion" id="p_p_id_56_INSTANCE_zDWgZ5xAnToc_" aria-label="Descripción" role="region"> <span id="p_56_INSTANCE_zDWgZ5xAnToc"></span> <div class="portlet-borderless-container" style="" role="region" aria-label="Secciones Transparencia"> <div class="portlet-body"> <div class="journal-content-article"> <style> .contenedor-enlaces a,.contenedor-enlaces a:hover{ color: #3aaeda; } div.col-xs-1-big{ width: 12%; float:left; position: relative; min-height: 1px; padding-left: 15px; padding-right: 15px; } div.entradilla{ margin-bottom:15px; } </style> <div class="cuerpo-texto"> <div class="row-fluid entradilla"> Se facilita el acceso a la relación actualizada de la normativa vigente de la Comunidad Autónoma. <p>Esta página ofrece&nbsp;la recopilación de las leyes regionales y decretos de carácter general por ámbitos temáticos, junto a su análisis jurídico para modificaciones y derogaciones.&nbsp;</p> <p>Asímismo,&nbsp;se proporciona información de los decretos-leyes que, en caso de extraordinaria y urgente necesidad, dicte el Consejo de Gobierno, de acuerdo con lo previsto en el artículo 30.3 del <a href="https://www.boe.es/buscar/act.php?id=BOE-A-1982-15031&amp;p=20131129&amp;tn=6" title="Estatuto de Autonomía de la Región de Murcia">Estatuto de Autonomía</a>, y de los decretos legislativos cuya elaboración le hubiera delegado la Asamblea Regional, según lo dispuesto en el artículo 47 y siguientes de la&nbsp;<a href="http://www.boe.es/buscar/act.php?id=BOE-A-2005-14442" target="_self" title="Ley 6/2004 del Estatuto del Presidente y del Consejo de Gobierno">Ley 6/2004, de 28 de diciembre, del Estatuto del Presidente y del Consejo de Gobierno de la Región de Murcia</a>.</p> </div> <div class="contenedor-enlaces" role="region"> <div class="cuidadin alert alert-warning portlet-msg-alert portlet-msg-alert" aria-label="Advertencia  "><span style="font-size: 16px;">Descarga&nbsp;el <a href="https://www.boe.es/biblioteca_juridica/codigos/codigo.php?id=347_Codigo_de_la_Region_de_Murcia&amp;tipo=C&amp;modo=2">Código de la Región de Murcia</a>. Accceso a la librería del BOE&nbsp;(Formatos PDF, Epub).</span></div> <div class="cuidadin alert alert-warning portlet-msg-alert portlet-msg-alert"><span style="font-size: 16px;"><strong>En revisión:</strong> La consolidación normativa está pendiente de actualizar según el Decreto-Ley&nbsp; nº 1/2025, de 5 de junio, de Simplificación Administrativa de la Región de Murcia,&nbsp;</span><a class="x_OWAAutoLink" data-auth="NotApplicable" href="https://eur05.safelinks.protection.outlook.com/?url=https%3A%2F%2Fwww.borm.es%2Fservices%2Fanuncio%2Fano%2F2025%2Fnumero%2F2665%2Fpdf%3Fid%3D836713&amp;data=05%7C02%7Cmariaa.serna%40carm.es%7C3e2c11483e17447eedf908dda7f2ffce%7Ca88b9f941a954624b67a855d708276bb%7C0%7C0%7C638851384289195257%7CUnknown%7CTWFpbGZsb3d8eyJFbXB0eU1hcGkiOnRydWUsIlYiOiIwLjAuMDAwMCIsIlAiOiJXaW4zMiIsIkFOIjoiTWFpbCIsIldUIjoyfQ%3D%3D%7C0%7C%7C%7C&amp;sdata=its5w2oM%2B4FpqX5Bq442PxgdDN016eWSXdmwddjRCio%3D&amp;reserved=0" id="OWAd01264f5-0984-5650-4754-5404784563ae" originalsrc="https://www.borm.es/services/anuncio/ano/2025/numero/2665/pdf?id=836713" rel="noopener noreferrer" style="border: 0px; font-variant-numeric: inherit; font-variant-east-asian: inherit; font-variant-alternates: inherit; font-variant-position: inherit; font-variant-emoji: inherit; font-stretch: inherit; font-size: 16px; line-height: inherit; font-family: Arial, Helvetica, sans-serif, serif, EmojiFont; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; margin: 0px; padding: 0px; vertical-align: baseline; text-align: justify;" title="Dirección URL original: https://www.borm.es/services/anuncio/ano/2025/numero/2665/pdf?id=836713. Haga clic o pulse si confía en este vínculo.">BORM nº130,&nbsp;de 7 de junio de 2025</a>.</div> </div> <a name="s1" aria-hidden="true"></a> <h2 class="titSeccion">Listado de Normativa Regional</h2> <div class="contenedor-enlaces" role="region"><!-- TODO - INICIO --> <div> <div class="dataTables_wrapper form-inline"><!-- Filtros Año y Materias --> <div class="row lineaFiltros separadorCombos separadorCombos" role="form" aria-label="Filtros"> <div class="col-sm-2 cajaFiltro"><span class="fa fa-bars">&nbsp;</span><span>Filtrar por: </span></div> <!-- Combo de Año --> <div class="col-sm-3"> <div><label>Rango:&nbsp;&nbsp;<select class="input-sm" id="selectorRango" style="width:65%"><option selected value=""></option></select> </label></div> </div> <!-- Combo de Año --> <div class="col-sm-2"> <div><label>Año:&nbsp;&nbsp;<select class="input-sm" id="selectorAnio" style="width:65%"><option selected value=""></option></select> </label></div> </div> <!-- Combo de materias --> <div class="col-sm-5"> <div><label>Materias:&nbsp;&nbsp;<select class="input-sm" id="selectorMaterias" style="width:65%"><option selected value=""></option></select> </label></div> </div> </div> <!-- Filtro aplicados --> <div class="row lineaFiltrosGrande separadorCombos" role="text" aria-label="Filtros aplicados"> <div class="col-sm-2 cajaFiltro"><span class="fa fa-bars">&nbsp;</span><span>Filtros aplicados: </span></div> <div class="col-sm-10" id="filtrosAplicados">&nbsp;</div> </div> <!-- botones de exportación (arriba) --> <div class="row lineaFiltros separadorTabla" role="region"> <div class="exportOptions" id="exportOptions">&nbsp;</div> </div> </div> <!-- ENCABEZADO - INICIO --> <table cellspacing="0" class="display table table-stripped table-hover" id="legislacion"> <thead class="datableheader" style="display:"> <tr> <th width="45%">Norma</th> <th>Fecha <abbr title="Boletín Oficial de la Región de Murcia">BORM</abbr></th> <th width="20%">Materias</th> <th>Normas afectadas</th> <th>Año</th> </tr> </thead> </table> <!-- ENCABEZADO - FIN --><!-- Botones export de la parte inferior --> <div class="dataTables_wrapper form-inline"> <div class="row lineaFiltros separadorTabla" role="region"> <div class="exportOptions" id="exportOptionsBottom">&nbsp;</div> </div> </div> </div> <!-- TODO - FIN --><script type="text/javascript">var DatatableControl={returnedJson:null,template:null,table:null,detailTable:null,detailTable2:null,languageConfig:DatatableCommon.spanishLabels,config:DatatableCommon.currencyConfig,querystring:function(b){var c=new RegExp("(?:\\?|&)"+b+"=(.*?)(?=&|$)","gi");var d=[],a;while((a=c.exec(document.location.search))!=null){d[d.length]=a[1]}return d},initSelector:function(d,c,a,b){var e=[];jQuery(d).each(function(f,h){var j=jQuery.trim(h[a]).split("  ").join(" ");if(j.indexOf("|")>=0){var k=j.split("|");for(var g=0;g<k.length;g++){if(jQuery.inArray(k[g].trim(),e)<0){e.push(k[g].trim())}}}else{if(jQuery.inArray(j,e)<0){e.push(j)}}});e.sort(function(g,f){if(g<f){return -1}if(g>f){return 1}return 0});jQuery.each(e,function(f,g){var h=new Option(g,g);jQuery(h).html(g);jQuery("#"+c).append(h)});jQuery("#"+c).on("change",function(g){var h=jQuery("option:selected",this);var f=this.value;DatatableControl.table.DataTable().columns(b).search(f).draw()})},initSelectores:function(a){DatatableCommon.initSelector(a,"selectorAnio",15,4);DatatableCommon.initSelector(a,"selectorRango",2,5);DatatableControl.initSelector(a,"selectorMaterias",17,2)},initTable:function(){var a=new Date("1970-01-01");DatatableControl.template=jQuery("#template-wrapper").html();DatatableControl.table=jQuery("#legislacion").dataTable({order:[[0,"asc"]],language:DatatableControl.languageConfig,iDisplayLength:10,ajax:{url:"/rest-services/services/restAPI/RegistroLegislacionDisposicion?vigente="+encodeURIComponent("'S'"),cache:true,dataSrc:function(b){var c=new Object();c.data=b;DatatableControl.returnedJson=c.data;jQuery(".numberRegister").empty();jQuery(".numberRegister").append("<span class='pull-left cajaNumeroRegistros'>Se descargarán <strong>"+DatatableControl.returnedJson.length+"</strong> registros</span>");DatatableControl.initSelectores(DatatableControl.returnedJson);DatatableCommon.addSearchBoxTooltip("Esta búsqueda distingue tildes");jQuery("#fechaCon").html("Fecha de Actualización Información:");jQuery("#fechaCon").after("<dd>"+c.data[0][4]+"</dd>");return c.data}},order:[[1,"desc"]],columnDefs:[{targets:0,orderable:false,render:function(d,c,b,e){var f=b[13]!=null&&b[13].length>0?b[13]:b[5];if(b[14]!=""){return'<a href="/web/transparencia/ficha-tecnica?identificador='+b[8]+'"><i class="icon-quote-left"></i>&nbsp;<strong>'+f+"</strong></a>"}else{if(b[7]==""){return'<a href="/web/transparencia/ficha-tecnica?identificador='+b[8]+'"><strong>'+f+"</strong></a>"}else{return'<a href="/web/transparencia/ficha-tecnica?identificador='+b[8]+'"><strong>'+f+"</strong></a>"}}}},{targets:1,type:"date-eu",render:function(d,c,b,e){return b[4]}},{targets:2,render:function(g,e,d,h){if(d[17]!=null){var f=d[17].split("|");var b="";for(var c=0;c<f.length;c++){b+='<li><span class="fa fa-caret-right"></span>&nbsp;'+f[c]+"</li>"}return'<ul class="unstyled">'+b+"</ul>"}return""}},{targets:3,orderable:false,render:function(d,c,b,e){if(b[18]==0){return""}else{if(b[18]==1){return'<a href="/web/transparencia/ficha-tecnica?identificador='+b[8]+'">'+b[18]+" referencia</a>"}else{return'<a href="/web/transparencia/ficha-tecnica?identificador='+b[8]+'">'+b[18]+" referencias</a>"}}}},{targets:4,render:function(d,c,b,e){return b[15]}},{targets:5,visible:false,searchable:true,render:function(d,c,b,e){return b[2]}}]});jQuery("#legislacion").on("draw.dt",function(){jQuery('[data-toggle="tooltip"]').tooltip();jQuery('[data-toggle="tooltip"]').tooltip();var e=jQuery("#selectorAnio").find(":selected").text();var d=jQuery("#selectorMaterias").find(":selected").text();var b=jQuery("#selectorRango").find(":selected").text();var c="";if(e){c+=c!=""?"<strong>,&nbsp;Año:&nbsp;</strong>"+e:"<strong>Año:&nbsp;</strong>"+e}if(d){c+=c!=""?"<strong>,&nbsp;Materia:&nbsp;</strong>"+d:"<strong>Materia:&nbsp;</strong>"+d}if(b){c+=c!=""?"<strong>,&nbsp;Rango:&nbsp;</strong>"+b:"<strong>Rango:&nbsp;</strong>"+b}if(jQuery("#legislacion_filter input").val()&&jQuery("#legislacion_filter input").val().length>0){c+="<br/><strong>Texto de b&uacute;squeda: </strong>"+jQuery("#tabla-datos_filter input").val()}c+="<br/>"+(jQuery("#legislacion_info").html().indexOf(".")>=0?jQuery("#legislacion_info").html().split(".")[0]:"No hay registros que mostrar");jQuery("#filtrosAplicados").empty().append(c)})}};DatatableControl.initTable();var configuration=new Object();var columna1=new Object();columna1.nombre="RANGO";columna1.indicesJSON=[];columna1.indicesJSON.push(2);columna1.tipo="cadena";var columna2=new Object();columna2.nombre="NORMA";columna2.indicesJSON=[];columna2.indicesJSON.push(5);columna2.tipo="cadena";var columna3=new Object();columna3.nombre="FECHA_BORM";columna3.indicesJSON=[];columna3.indicesJSON.push(4);columna3.tipo="cadena";var columna4=new Object();columna4.nombre="AÑO_DISPOSICION";columna4.indicesJSON=[];columna4.indicesJSON.push(15);columna4.tipo="cadena";var columna5=new Object();columna5.nombre="VIGENTE";columna5.indicesJSON=[];columna5.indicesJSON.push(16);columna5.tipo="cadena";var columna6=new Object();columna6.nombre="MATERIAS";columna6.indicesJSON=[];columna6.indicesJSON.push(17);columna6.tipo="cadena";var columna7=new Object();columna7.nombre="REFERENCIAS";columna7.indicesJSON=[];columna7.indicesJSON.push(18);columna7.tipo="cadena";var columna8=new Object();columna8.nombre="ENLACE_BORM_HTML";columna8.indicesJSON=[];columna8.indicesJSON.push(7);columna8.tipo="cadena";var columna9=new Object();columna9.nombre="ENLACE_BORM_PDF";columna9.indicesJSON=[];columna9.indicesJSON.push(6);columna9.tipo="cadena";var columna10=new Object();columna10.nombre="NUM-DISPOSICION";columna10.indicesJSON=[];columna10.indicesJSON.push(19);columna10.tipo="cadena";var columna11=new Object();columna11.nombre="FECHA-DISPOSICION";columna11.indicesJSON=[];columna11.indicesJSON.push(20);columna11.tipo="cadena";var columnasArray=[];columnasArray.push(columna1);columnasArray.push(columna2);columnasArray.push(columna3);columnasArray.push(columna4);columnasArray.push(columna5);columnasArray.push(columna6);columnasArray.push(columna7);columnasArray.push(columna8);columnasArray.push(columna9);columnasArray.push(columna10);columnasArray.push(columna11);configuration.url="/rest-services/services/restAPI/RegistroLegislacionDisposicion/";configuration.nombreFichero="NormativaCARM";configuration.columnas=columnasArray;configuration.columnasVisibles=[0,1,2,3];DatatableCommon.initDatatablesSingleExport(".exportOptions","#legislacion",configuration);</script></div> <!--fuera 1 --> <!--dentro 1 --> <a name="s2" aria-hidden="true"></a> <h2 class="titSeccion">Consolidación Normativa</h2> <div class="contenedor-enlaces" role="region"><p>La Ley de Transparencia&nbsp; de la Comunidad Autónoma de la Región de Murcia, en su disposicion adicional segunda&nbsp;sobre <strong>Revisión y simplificación normativa, </strong>insta al impulso de la "consolidación normativa del ordenamiento jurídico regional".</p> <p>En este sentido, conforme se van desarrollando textos consolidados de una norma aparecerá en el detalle de la norma un enlace al texto consolidado.</p> <p>Actualmente las normas con rango de <strong>Ley</strong> son consolidadas por el Boletín Oficial de Estado.</p> <p>Para el resto de normas se está trabajando desde la Oficina de la Transparencia y de la Participación ciudadana, en colaboración con los servicios jurídicos de las distintas consejerías, en su consolidación. Una gran parte de las normas con rango de <strong>Decreto</strong> están ya disponibles en su versión consolidada.</p></div> <!--fuera 1 --> <!--dentro 1 --> <a name="s3" aria-hidden="true"></a> <h2 class="titSeccion">Fuentes de información legislativa</h2> <div class="contenedor-enlaces" role="region"><p style="color: rgb(0, 0, 0); line-height: 20.79px;">Existen otros servicios con información sobre normativa regional:</p> <ul style="color: rgb(0, 0, 0); line-height: 20.79px;"> <li><a href="https://www.borm.es/#/home/buscador">Buscador avanzado del Boletín Oficial de la Región de Murcia</a>.</li> </ul></div> <!--fuera 1 --> <!--dentro 1 --> <a name="notaAlcance" aria-label="nota-alcance" aria-hidden="true"></a> <h2 id="i4t-id-75">Nota de alcance</h2> <div class="caja-comunicaciones" aria-labelledby="i4t-id-75" role="region"> <dl> <dt>Fuente principal de datos: </dt> <dd><root available-locales="es_ES" default-locale="es_ES"><description language-id="es_ES">Boletín Oficial de la Región de Murcia</description></root> <ul class="list-unstyled"> <li> <strong>Detalles: </strong> Tratamiento analítico de los contenido BORM para Portal de Transparencia </li> </ul> </dd> <dd><!--?xml version='1.0' encoding='UTF-8'?--><root available-locales="es_ES" default-locale="es_ES"><description language-id="es_ES">Centro de Documentación e Información (CEDI).</description></root> <ul class="list-unstyled"> <li> <strong>detalles: </strong> Oficina de Transparencia y Participación Ciudadana </li> </ul> </dd> <dt>Tipo de acceso: </dt> <dd> <ul> <li>DatosAbiertos</li> </ul> </dd> <dd> </dd> <dt>Periodicidad: </dt> <dd> <ul> <li>Mensual</li> </ul> </dd> <dd> (Continua, conforme a publicación en BORM) </dd> <dt>Última actualización: </dt> <dd>27/06/2022</dd> <dt id="fechaCon"></dt> </dl></div> <!-- Cajacominicaciones nota alcance--> </div> <!-- Cuerpo-texto--> <style> .tags { list-style: none; margin: 0; overflow: hidden; padding: 0; } .tag