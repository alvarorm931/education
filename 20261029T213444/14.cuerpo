<script src="/o/LEEboletinOficial-portlet/js/jquery.js"></script>

<!-- Datepicker for Bootstrap v1.9.0 -->
<script type="text/javascript" src="/o/LEEboletinOficial-portlet/js/bootstrap-datepicker.js"></script>
<link rel="stylesheet" href="/o/LEEboletinOficial-portlet/css/BOG-inline-bootstrap-datepicker.standalone.css">



<script type="text/javascript">
	
	var currentTime = new Date();
	var jsAnio = currentTime.getFullYear();
	
	var inhabiles = obtenerDiasInhabiles(jsAnio); // <- Es un String separado por comas ej:"19/1/2017,21/2/2017,22/2/2017,2/2/2017,6/4/2017,27/2/2017"
	var especiales = "30/12/2006,4/2/2017,29/6/2019,1/7/2023,28/6/2025"; // <- String separados por comas para d�as inh�biles que queremos mostrar en el calendario ej:"4/2/2017,21/2/2017"
	var sinBog = "21/1/2019"; // <- String separados por comas para d�as laborables que queremos no mostrar en el calendario ej:"4/2/2017,21/2/2017"
	var visited = ""; // <-String separado por comas que vamos llenando en session seg�n vamos clickando en el calendario ej:"4/2/2017,21/2/2017"
	
	var res = inhabiles.split(",");
	var esp = especiales.split(",");
	var sin = sinBog.split(",");
	var vst = visited.split(",");
	
	// Deshabilitamos el link al boletin del dia	
	var day = currentTime.getDay();
	var isWeekend = (day == 6) || (day == 0);

	var d = currentTime.getDate();
	var m = currentTime.getMonth()+1; //January is 0!
	var yyyy = currentTime.getFullYear();
	var fjday = d+'/'+m+'/'+yyyy;
	var isInhabil = isInArray(fjday, inhabiles.split(","));

	if(isWeekend || isInhabil){
		$("#boton-bog-link").removeAttr('href');
		$("#boton-bog-link").css("opacity", "0.35");
	}
	// FIN - Deshabilitamos el link al boletin del dia
	
	function obtenerDiasInhabiles(year) {		
    	var url = "https://egoitza.gipuzkoa.eus/es/bog?p_p_id=BoletinOficial_WAR_LEEboletinOficialportlet&p_p_lifecycle=2&p_p_state=normal&p_p_mode=view&p_p_resource_id=inhabiles&p_p_cacheability=cacheLevelPage";
    	var var_inhabiles = "";
    	$.ajax({
    		url: url,
    		cache: false,
    		type: "POST",
    		async: false,
    		data :{
    			_BoletinOficial_WAR_LEEboletinOficialportlet_accion: 'inhabiles',
    			_BoletinOficial_WAR_LEEboletinOficialportlet_year: year,
    		},
    		success: function(jsondata) {
    			var_inhabiles = jsondata;
    		}
    	});
    	return var_inhabiles;
	}
	
	function isInArray(data, array){
		var exists = "false";
		$.each(array, function( index, value ) {
			var val = value.replace(/"/g, ''); // quitar los posibles " IE
			if( data == val){
				exists = "true";
			}
		});
		return (exists == "true");
	}

	function getEuskeraSuffix(number) {
        let numberStr = number.toString();
        let lastTwoDigits = parseInt(numberStr.slice(-2));
        let lastDigit = parseInt(numberStr.slice(-1));
        // Números que terminan en 1, 5, 10, 30, 50, 70, 90 llevan "eko", excepto los terminados en 11, 31, 51, 71, 91
        let ekoEndings = [1, 5, 10, 30, 50, 70, 90];
        let exceptions = [11, 31, 51, 71, 91];
        if (exceptions.includes(lastTwoDigits)) {
            return "ko";
        }
        return ekoEndings.includes(lastDigit) || ekoEndings.includes(lastTwoDigits) ? "eko" : "ko";
    }
	
	var miJQuery = $.noConflict(true);
	miJQuery(document).ready(function( $ ) {

		// El datepicker buscador por d�a tiene el mismo formato de fecha (dd/mm/yyyy), ya que no vemos el valor en ning�n campo
 		$.fn.datepicker.dates['es'] = {
 	 	    days: ['Domingo', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado'],
 	 	    daysShort: ['Dom','Lun','Mar','Mié','Juv','Vie','Sáb'],
 	 	    daysMin: ['Do','Lu','Ma','Mi','Ju','Vi','Sá'],
 	 	    months: ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'],
 	 	    monthsShort: ['Ene','Feb','Mar','Abr', 'May','Jun','Jul','Ago','Sep', 'Oct','Nov','Dic'],
 	 	    today: "Hoy",
 	 	    clear: "Limpiar",
 	 	    format: "dd/mm/yyyy", // <--
 	 	    titleFormat: "MM yyyy",
 	 	    weekStart: 1
 	 	};

 	 			
 		$.fn.datepicker.dates['eu'] = {
 		    days: ['Igandea','Astelehena','Asteartea','Asteazkena','Osteguna','Ostirala','Larunbata'],
 		    daysShort: ['Iga','Ast','Ast','Ast','Ost','Ost','Lar'],
 		    daysMin: ['Ig','Al','Ar','Az','Oe','Oi','La'],
 	 		months: ['Urtarrila','Otsaila','Martxoa','Apirila','Maiatza','Ekaina', 'Uztaila','Abuztua','Iraila','Urria','Azaroa','Abendua'],
 	 		monthsShort: ['Urt','Ots','Mar','Api','Mai','Eka',	'Uzt','Abu','Ira','Urr','Aza','Abe'],
 	 		today: "Gaur",
 	 		clear: "Ezabatu",
 	 		format: "dd/mm/yyyy", // <--
 	 		titleFormat: "yyyy(e)ko MM",
 	 		weekStart: 1
 	 	};
 		
 		var lang = 'es';
 		if (lang == "es"){			
 			$.fn.datepicker.defaults.language = 'es';
 				
 		}else{			
 			$.fn.datepicker.defaults.language = 'eu'; 			
 		}
        var currentYear=getEuskeraSuffix(new Date().getFullYear())
        $.fn.datepicker.dates['eu'].titleFormat = "yyyy" + currentYear + " MM"
 		$.fn.datepicker.defaults.todayHighlight = true;
 		$.fn.datepicker.defaults.autoclose = true;
		
		$('#_BoletinOficial_WAR_LEEboletinOficialportlet_fecha').datepicker({
	    	startDate: new Date(1996, 0, 1),
	        endDate: new Date(),
			beforeShowDay: function(date) {
				var search = date.getDate() + '/' + (date.getMonth() + 1) + '/' +  date.getFullYear();				

				// Visitados
				if(isInArray(search, vst)){
					return {classes: 'visited'};
				}				
				
				// Especiales -con Bog-
				if (isInArray(search, esp)){
					return;
				}
				
				// Sin bog
				if (isInArray(search, sin)){					
					return {classes: 'disabled inhabil'};
				}
				
				// Inhabiles
				if (isInArray(search, inhabiles.split(","))){					
					return {classes: 'disabled inhabil'};
				}				
				
				// No festivos
        		if(date.getDay() != 0 && date.getDay() != 6){
          			return
        		}
				
        		// Festivos - resto
        		return {classes: 'disabled'};
			}
		})

	    $('#_BoletinOficial_WAR_LEEboletinOficialportlet_fecha').on('changeDate', function(e) {
	    	
	    	// Arir boletin en nueva pesta�a
	    	var selected = e.format();
	        var aux = selected.split("/");
	        
	        var dia = aux[0];
			var mes = aux[1];
			var anio = aux[2];
			var sbAnio = anio.substring(2, 4) + mes + dia;
	        
			if (lang == "es"){
				window.open(
					'https://egoitza.gipuzkoa.eus/gao-bog' + '/castell/bog/' + anio + '/' + mes + '/' + dia + '/bc' + sbAnio + '.htm',
					'_blank'
				);
			} else {
				window.open(
						'https://egoitza.gipuzkoa.eus/gao-bog' + '/euskera/gao/' + anio + '/' + mes + '/' + dia + '/be' + sbAnio + '.htm',
					'_blank'
				);
			}
			
			// Marcar en calendario como visitado (refersh datepicker) y guardar en array javascript
			var visited = dia.replace(/^0+/, '') + "/" + mes.replace(/^0+/, '') + "/" + anio;
	    	vst.push(visited);
	    	
	    	$( '#_BoletinOficial_WAR_LEEboletinOficialportlet_fecha' ).datepicker('update', selected); // volver a pintar el calendario
	    		    	
	    	// Guardar en session el d�a visitado
	    	var url = "https://egoitza.gipuzkoa.eus/es/bog?p_p_id=BoletinOficial_WAR_LEEboletinOficialportlet&p_p_lifecycle=2&p_p_state=normal&p_p_mode=view&p_p_resource_id=inhabiles&p_p_cacheability=cacheLevelPage";
	    	$.ajax({
	    		url: url,
	    		cache: false,
	    		type: "POST",
	    		async: false,
	    		data :{
	    			_BoletinOficial_WAR_LEEboletinOficialportlet_accion: 'visitados',
	    			_BoletinOficial_WAR_LEEboletinOficialportlet_dia: visited,
	    		},
	    		success: function(jsondata) {
	    			//console.log(jsondata);
	    		}
	    	});	    	
		});		
		
	    $('#_BoletinOficial_WAR_LEEboletinOficialportlet_fecha').on('changeMonth', function (e) {	    	
			var year = e.date.getFullYear();
			var month = (e.date.getMonth() + 1);
			
			if(year != jsAnio){
	           	inhabiles = obtenerDiasInhabiles(year);
	           	inhabiles_array = inhabiles.split(",");
	           	jsAnio = year;
			}
			if(lang == "eu"){
                var yearString=getEuskeraSuffix(year)
                $.fn.datepicker.dates['eu'].titleFormat = "yyyy" + yearString + " MM";
			}
	    });	    
	    
		$("#boletinOficialForm").submit(validateForm);
		
		$( "#_BoletinOficial_WAR_LEEboletinOficialportlet_anio" ).on(
			'blur keyup',
			function(){
				validateAnio( $(this).val() );
			}
		);
				
		$("#_BoletinOficial_WAR_LEEboletinOficialportlet_numBoletin").on(
			'blur keyup',
			function(){
				validateNumBoletin( $(this).val() );
			}
		);
		
		function validateForm(){
			var anio = $("#_BoletinOficial_WAR_LEEboletinOficialportlet_anio").val();
			var nbog = $("#_BoletinOficial_WAR_LEEboletinOficialportlet_numBoletin").val();
			
			if( !validateAnio(anio) ){
				$("#_BoletinOficial_WAR_LEEboletinOficialportlet_anio").focus();
				return false;
			}
			if( !validateNumBoletin(nbog) ){
				$("#_BoletinOficial_WAR_LEEboletinOficialportlet_numBoletin").focus();
				return false;
			}
			return true;
		}
		
		function validateAnio(anio){
		    if ($.isNumeric(anio) || anio == '') {
		    	$( "#anio_error" ).hide();
		    	return true;
		    } else {
		       $( "#anio_error" ).show();
		       return false;
		     }
		}
		
		function validateNumBoletin(nbog){
		    if ($.isNumeric(nbog) || nbog == '') {
		    	$( "#numBoletin_error" ).hide();
		    	return true;
		    } else {
		       $( "#numBoletin_error" ).show();
		       return false;
		    }
		}		
	});
</script>

	
	
					
				
			
		
	
	


