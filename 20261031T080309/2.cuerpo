						if(elto != null && !elto.is(currentFootMenu)) {
							if(currentFootMenu != null){
								currentFootMenu.parent().removeClass("toggled"); 
							}
							currentFootMenu = elto;
							currentFootMenu.parent().addClass("toggled");
						} else {
							currentFootMenu.parent().removeClass("toggled"); 
							currentFootMenu = null;
						}
						return false;
					}
