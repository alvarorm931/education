	<div class="portlet-body">



	
		
			
				
					







































	

	








	

				

				
					
						


	

		



















<link rel="stylesheet" type="text/css" media="screen" href="/o/BOP-Busqueda/css/chosen.custom.min.css" />
<script type="text/javascript" src="/o/BOP-Busqueda/js/chosen.jquery.custom.min.js" charset="UTF-8"></script>

<script>

	$(document).ready(function() {
		
		$("#fbdd").datepicker({
			changeMonth : true,
			changeYear : true,
			dateFormat: 'dd/mm/yy',
			altField: "#fechaDesde",
			altFormat:"yy-mm-dd",
		});
		
		$("#fbhd").datepicker({
			changeMonth : true,
			changeYear : true,
			dateFormat: 'dd/mm/yy',
			altField: "#fechaHasta",
			altFormat:"yy-mm-dd",
		});
		
		checkDates();
		
		$("#fqorg").chosen({
			allow_single_deselect: true,
			no_results_text: "No existen resultados: ",
			width: "100%"
		});
	});

	function checkDates(){
		if(1134604800000 != 0){
			 var a =  new Date(1134604800000);
			$( "#fbdd" ).datepicker( "setDate",  a );		 
		}
		if(1793328972996 != 0){
			var b =  new Date(1793328972996);
			 $( "#fbhd" ).datepicker( "setDate", b );
		}
	}


	jQuery.extend(jQuery.fn, {
		years : function(start, end) {
			for (var i = start; i <= end; i++) {
				$(this).append($('<option />').val(i).html(i));
			}
		}
	});

		
	function buscarBoletin() {
		$('#boton_buscar').addClass('pressed');
		$('.loader').show();
		
		var texto = $('#qbop').val();
		var en = $("#en").val();
		var rpalabra = $("#rpalabra").val();
		var qcapitulo = $("#qcapitulo").val();
		var organismo = 0;
		var organimoSeleccionado = document.getElementById("fqorg").value;

		if (organimoSeleccionado) {
			organismo = document.querySelector("#fqorg option[value='"
					+ organimoSeleccionado + "']").dataset.value;
		}

		var fechaDesde = $('#fechaDesde').val();
		var fechaHasta = $('#fechaHasta').val();
		var qanio = $('#qanio').val();
		var qnumero = $('#qnumero').val();
		var ps = $('#ps').val();

		if(texto.trim() == '' && organismo == 0 && qnumero.trim() == ''){
			$('#boton_buscar').removeClass('pressed');
			$('.loader').hide();
			alert('Debe especificar una cadena de busqueda o un organismo o un número de boletín o un año');
		}else{
			data = '{"textToSearch":"' + encodeURIComponent(texto) + '",' + '"scopeTexto":"' + en
					+ '",' + '"section":"' + qcapitulo + '",' + '"organismo":"'
					+ organismo + '",' + '"fechaDesde":"' + fechaDesde + '",'
					+ '"fechaHasta":"' + fechaHasta + '",' + '"anyo":"' + qanio + '",'
					+ '"numeroboletin":"' + qnumero + '",' + '"elementsPerPage":"'
					+ ps + '",' + '"scopeGranularidad":"' + rpalabra + '"}';
		
			dataHash = btoa(data);
			url = "/buscarenbop?jsonDataAsHash=" + dataHash;
			window.open(url, "_self");
		}

	}

	function borraanio() {
		$('#qanio').val('-');
	}

	function aniofechas() {
		if ($('#qanio').val() != '-') {
			$( "#fbdd" ).datepicker( "setDate",  new Date($('#qanio').val(),0 ,1) );	
			$( "#fbhd" ).datepicker( "setDate",  new Date($('#qanio').val(),11 ,31) );
		}
	}

	$(function() {
		$('#qanio').years(2005, (new Date()).getFullYear());
	});
</script>

