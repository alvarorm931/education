function actualizarComboGrupo(idTipo) {
    $.ajax({
        url: '/bop/services/listas/gruposByTipo',
        method: 'GET',
        dataType: 'json',
        data: {"idTipo": idTipo},
        timeout: 0, // sin tiempo de espera
        success: function (resultado, textStatus, jqXHR) {
            // Vaciamos el Combo.
                var i;
                for (i = document.getElementById("GrupoEntidad").options.length - 1; i >= 0; i--)
                {
                    document.getElementById("GrupoEntidad").remove(i);
                }
                for (i = document.getElementById("Entidad").options.length - 1; i >= 0; i--)
                {
                    document.getElementById("Entidad").remove(i);
                }
            if (resultado !== null && resultado.data !== null && resultado.data.length > 0) {
                var lista = resultado.data;
                // Añadir elemento vacio al principio
                var z = document.createElement("option");
                z.setAttribute("value", -1);
                var t = document.createTextNode("---");
                z.appendChild(t);
                //document.getElementById("GrupoEntidad").empty();
                document.getElementById("GrupoEntidad").appendChild(z);
                
                for (var item in lista.sort()) {
                    var z = document.createElement("option");
                    z.setAttribute("value", lista[item].id);
                    var t = document.createTextNode(lista[item].descripcion);
                    z.appendChild(t);
                    document.getElementById("GrupoEntidad").appendChild(z);
                }
            }
        },
        error: function (jqXHR, textStatus, errorThrown) {
            console.log("Error: actualizarComboGrupo() -> /services/listas/gruposByTipo", textStatus);
        }});
}

function actualizarComboEntidades(idGrupo) {
    $.ajax({
        url: '/bop/services/listas/entidadesByGrupo',
        method: 'GET',
        dataType: 'json',
        data: {"idGrupo": idGrupo},
        timeout: 0, // sin tiempo de espera
        success: function (resultado, textStatus, jqXHR) {
            // Vaciamos el Combo.
            var i;
            for (i = document.getElementById("Entidad").options.length - 1; i >= 0; i--) {
                document.getElementById("Entidad").remove(i);
            }
            if (resultado !== null && resultado.data !== null && resultado.data.length > 0) {
                var lista = resultado.data;
                //document.getElementById("Entidad").empty();
                // Añadir elemento vacio al principio
                var z = document.createElement("option");
                z.setAttribute("value", -1);
                var t = document.createTextNode("---");
                z.appendChild(t);

                document.getElementById("Entidad").appendChild(z);
                for (var item in lista.sort()) {
                    var z = document.createElement("option");
                    z.setAttribute("value", lista[item].id);
                    var t = document.createTextNode(lista[item].descripcion);
                    z.appendChild(t);
                    document.getElementById("Entidad").appendChild(z);
                }
                var entidad = obtenerValorParametro("entidad");
                if (entidad != null) {
                    $('#Entidad').val(entidad);
                }
            }
            $('#GrupoEntidad').val(idGrupo);
        },
        error: function (jqXHR, textStatus, errorThrown) {
            console.log("Error: actualizarComboEntidades() -> /services/listas/entidadesByGrupo", textStatus);
        }});
}

/*
 * cargaCheckboxesTC()
 */
function cargaCheckboxesTC() {

    $.ajax({
        url: '/bop/services/busquedaRapida/temasContenidos',
        method: 'GET',
        dataType: 'json',
        timeout: 0, // sin tiempo de espera
        success: function (resultado, textStatus, jqXHR) {
            if (resultado !== null && resultado.data !== null && resultado.data.length > 0) {
                var listaSubv = [];
                var listaEmpl = []
                var listaCont = [];
                var listaFunc = [];
                var lista = resultado.data;
                var cont = 0;
                for (var item in lista.sort()) {
                    switch (lista[item].nombreTema) {
                        case "Subvenciones": 
                            listaSubv[listaSubv.length] = lista[item];
                            break;
                        case "Empleo": 
                            listaEmpl[listaEmpl.length] = lista[item];
                            break;
                        case "Contratacion": 
                            listaCont[listaCont.length] = lista[item];
                            break;
                        case "Funcionamiento": 
                            listaFunc[listaFunc.length] = lista[item];
                            break;  
                    }
                }
                cont = 0;
                for (var item in listaSubv.sort()) {
                    var z = document.createElement("input");
                    z.setAttribute("type", "checkbox");
                    z.setAttribute("class", "tipoc");
                    z.setAttribute("name", "Subvenciones");
                    z.setAttribute("value", listaSubv[item].idTipoContenido);
                    z.setAttribute("id", "listaSubv"+listaSubv[item].idTipoContenido);
                    var y = document.createElement("label");
                    y.setAttribute("for", "listaSubv"+listaSubv[item].idTipoContenido);
                    y.appendChild(z);
                    var t = document.createTextNode(listaSubv[item].tipoContenido);
                    y.appendChild(t);
                    var x = document.createElement("div");
                    x.setAttribute("class", "checkbox");
                    x.appendChild(y)
                    if (listaSubv.length < 6) {
                    	document.getElementById(listaSubv[item].nombreTema).appendChild(x);
                    }
                    else {
                        if (cont == 0) {
                            document.getElementById(listaSubv[item].nombreTema).appendChild(x);
                            cont=1;
                        } else {
                            document.getElementById(listaSubv[item].nombreTema+"2").appendChild(x);
                            cont=0;
                        }
                    }
                                        
                }
                cont = 0;
                for (var item in listaEmpl.sort()) {
                    var z = document.createElement("input");
                    z.setAttribute("type", "checkbox");
                    z.setAttribute("class", "tipoc");
                    z.setAttribute("name", "Empleo");
                    z.setAttribute("value", listaEmpl[item].idTipoContenido);
                    z.setAttribute("id", "listaEmpl"+listaEmpl[item].idTipoContenido);
                    var y = document.createElement("label");
                    y.setAttribute("for", "listaEmpl"+listaEmpl[item].idTipoContenido);
                    y.appendChild(z);
                    var t = document.createTextNode(listaEmpl[item].tipoContenido);
                    y.appendChild(t);
                    var x = document.createElement("div");
                    x.setAttribute("class", "checkbox");
                    x.appendChild(y)
                    if (listaEmpl.length < 6) {
                    	document.getElementById(listaEmpl[item].nombreTema).appendChild(x);
                    }
                    else {
                        if (cont == 0) {
                            document.getElementById(listaEmpl[item].nombreTema).appendChild(x);
                            cont=1;
                        } else {
                            document.getElementById(listaEmpl[item].nombreTema+"2").appendChild(x);
                            cont=0;
                        }
                    }
                                        
                }


                cont = 0;
                for (var item in listaCont.sort()) {
                    var z = document.createElement("input");
                    z.setAttribute("type", "checkbox");
                    z.setAttribute("class", "tipoc");
                    z.setAttribute("name", "Contratacion");
                    z.setAttribute("value", listaCont[item].idTipoContenido);
                    z.setAttribute("id", "listaCont"+listaCont[item].idTipoContenido);
                    var y = document.createElement("label");
                    y.setAttribute("for", "listaCont"+listaCont[item].idTipoContenido);
                    y.appendChild(z);
                    var t = document.createTextNode(listaCont[item].tipoContenido);
                    y.appendChild(t);
                    var x = document.createElement("div");
                    x.setAttribute("class", "checkbox");
                    x.appendChild(y)
                    if (listaCont.length < 6) {
                    	document.getElementById(listaCont[item].nombreTema).appendChild(x);
                    }
                    else {
                        if (cont == 0) {
                            document.getElementById(listaCont[item].nombreTema).appendChild(x);
                            cont=1;
                        } else {
                            document.getElementById(listaCont[item].nombreTema+"2").appendChild(x);
                            cont=0;
                        }
                    }
                                        
                }
                
                cont = 0;
                for (var item in listaFunc.sort()) {
                    var z = document.createElement("input");
                    z.setAttribute("type", "checkbox");
                    z.setAttribute("class", "tipoc");
                    z.setAttribute("name", "Funcionamiento");
                    z.setAttribute("value", listaFunc[item].idTipoContenido);
                    z.setAttribute("id", "listaFunc"+listaFunc[item].idTipoContenido);
                    var y = document.createElement("label");
                    y.setAttribute("for", "listaFunc"+listaFunc[item].idTipoContenido);
                    y.appendChild(z);
                    var t = document.createTextNode(listaFunc[item].tipoContenido);
                    y.appendChild(t);
                    var x = document.createElement("div");
                    x.setAttribute("class", "checkbox");
                    x.appendChild(y)
                    if (listaFunc.length < 6) {
                    	document.getElementById(listaFunc[item].nombreTema).appendChild(x);
                    }
                    else {
                        if (cont == 0) {
                            document.getElementById(listaFunc[item].nombreTema).appendChild(x);
                            cont=1;
                        } else {
                            document.getElementById(listaFunc[item].nombreTema+"2").appendChild(x);
                            cont=0;
                        }
                    }
                                        
                }
                
                 
                    
            }
        },
        error: function (jqXHR, textStatus, errorThrown) {
            console.log("Error: cargaCheckboxesTC() -> /services/busquedaRapida/temasContenidos", textStatus);
        }});
}

function cargaTexto() {
    var texto = obtenerValorParametro("texto");
    if (texto) {
        $('#textoLibre').val(texto);
    }
}

function cargaSelectGroup() {
    $.ajax({
        url: '/bop/services/busquedaRapida/temasContenidos',
        method: 'GET',
        dataType: 'json',
        timeout: 0, // sin tiempo de espera
        success: function (resultado, textStatus, jqXHR) {
            if (resultado !== null && resultado.data !== null && resultado.data.length > 0) {
                var tipos = obtenerValorParametro("tipos");
                if (tipos != null) {
                    var res = tipos.split("_");
                    res.shift();
                }              
                var lista = resultado.data;
                var sel = document.getElementById('tipoContenido');
                var aux = "";
                var optgroup = null;
                for (var i = 0; i < lista.length; i++) {                   
                    if (aux != lista[i].nombreTema) {
                        optgroup = document.createElement('optgroup');
                        optgroup.innerHTML = lista[i].nombreTema;
                        optgroup.value = lista[i].nombreTema;
                        optgroup.label = lista[i].nombreTema;
                        sel.appendChild(optgroup);
                        aux = lista[i].nombreTema;
                    }
                    var opt = document.createElement('option');
                    opt.innerHTML = lista[i].tipoContenido;
                    opt.value = lista[i].idTipoContenido;
                    if (tipos != null) {
                        for (var j = 0; j < res.length; j++) {
                            if (res[j] == lista[i].idTipoContenido) {
                                opt.selected = true;
                            }    
                        }
                    }       
                    optgroup.appendChild(opt);                    
                }              
            }
            var fechaDesde = obtenerValorParametro("desde");
            if (fechaDesde) {
                var anioD = String(fechaDesde).substring(6, 10);
                var diaD = String(fechaDesde).substring(0, 2);
                var mesD = String(fechaDesde).substring(3, 5);
                var desde =  mesD + '/' + diaD + '/' + anioD;
                $('#fechaIn').val(desde);
            }
            var fechaHasta = obtenerValorParametro("hasta");
            if (fechaHasta) {
                var anioH = String(fechaHasta).substring(6, 10);
                var diaH = String(fechaHasta).substring(0, 2);
                var mesH = String(fechaHasta).substring(3, 5);          
                var hasta =  mesH + '/' + diaH + '/' + anioH;
                $('#fechaOut').val(hasta);
            }
        },
        error: function (jqXHR, textStatus, errorThrown) {
            console.log("Error: cargaCheckboxesTC() -> /services/busquedaRapida/temasContenidos", textStatus);
        }
    });
}

/*
 * Llamadas a la web de resultados mediante los Botones de Buscar.
 * Botón Buscar por número de Bop. * 
 */
function webResultadosNumBop() {
    var busqueda = "numBop";
    var texto = $('#idCodigoVerificacion').val();
    $.ajax({
        url: '/bop/services/anuncios/anuncioByCsv',
        method: 'GET',
        dataType: 'json',
        data: {"csv": texto},
        timeout: 0, // sin tiempo de espera
        success: function (resultado, textStatus, jqXHR) {
            if (resultado !== null && resultado.data !== null && resultado.data.csv !== null && resultado.data.csv !== 0) {
                var date = new Date(resultado.data.fechaPublicacion);
                var y = date.getYear() + 1900;
                var m = date.getMonth() + 1;
                var d = date.getDate();
                var fechaTexto = d + "/" + m + "/" + y;
                window.location = "anuncio.html?csv=" + resultado.data.csv;
            }
            else {
                window.alert("No se han encontrado resultados con esos criterios de Búsqueda");
            }

        },
        error: function (jqXHR, textStatus, errorThrown) {
             window.alert("No se han encontrado resultados con esos criterios de Búsqueda");
        }});
}

// :Botón Buscar por fecha de Bop.
function webResultadosFechaBop() {
    var busqueda = "fechaBop";
    var fecha = $('#idBOPDia').val();
    window.location = "sumario.html?busqueda=" + busqueda + "&fecha=" + fecha;
}

// :Boton Buscar TipoGrupoEntidad.
function webResultadosTGE() {
    var busqueda = "tge";
    var tipo = $('#TipoEntidad').val();
    var grupo = $('#GrupoEntidad').val();
    var entidad = $('#Entidad').val();
    // Fecha Actual.
    var fechaActual = new Date();
    // Campo DESDE:
    var fechaFinal = new Date();
    var ambitoTemporal = $('#ambitoTemporal').val();
    if (ambitoTemporal == 0) { // Última Semana.
        fechaFinal.setDate(fechaActual.getDate() - 7);
    } else if (ambitoTemporal == 1) { // Último Més.
        fechaFinal.setMonth(fechaActual.getMonth() - 1);
    } else if (ambitoTemporal == 2) { // Último Año.
        fechaFinal.setYear(fechaActual.getYear() - 1 + 1900);
    }
    // Campo DESDE.
    var m = ("0" + (fechaFinal.getMonth() + 1)).slice(-2);
    var y = fechaFinal.getYear() + 1900;
    var desde = m + "/" + ("0" + (fechaFinal.getDate())).slice(-2) + "/" + y;
    // Campo HASTA (Fecha de Hoy):
    var m = ("0" + (fechaActual.getMonth() + 1)).slice(-2);
    var y = fechaActual.getYear() + 1900;
    var hasta = m + "/" + ("0" + (fechaActual.getDate())).slice(-2) + "/" + y;
    var start = 0;
    var limit = 20;
    window.location = "resultados.html?busqueda=" + busqueda
            + "&tipo=" + tipo
            + "&grupo=" + grupo
            + "&entidad=" + entidad
            + "&desde=" + desde
            + "&hasta=" + hasta
            + "&start=" + start
            + "&limit=" + limit;
}

// :Boton Buscar Búsqueda avanzada.
function busquedaAvanzada() {
    var busqueda = "ba";
    var texto = $('#textoLibre').val();
    var tipo = $('#TipoEntidad').val();
    var grupo = $('#GrupoEntidad').val();
    var entidad = $('#Entidad').val();
    var tipoc = $('#tipoContenido').val();
    var start = 0;
    var limit = 20;
    var tipos = "";
    for (var item in tipoc) {
        tipos = tipos + "_" + tipoc[item];
    }
    // Fecha Actual.
    if ($('#fechaIn').val() != null && $('#fechaIn').val() != "") {
        var fechaOrigen = $('#fechaIn').val();
        var anio = String(fechaOrigen).substring(6, 10);
        var dia = String(fechaOrigen).substring(0, 2);
        var mes = String(fechaOrigen).substring(3, 5);
    //    var fechaPublic = {"fechaPublic": mes + '/' + dia + '/' + anio};
        var desde = mes + '/' + dia + '/' + anio;
    // Campo DESDE:
    }
    else {
        var desde = "";
    }
    if ($('#fechaOut').val() != null && $('#fechaOut').val() != "") {
        var fechaFinal = $('#fechaOut').val();
        var anio = String(fechaFinal).substring(6, 10);
        var dia = String(fechaFinal).substring(0, 2);
        var mes = String(fechaFinal).substring(3, 5);
        var hasta =  mes + '/' + dia + '/' + anio;
    }
    else {
        var hasta = "";
    }
    window.location = "resultados.html?busqueda=" + busqueda
            + "&texto=" + texto
            + "&tipo=" + tipo
            + "&grupo=" + grupo
            + "&entidad=" + entidad
            + "&tipos=" + tipos
            + "&desde=" + desde
            + "&hasta=" + hasta
            + "&start=" + start
            + "&limit=" + limit;
}

