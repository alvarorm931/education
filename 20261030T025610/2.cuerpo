<style>

	.ui-datepicker {
		width: auto;
		height: auto;
	}
	
	.ui-widget.ui-widget-content{
		border: 0;
	}
	
	.ui-datepicker-header {
		background: gray;
		border: 1px solid gray;
	    border-radius: 0;
		color: white;
		font-size: 1.2em;
	}
	
	.ui-datepicker table {
	    margin: auto;
	    margin-bottom: 4px;
	}
	
	.contenedor_cal .ui-datepicker table {
		table-layout: fixed;
	}
	
	.ui-datepicker-calendar th {
		background: #e3e3e3;
		color: #32404c;
		border: 1px solid #e3e3e3;
		padding: 0 .3em;
	}
	
	.ui-datepicker-calendar td{
		position: relative;
	    border: 1px #e3e3e3 solid;
	}
	
	.ui-datepicker-calendar tbody tr td.ui-datepicker-week-end a {
		background: white;
	}
	
	.ui-datepicker-calendar .ui-state-default {
		text-align: center;
		border: none;
		color: inherit;
		pointer-events: none;
		cursor: default;
		text-decoration: none;
		background: none;
	}
	
	.ui-datepicker-calendar .ui-state-hover {
		cursor: none;
		pointer-events: none;
		text-decoration: none;
	}
	
	.ui-datepicker-calendar .ui-state-active {
		text-align: center;
		border: none;
		color: inherit;
		pointer-events: none;
		cursor: none;
		text-decoration: none;
		background: none;
	}
	
	.ui-datepicker-unselectable .ui-state-default {
		pointer-events: none;
		cursor: default;
		text-decoration: none;
	}
	
	.ui-datepicker .ui-datepicker-title select{
		height: auto;
	}
	
	.ui-datepicker .ui-datepicker-prev, .ui-datepicker .ui-datepicker-next {
	    top: 50%;
	    transform: translateY(-50%);
	}
	
	.ui-datepicker .ui-datepicker-prev-hover, .ui-datepicker .ui-datepicker-next-hover{
		top: 50%;
	}
	
	.calendario .highlight {
		background: #F0F0F0;
		color: #9f0635;
		pointer-events: auto;
		cursor: pointer;
	}
	
	.calendario .ui-datepicker-calendar tbody tr td.highlight a {
		color: #e42970;
		pointer-events: auto;
		cursor: pointer;
		font-weight: bold;
		background: #F0F0F0;
	}
	
	.calendario .ui-datepicker-calendar tbody tr td.highlight:before {
	    content: "";
	    background: url(/o/BOP-Theme/images/iconos/ico_cal_activo.png) no-repeat right 0 transparent;
	    height: 10px;
	    width: 10px;
	    position: absolute;
	    z-index: 1;
	    right: 0;
	    top: 0;
	}

	
	@media screen and (min-width: 768px) and (max-width: 1023px){
		.calendario .ui-datepicker td span,
		.calendario .ui-datepicker td a {
		    padding: .45em;
		}
	}
</style>

<div >
        
</div>

<div class="contenedor_cal">
	<div class="calendario">
		<div id="datepicker"></div>
	</div>
</div>

<script>
	var dates = ["2026-10-01","2026-10-02","2026-10-13","2026-10-06","2026-10-08","2026-10-15","2026-10-19","2026-10-05","2026-10-16","2026-10-21","2026-10-26","2026-10-07","2026-10-20","2026-10-09","2026-10-28","2026-10-12","2026-10-14","2026-10-23","2026-10-29","2026-10-27","2026-10-30","2026-10-22"];

	$.datepicker.regional['es'] = {
		closeText : 'Cerrar',
		prevText : '< Ant',
		nextText: 'Sig >',
		currentText : 'Hoy',
		monthNames : [ 'Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo',
				'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre',
				'Noviembre', 'Diciembre' ],
		monthNamesShort : [ 'Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun',
				'Jul', 'Ago', 'Sep', 'Oct', 'Nov', 'Dic' ],
		dayNames : [ 'Domingo', 'Lunes', 'Martes', 'Miércoles',
				'Jueves', 'Viernes', 'Sábado' ],
		dayNamesShort : [ 'Dom', 'Lun', 'Mar', 'Mié', 'Juv', 'Vie',
				'Sáb' ],
		dayNamesMin : [ 'Do', 'Lu', 'Ma', 'Mi', 'Ju', 'Vi', 'Sá' ],
		weekHeader : 'Sm',
		dateFormat : 'yy-mm-dd',
		firstDay : 1,
		isRTL : false,
		showMonthAfterYear : false,
		yearSuffix : '',
		changeMonth : true,
		changeYear : true,
	};

	function highlightBOPDays(date) {
		var month = date.getMonth() + 1;
		var year = date.getFullYear();
		var day = date.getDate();

		var newdate = year + '-' + ("0"+month).slice(-2) + '-' + ("0" + day).slice(-2);
		
		for (var i = 0; i < dates.length; i++) {
			if (dates[i] == newdate) {
				return [ true, 'highlight' ];
			}
		}
		return [ true, '' ];
	}

	function userClickOnChangeMonthYear(year, month, inst) {
		var url = '/o/BOP-Calendario'+'/CalendarioControl';
		jQuery.ajax({
			async : false,
			type : "GET",
			url : url,
			cache : false,
			dataType : "json",
			data : {
				month : month, // extra parameters if you want to pass
				year : year
			},
			success : function(data) {
				dates = data;
				// alert(dates);
			},
			error : function(XMLHttpRequest, textStatus, errorThrown) {
				// alert(errorThrown);
				// alert(textStatus);
			}
		});
	}
	
	function userClickOnDay(date, el) {
		
		var day  = el.selectedDay,
            mon  = el.selectedMonth,
            year = el.selectedYear;

       	var daySelected = $(el.dpDiv).find('[data-year="'+year+'"][data-month="'+mon+'"]').filter(function() {
           	return $(this).find('a').text().trim() == day;
       	});

		if (daySelected.hasClass('highlight')) {
			
			event.preventDefault();

			url = "/ultimobop?p_p_id=BOPVisualizaBoletin_WAR_BOPVisualizaBoletin&p_p_lifecycle=0&p_p_state=normal&p_p_mode=view&p_p_col_id=column-1&p_p_col_count=3&_BOPVisualizaBoletin_WAR_BOPVisualizaBoletin_fecha=";
			var completeUrl = url + date;
			window.open(completeUrl, "_self");
			
			return false;
		}
	}

	$.datepicker.setDefaults($.datepicker.regional['es']);
	$(function() {
		$("#datepicker").datepicker({
			beforeShowDay : highlightBOPDays,
			onChangeMonthYear : userClickOnChangeMonthYear,
			onSelect : userClickOnDay
		})
	});
</script>



	
	
					
				
			
		
	
	


