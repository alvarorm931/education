function cleanForm() {
    $('#Entidad').val("");
    $('#TipoEntidad').val("");
    $('#GrupoEntidad').val("");
    $('#textoLibre').val("");
    $('#fechaIn').val("");
    $('#fechaOut').val("");
    $('#tipoContenido').val("");
}
function cleanEmail() {
    $('#emailSuscriptor').val("");
}

function controlFiltros() {
    var busqueda = "ba";
    var texto = $('#textoLibre').val();
    var tipo = $('#TipoEntidad').val();
    var grupo = $('#GrupoEntidad').val();
    var entidad = $('#Entidad').val();
    var tipoc = $('#tipoContenido').val();
    var tipos = "";
    for (var item in tipoc) {
        tipos = tipos + "_" + tipoc[item];
    }
    // Fecha Actual.
    if ($('#fechaIn').val() != null && $('#fechaIn').val() != "") {
        var fechaOrigen = $('#fechaIn').val();
        var anio = String(fechaOrigen).substring(6, 10);
        var dia = String(fechaOrigen).substring(0, 2);
        var mes = String(fechaOrigen).substring(3, 5);
    //    var fechaPublic = {"fechaPublic": mes + '/' + dia + '/' + anio};
        var desde = mes + '/' + dia + '/' + anio;
    // Campo DESDE:
    }
    else {
        var desde = "";
    }
    if ($('#fechaOut').val() != null && $('#fechaOut').val() != "") {
        var fechaFinal = $('#fechaOut').val();
        var anio = String(fechaFinal).substring(6, 10);
        var dia = String(fechaFinal).substring(0, 2);
        var mes = String(fechaFinal).substring(3, 5);
        var hasta =  mes + '/' + dia + '/' + anio;
    }
    else {
        var hasta = "";
    }
    var flag = false;
    if (texto) {
        flag = true;
    }
    if (tipo && tipo != "null") {
        flag = true;
    }
    if (grupo && grupo != "null") {
        flag = true;
    }
    if (entidad && entidad != "null") {
        flag = true;
    }
    if (tipos) {
        flag = true;
    }
    if(desde) {
        flag = true;
    }
    if(hasta) {
        flag = true;
    }
    if (flag == true) {
        busquedaAvanzada();
    } else if (flag == false) {
        window.alert("Debe añadir al menos un criterio de búsqueda"); 
    }
}

function activarSuscripcion() {
    var token = obtenerValorParametro("token");
    $.ajax({
        url: '/bop/services/suscriptores/activar',
        method: 'GET',
        dataType: 'json',
        data: {"token": token},
        timeout: 0, // sin tiempo de espera
        success: function (resultado, textStatus, jqXHR) {
            if (resultado.success == true) {
                    
            } else{
                if (resultado.success == false && resultado.msg != null) {
                    window.alert("Ha introducido un token inválido");
                } else {
                    window.alert("Se ha producido un error al tramitar su suscripción");
                }  
            } 
        },
        error: function (jqXHR, textStatus, errorThrown) {
            console.log("Error: activarSuscripcion() -> /services/suscripcion", textStatus);
        }
    });
}

