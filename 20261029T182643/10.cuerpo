ast_success": "2026-10-27T08:03:21.800099", "failure_count": 0, "created": "2026-10-26T22:59:42.184543", "updated": "2026-10-27T08:03:21.800099", "status": "Archived successfully", "is_broken_printable": "Downloaded OK"}, "cache_last_updated": null, "cache_url": null, "created": "2026-10-26T15:09:02.735713", "datastore_active": false, "datastore_contains_all_records_of_source_file": false, "description": "", "format": "HTML", "hash": "", "id": "f112de3d-dcd7-481e-a07e-d61acebd6ae8", "last_modified": "2026-10-26T00:00:00", "metadata_modified": "2026-10-26T15:09:02.701467", "mimetype": null, "mimetype_inner": null, "name": "Acceso a la informaci\u00f3n del proyecto Mapa Municipal", "package_id": "8922a1dd-1054-4f82-82e8-03b7d1e85e27", "position": 5, "qa": {"resource_timestamp": null, "archival_timestamp": "2026-10-27T08:03:21.800099", "openness_score": 1, "openness_score_reason": "Could not determine a file extension in the URL. Format field \"HTML\" receives score: 1.", "format": "HTML", "created": "2026-10-26T22:59:42.796716", "updated": "2026-10-27T08:03:22.380530"}, "resource_locator_function": "information", "resource_locator_protocol": "WWW:LINK-1.0-http--link", "resource_type": null, "size": null, "state": "active", "tracking_summary": {"total": 52, "recent": 2}, "url": "https://icv.gva.es/es/delimitacio-municipal", "url_type": null}], "tags": [{"display_name": "Cartograf\u00eda de referencia", "id": "9b974896-97e0-4339-850e-9176bc8c0ada", "name": "Cartograf\u00eda de referencia", "state": "active", "vocabulary_id": null}, {"display_name": "Comunitat Valenciana", "id": "17ec5e60-685e-412f-969e-df3cd1abaf9e", "name": "Comunitat Valenciana", "state": "active", "vocabulary_id": null}, {"display_name": "Datos abiertos", "id": "5cc553e4-20b8-4d38-937c-071070e5c325", "name": "Datos abiertos", "state": "active", "vocabulary_id": null}, {"display_name": "Espa\u00f1a", "id": "1bd67767-18e2-417e-910a-3a94f57eb3c9", "name": "Espa\u00f1a", "state": "active", "vocabulary_id": null}, {"display_name": "ICV", "id": "a4408ca9-09e0-4515-8acb-5c9c7439e29b", "name": "ICV", "state": "active", "vocabulary_id": null}, {"display_name": "L\u00edmites municipales", "id": "5828c036-1167-4d5a-846d-43005a8ace13", "name": "L\u00edmites municipales", "state": "active", "vocabulary_id": null}, {"display_name": "Mejoras geom\u00e9tricas", "id": "61ea6a45-09e1-478c-bd04-60102b8844ec", "name": "Mejoras geom\u00e9tricas", "state": "active", "vocabulary_id": null}, {"display_name": "Unidades administrativas", "id": "77113c32-35ee-41c4-9242-d79cdb12268c", "name": "Unidades administrativas", "state": "active", "vocabulary_id": null}], "relationships_as_subject": [], "relationships_as_object": [], "tracking_summary": {"total": 135, "recent": 7}}, {"creator_user_id": "e3846494-e111-48e9-adeb-c27b3e75dc41", "extras_json": {"access_constraints": "[\"http://www.icv.gva.es/condiciones-de-uso-de-la-geoinformacion-icv\"]", "bbox-east-long": "0.567778", "bbox-north-lat": "40.794782", "bbox-south-lat": "37.830763", "bbox-west-long": "-1.60625", "contact-email": "delimitaciomunicipal@gva.es", "coupled-resource": "[]", "dataset-reference-date": "[{\"type\": \"revision\", \"value\": \"2026-10-26\"}]", "fecha_revision": "2026-10-26", "frequency": "Dependiente de origen de datos", "frequency-of-update": "asNeeded", "geolocation": "S\u00ed, con visualizaci\u00f3n indirecta", "graphic-preview-file": "https://icvficherosweb.icv.gva.es/04/geonetwork/miniaturas/0105_mapa_municipal.jpg", "guid": "spaicv0105_MGEJPR", "harvest_object_id": "99839e21-f6f5-4ab9-bda3-6895dabf5cd7", "harvest_source_id": "6928cef1-9c0f-41d8-99aa-d423768feb17", "harvest_source_title": "HARVESTING-ICV-2024", "licence": "[]", "lineage": "Los trabajos de recuperaci\u00f3n y mejora geom\u00e9trica consisten en la definici\u00f3n geom\u00e9trica de la l\u00ednea l\u00edmite mediante m\u00e9todos de medici\u00f3n y producci\u00f3n cartogr\u00e1fica actuales. Realizando campa\u00f1as de campo con operaciones de reconocimiento de la l\u00ednea l\u00edmite en campo, medici\u00f3n y replanteo topogr\u00e1ficos, y trabajos de gabinete de integraci\u00f3n y edici\u00f3n de la informaci\u00f3n cartogr\u00e1fica hist\u00f3rica y actual de los \u00e1mbitos de actuaci\u00f3n", "metadata-date": "2026-10-26", "metadata-language": "spa", "patched_by": "GVA", "progress": "final", "resource-type": "dataset", "responsible-party": "[{\"name\": \"Institut Cartogr\\u00e0fic Valenci\\u00e0\", \"roles\": [\"author\"]}, {\"name\": \"Instituto Geogr\\u00e1fico Nacional\", \"roles\": [\"author\"]}]", "spatial": "{\"type\": \"Polygon\", \"coordinates\": [[[-1.60625, 37.830763], [0.567778, 37.830763], [0.567778, 40.794782], [-1.60625, 40.794782], [-1.60625, 37.830763]]]}", "spatial-data-service-type": "", "spatial-reference-system": "", "spatial_harvester": "True"}, "frequency": "Dependiente de origen de datos", "geolocation": "S\u00ed, con visualizaci\u00f3n indirecta", "id": "819ebf09-1401-42a9-8759-8c7dec9a9b4c", "isopen": true, "license_id": "cc-by", "license_title": "Creative Commons Attribution", "license_url": "http://www.opendefinition.org/licenses/cc-by", "metadata_created": "2024-07-09T07:16:06.124150", "metadata_modified": "2026-10-26T15:04:26.223382", "name": "mapa-municipal-de-la-comunitat-valenciana-ejecucion-de-mejoras-geometricas-icv", "notes": "Cada l\u00ednea l\u00edmite jurisdiccional entre los t\u00e9rminos municipales se encuentra inscrita en el Registro Central de Cartograf\u00eda (RCC) seg\u00fan su Hoja Registral. La documentaci\u00f3n jur\u00eddica asociada est\u00e1 constituida por un Acta de Deslinde con la operaci\u00f3n practicada, para reconocer la l\u00ednea de t\u00e9rmino y se\u00f1alar los mojones llevada a cabo por los Ayuntamientos implicados y el IGN. La documentaci\u00f3n t\u00e9cnica est\u00e1 constituida por los cuadernos de campo de los levantamientos topogr\u00e1ficos realizados y planimetr\u00edas de la \u00e9poca.\n\t\t\t\tLa inscripci\u00f3n de los l\u00edmites municipales en el RCC, consisti\u00f3 tras su creaci\u00f3n por la Ley 7/1986, de Ordenaci\u00f3n de Cartograf\u00eda, en registrar la geometr\u00eda vigente publicada en la cartograf\u00eda oficial del Mapa Topogr\u00e1fico Nacional junto con el t\u00edtulo jur\u00eddico que la avalaba en ese momento. Para ello, se llev\u00f3 a cabo un proceso de digitalizaci\u00f3n de las l\u00edneas l\u00edmite utilizando diversas fuentes cartogr\u00e1ficas impresas, y con ello se constituy\u00f3 la base de la geometr\u00eda.  Como resultado de ello, con car\u00e1cter general, poseen una incertidumbre geom\u00e9trica en torno a 40 metros, seg\u00fan la experiencia y contrastaci\u00f3n con trabajos puntuales precisos realizados por el IGN.\n\t\t\t\tLa excepci\u00f3n a lo anterior son aquellas l\u00edneas en las que se han desarrollado una serie de trabajos t\u00e9cnicos y administrativos exigidos por la normativa estatal o auton\u00f3mica vigente para el deslinde de los t\u00e9rminos municipales, lo que ha permitido la inscripci\u00f3n de una geometr\u00eda m\u00e1s precisa.\nEn la Comunitat Valenciana, seg\u00fan la Ley 2/2020, de 2 de diciembre, de la Generalitat, de la informaci\u00f3n geogr\u00e1fica y del Instituto Cartogr\u00e1fico Valenciano, es funci\u00f3n del ICV, de acuerdo con la letra e) del art\u00edculo 4.2 de, la elaboraci\u00f3n y el mantenimiento del mapa municipal, que consiste, de acuerdo con el art\u00edculo 41.1 de la misma ley, en la recuperaci\u00f3n de las l\u00edneas l\u00edmite de todos los municipios de la comunidad.\nEstos trabajos consisten en la localizaci\u00f3n de los mojones que determinan la l\u00ednea l\u00edmite, replanteo de aquellos desaparecidos a partir de la documentaci\u00f3n jur\u00eddica y t\u00e9cnica registrada (normalmente acta de deslinde, cuaderno topogr\u00e1fico de campo y planimetr\u00edas municipales), asignaci\u00f3n de coordenadas precisas a los mojones y de la l\u00ednea entre dos mojones consecutivos (en el caso de que no fuera en l\u00ednea recta) y en su posterior refrendo jur\u00eddico del resultado de los trabajos. \nDe este modo se obtienen coordenadas precisas de todos los mojones que componen cada l\u00ednea y se concreta geom\u00e9tricamente el trazado del l\u00edmite entre cada dos mojones consecutivos, todo ello basado en la documentaci\u00f3n t\u00e9cnica y jur\u00eddica inscrita en el RCC. \nDe acuerdo con el art\u00edculo 43.3 de la misma ley, el ICV en colaboraci\u00f3n con los ayuntamientos, planifica anualmente los trabajos y los ejecuta. En esta capa de informaci\u00f3n se muestra el seguimiento y evoluci\u00f3n de este proyecto. Las geometr\u00edas de las l\u00edneas l\u00edmite mostradas son las originales, previas al proceso de mejora geom\u00e9trica.\nLos trabajos t\u00e9cnicos se realizan en colaboraci\u00f3n con los Ayuntamientos y con el IGN, que los supervisar\u00e1 finalmente.\nUna vez concluida esta fase, se procede a su publicaci\u00f3n en el DOGV en el caso de l\u00edneas avaladas jur\u00eddicamente o a la firma de Actas Adicionales, en el caso de l\u00edneas provisionales o parcialmente provisionales. \nFinalmente, se solicita al IGN, la actualizaci\u00f3n de la documentaci\u00f3n obrante en el RCC relativa a las l\u00edneas afectadas, informaci\u00f3n cartogr\u00e1fica y la incorporaci\u00f3n de las resoluciones de aprobaci\u00f3n de las mejoras geom\u00e9tricas realizadas", "num_resources": 6, "num_tags": 8, "organization": {"id": "629053f7-bbee-4e09-9615-93f587376e79", "name": "icv", "title": "ICV", "type": "organization", "description": "ICV - Institut Cartogr\u00e0fic Valenci\u00e0", "image_url": "2024-09-17-090922.148479Institut-cartografic-valencia.png", "created": "2024-09-17T11:01:43.178208", "is_organization": true, "approval_status": "approved", "state": "active"}, "owner_org": "629053f7-bbee-4e09-9615-93f587376e79", "private": false, "state": "active", "title": "Mapa municipal de la Comunitat Valenciana: Ejecuci\u00f3n de mejoras geom\u00e9tricas ICV", "type": "dataset", "url": "https://catalogo.icv.gva.es/geonetwork/srv/spa/catalog.search#/metadata/spaicv0105_MGEJPR", "extras": [{"key": "access_constraints", "value": "[\"http://www.icv.gva.es/condiciones-de-uso-de-la-geoinformacion-icv\"]"}, {"key": "bbox-east-long", "value": "0.567778"}, {"key": "bbox-north-lat", "value": "40.794782"}, {"key": "bbox-south-lat", "value": "37.830763"}, {"key": "bbox-west-long", "value": "-1.60625"}, {"key": "contact-email", "value": "delimitaciomunicipal@gva.es"}, {"key": "coupled-resource", "value": "[]"}, {"key": "dataset-reference-date", "value": "[{\"type\": \"revision\", \"value\": \"2026-10-26\"}]"}, {"key": "fecha_revision", "value": "2026-10-26"}, {"key": "frequency-of-update", "value": "asNeeded"}, {"key": "graphic-preview-file", "value": "https://icvficherosweb.icv.gva.es/04/geonetwork/miniaturas/0105_mapa_municipal.jpg"}, {"key": "guid", "value": "spaicv0105_MGEJPR"}, {"key": "harvest_object_id", "value": "8189c207-e73d-4aef-a55c-f1bd405ae5af"}, {"key": "harvest_source_id", "value": "6928cef1-9c0f-41d8-99aa-d423768feb17"}, {"key": "harvest_source_title", "value": "HARVESTING-ICV-2024"}, {"key": "licence", "value": "[]"}, {"key": "lineage", "value": "Los trabajos de recuperaci\u00f3n y mejora geom\u00e9trica consisten en la definici\u00f3n geom\u00e9trica de la l\u00ednea l\u00edmite mediante m\u00e9todos de medici\u00f3n y producci\u00f3n cartogr\u00e1fica actuales. Realizando campa\u00f1as de campo con operaciones de reconocimiento de la l\u00ednea l\u00edmite en campo, medici\u00f3n y replanteo topogr\u00e1ficos, y trabajos de gabinete de integraci\u00f3n y edici\u00f3n de la informaci\u00f3n cartogr\u00e1fica hist\u00f3rica y actual de los \u00e1mbitos de actuaci\u00f3n"}, {"key": "metadata-date", "value": "2026-10-26"}, {"key": "metadata-language", "value": "spa"}, {"key": "patched_by", "value": "GVA"}, {"key": "progress", "value": "final"}, {"key": "resource-type", "value": "dataset"}, {"key": "responsible-party", "value": "[{\"name\": \"Institut Cartogr\\u00e0fic Valenci\\u00e0\", \"roles\": [\"author\"]}, {\"name\": \"Instituto Geogr\\u00e1fico Nacional\", \"roles\": [\"author\"]}]"}, {"key": "spatial", "value": "{\"type\": \"Polygon\", \"coordinates\": [[[-1.60625, 37.830763], [0.567778, 37.830763], [0.567778, 40.794782], [-1.60625, 40.794782], [-1.60625, 37.830763]]]}"}, {"key": "spatial-data-service-type", "value": ""}, {"key": "spatial-reference-system", "value": ""}, {"key": "spatial_harvester", "value": "True"}], "groups": [{"description": "", "display_name": "Medio ambiente", "id": "a3fbb015-cf22-4ebe-b4c3-84590c9e3143", "image_display_url": "https://dadesobertes.gva.es/uploads/group/2022-05-11-101604.913439medio-ambiente.png", "name": "medio-ambiente", "title": "Medio ambiente"}], "resources": [{"archiver": {"resource_timestamp": null, "status_id": 0, "is_broken": false, "reason": "", "url_redirected_to": null, "cache_filepath": "/datos_apl/opendata/ckan/archive/a1/a1a9781f-788d-4c04-82b7-339db3a76669/resource", "cache_url": "https://dadesobertes.gva.es/a1/a1a9781f-788d-4c04-82b7-339db3a76669/resource", "size": 358610, "mimetype": "text/html", "hash": "108ebe3e17c65dc01875566df57a53ac158ff9c7", "etag": null, "last_modified": null, "first_failure": null, "last_success": "2026-10-27T03:22:12.287601", "failure_count": 0, "created": "2026-10-26T18:14:23.314013", "updated": "2026-10-27T03:22:12.287601", "status": "Archived successfully", "is_broken_printable": "Downloaded OK"}, "cache_last_updated": null, "cache_url": null, "created": "2026-10-26T15:04:26.257744", "datastore_active": false, "datastore_contains_all_records_of_source_file": false, "description": "", "format": "HTML", "hash": "", "id": "a1a9781f-788d-4c04-82b7-339db3a76669", "last_modified": "2026-10-26T00:00:00", "metadata_modified": "2026-10-26T15:04:26.230337", "mimetype": null, "mimetype_inner": null, "name": "URL de acceso al visor cartogr\u00e1fico IDEV", "package_id": "819ebf09-1401