                            <h2 class="bop-dia">
                                BOP del día
                            </h2>
                            <p>
                                        jueves 29  de  octubre  de  2026</p>
                                <a class="ver-boletin" href="/publica/consulta-de-bops/buscador/BOP-29-10-2026/" target="_self" title="Ver boletín del dia" data-fecha="2026-10-29">
                                    Ver boletín
                                </a>

                                <script>
                                        $(document).ready(function () {
                                            $('a.ver-boletin').attr('href', '#').on('click', function (e) {
                                                e.preventDefault(); // Evitamos el comportamiento predeterminado del enlace
                                                // Lanzamos evento clic sobre el día del boletín
                                                let fecha = $(this).data('fecha');
                                                if (fecha !== '') {
                                                    let fechaSplit = fecha.split('-'); // AÑO-MES-DÍA
                                                    $('.evo-calendar').evoCalendar('selectDate', fecha);

                                                    setTimeout(function () {
                                                        $('.CalendarioSAGA-calendario div[data-date-val="' + fecha + '"]').click();
                                                        // Seteamos el año
                                                        $('.calendar-year').find('p').text(fechaSplit[0]);
                                                        // Seteamos el mes
                                                        $('.calendar-months').find('li.month.active-month').removeClass('active-month');
                                                        $('.calendar-months').find('li[data-month-val="' + (fechaSplit[1] - 1) + '"]').addClass('active-month');
                                                    }, 300);
                                                }

                                                // Nos desplazamos hasta el calendario
                                                $('html, body').animate({
                                                    
                                                    scrollTop: $('.CalendarioSAGA').parent().offset().top
                                                    
                                                }, 800); // 800 ms para un desplazamiento suave
                                            });
                                        });
                                    </script>
                                </div>
                    </div>
                </div>
