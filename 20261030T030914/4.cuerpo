                    QueryExtra: '&fq=type:(bop)&fq=parent-folders:("/sites/bop/.content/bop/")&fq=xmlPublicado_es_b:true',
                    plantilla_elemento_individual: '/system/modules/com.saga.inpro.theme.bop/elements/SagaListado/SagaListado-element-individual-CalendarioSaga.jsp',
                    MetodoNombresCategorias: 'BuscandoTitles',
