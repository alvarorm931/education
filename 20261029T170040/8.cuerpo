		function mostrarCapaSituacion(){
			 //Mostramos filtro de situación solo para estado Publicado en BOE (P)
             if($("#codigoEstado").val() == 'P'){
                $("#capaSituacion").show();
             }else{
            	 $('#situacion').prop('selectedIndex',0);
                 $("#capaSituacion" ).hide();
             }
        }
	</script>

