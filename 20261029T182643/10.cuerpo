-cartografic-valencia.png", "created": "2024-09-17T11:01:43.178208", "is_organization": true, "approval_status": "approved", "state": "active"}, "owner_org": "629053f7-bbee-4e09-9615-93f587376e79", "private": false, "state": "active", "title": "PORN de la Sierra Escalona y la Dehesa de Campoamor - Zonificaci\u00f3n", "type": "dataset", "url": "https://catalogo.icv.gva.es/geonetwork/srv/spa/catalog.search#/metadata/spaicv0505_escalona_porn_zonificacion", "extras": [{"key": "access_constraints", "value": "[\"Atribuci\\u00f3n 4.0 Internacional de Creative Commons (CC BY 4.0)\"]"}, {"key": "bbox-east-long", "value": "-0.7407"}, {"key": "bbox-north-lat", "value": "38.046"}, {"key": "bbox-south-lat", "value": "37.879"}, {"key": "bbox-west-long", "value": "-0.9748"}, {"key": "contact-email", "value": "espacios_naturales@gva.es"}, {"key": "coupled-resource", "value": "[]"}, {"key": "dataset-reference-date", "value": "[{\"type\": \"creation\", \"value\": \"2026-02-27\"}, {\"type\": \"publication\", \"value\": \"2026-03-17\"}]"}, {"key": "fecha_creacion", "value": "2026-02-27"}, {"key": "fecha_publicacion", "value": "2026-03-17"}, {"key": "frequency-of-update", "value": "notPlanned"}, {"key": "graphic-preview-file", "value": "https://icvficherosweb.icv.gva.es/04/geonetwork/miniaturas/0505_escalona_porn_zonificacion.png"}, {"key": "guid", "value": "spaicv0505_escalona_porn_zonificacion"}, {"key": "harvest_object_id", "value": "069c7ce8-21c8-4530-abbe-ffbc4c674489"}, {"key": "harvest_source_id", "value": "6928cef1-9c0f-41d8-99aa-d423768feb17"}, {"key": "harvest_source_title", "value": "HARVESTING-ICV-2024"}, {"key": "licence", "value": "[]"}, {"key": "lineage", "value": "Esta cartograf\u00eda se ha realizado a partir de la Ortofoto de la Comunitat Valenciana(ICV 2024-2025), Paisajes Protegidos de la Comunitat Valenciana (publicados en la IDEV), Planes urban\u00edsticos de Orihuela, Pilar de la Horadada y San Miguel de Salinas (Ayuntamientos de Orihuela, Pilar de la Horadada y S