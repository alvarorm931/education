function cargaMes() {
    meses = ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];
    addOptions("mesHist", meses);
}

 function cargaDias(mes, anyo) {
     if (mes && mes != "null") {
        var numDias = 31;
        if (mes == "Abril" || mes == "Junio" || mes == "Septiembre" || mes == "Noviembre")
            numDias = 30;
        if (mes == "Febrero" && (anyo/4) != Math.floor(anyo/4))
            numDias = 28;
        if (mes == "Febrero" && (anyo/4) == Math.floor(anyo/4))
            numDias = 29;
        document.getElementById('diaHist').options.length = 0;
        select = document.getElementById('diaHist');
        var option = document.createElement("option");
        option.text = "Seleccione un día";
        option.value = null;
        select.add(option);
        for (var i = 1; i <= numDias; i++) {
            option = document.createElement("option");
            option.text = i;
            option.value = i;
            select.add(option);
        }
    }
    else {
        document.getElementById('diaHist').options.length = 0;
    }
    
}

function addOptions(domElement, meses) {
    select = document.getElementById('mesHist');
    var i = 0;
    for (value in meses) {
        i++;
        var option = document.createElement("option");
        option.text = meses[value];
        option.value = i;
        select.add(option);
    }
}

function suscribirDesuscribirBop(email, validar){
    if (ValidateEmail(email)) {
        if (validar == 1) {
            $.ajax({
            url: '/bop/services/suscriptores/suscribir',
            method: 'GET',
            dataType: 'json',
            data: {"email": email,"validar": validar},
            timeout: 0, // sin tiempo de espera
            success: function (resultado, textStatus, jqXHR) {
                if (resultado !== null && resultado.data !== null) {
                    if (resultado.data == true)
                        window.alert("Se ha enviado un email a su correo electrónico para validar su suscripción al BOP.");
                    else if (resultado.data == false) {
                        window.alert("Ya está activa la suscripción al BOP a este correo electrónico.");
                    }
                }
            },
            error: function (jqXHR, textStatus, errorThrown) {
            console.log("Error: suscribirDesuscribirBop() -> /services/suscriptores/suscribir", textStatus);
            }
        });
    } else if (validar == 0) {
        $.ajax({
            url: '/bop/services/suscriptores/desuscribir',
            method: 'GET',
            dataType: 'json',
            data: {"email": email,"validar": validar},
            timeout: 0, // sin tiempo de espera
            success: function (resultado, textStatus, jqXHR) {
            if (resultado !== null && resultado.data !== null) {
                if (resultado.data == true)
                    window.alert("Se ha enviado un email a su correo electrónico para cancelar su suscripción al BOP.");
                else
                    window.alert("No se ha podido cancelar su suscripción al bop ya que no se encuentra activa.");
                }
            },
            error: function (jqXHR, textStatus, errorThrown) {
            console.log("Error: suscribirDesuscribirBop() -> /services/suscriptores/desuscribir", textStatus);
            }
        });
    }
                
    }
    else {
        window.alert("El correo introducido es incorrecto.");
    }
}

function getAnuncioSig(dicTipos, idAnuncio) {
    var encontrado = false;
    // si PosidcionId anuncio == -1 devolvemos null
    // si PosidcionId anuncio == 1 devolvemos null
    for (var tipo in dicTipos) {
        for (var grupo in dicTipos[tipo]) {
            for (var entidad in dicTipos[tipo][grupo]) {
                for (var anuncio in dicTipos[tipo][grupo][entidad]) {
                    var csv = dicTipos[tipo][grupo][entidad][anuncio].csv;
                    if ((anuncio == "nombreEntidad") || (anuncio == "0")){
                        break;
                }
                    if (encontrado == true){
                        return csv;
                    }
                    if (csv == idAnuncio) {
                        encontrado = true;
                    }
                }
            }
        }
    }
    return idAnuncio;
}

function getAnuncioAnt(dicTipos, idAnuncio) {
// si PosidcionId anuncio == 1 devolvemos null
    var anterior = null;
    for (var tipo in dicTipos) {
        for (var grupo in dicTipos[tipo]) {
            for (var entidad in dicTipos[tipo][grupo]) {
                if (entidad == "nombreGrupo")
                    break;
                else {
                    for (var anuncio in dicTipos[tipo][grupo][entidad]) {
                        var csv = dicTipos[tipo][grupo][entidad][anuncio].csv;
                        if (csv == idAnuncio) {
                            if (anterior == null)
                                return idAnuncio; //como es el primero devuelvo el mismo;
                                else
                                return anterior;
                        } else {
                                if ((anuncio != "nombreEntidad") && (anuncio != "0"))
                                    anterior = csv;
                        }
                    }
                }
            }
        }
    }
}

/*
 * Cargar Conternido HTML del Anuncio.
 * Auto-Ejecutado cuando se Carga anuncio. * 
 */
function mostrarFicheroHtml() {
    var idAnuncio = obtenerValorParametro("csv");
//    var idAnuncio = JSON.parse(localStorage.getItem("idAnuncioMostrar"));
    $.ajax({
        url: '/bop/services/anuncios/contenidoHtmlIdAnuncio',
        method: 'GET',
        dataType: 'json',
        data: {"csv": idAnuncio},
        timeout: 0, // sin tiempo de espera
        success: function (resultado, textStatus, jqXHR) {
            // Mostrar contenido en la web.
            var insercion;
            var dicTipos = JSON.parse(localStorage.getItem("listaAnuncios"));
            var monthNames = ["Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio",
                "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"];
            var date = new Date(resultado.data.fechaPublicacion)
            var y = date.getYear() + 1900
            var m = date.getMonth() + 1;
            var d = date.getDate();
            var mn = monthNames[date.getMonth()];
            var fechaTexto = d + " de " + mn + " de " + y;
            // Añadir publicado referencia clasificado.
            var busqueda = obtenerValorParametro("sm");
            if (busqueda == 1) {
                $("#anterior").hide();
                $("#siguiente").hide();
                $("#resulbusq").show();
                $("#hyphen1").show();
                $("#hyphen2").hide();
                $("#hyphen3").hide();
            }
            document.getElementById("sumario").href = "sumario.html?busqueda=numBop" + "&id=" + resultado.data.idBoletin;
                                               
            var numAnuncioAnterior = getAnuncioAnt(dicTipos, idAnuncio);
                if (numAnuncioAnterior == idAnuncio) {
                    document.getElementById("anterior").href = "anuncio.html?csv=" + getAnuncioAnt(dicTipos, idAnuncio);
                    $("#anterior").removeAttr('href');
                } else
                    document.getElementById("anterior").href = "anuncio.html?csv=" + getAnuncioAnt(dicTipos, idAnuncio);
                       
            var numAnuncioSiguiente = getAnuncioSig(dicTipos, idAnuncio);
            if (numAnuncioSiguiente == idAnuncio) {
                document.getElementById("siguiente").href = "anuncio.html?csv=" + getAnuncioSig(dicTipos, idAnuncio);
                $("#siguiente").removeAttr('href');
            } else
                document.getElementById("siguiente").href = "anuncio.html?csv=" + getAnuncioSig(dicTipos, idAnuncio);
            insercion = document.getElementById("enlacePdf");
            insercion.href = "/bop/services/anuncios/contenidoPdfIdAnuncio?csv=" + idAnuncio;
            insercion = document.getElementById("fechaMigaPan");
            insercion.innerHTML = "<a href='/bop/sumario.html?busqueda=numBop&id=" + resultado.data.idBoletin + "'>" + fechaTexto + "</a>";
            insercion = document.getElementById("publicadoEn");
            insercion.innerHTML = "Publicado en: <strong>BOP Nº " + resultado.data.numBoletin + " del " + fechaTexto + "</strong>";
            insercion = document.getElementById("referenciaMigaPan");
            insercion.innerHTML = resultado.data.csv;
            insercion = document.getElementById("referencia");
            insercion.innerHTML = "Referencia: <strong>" + resultado.data.csv  + "<strong>";
            insercion = document.getElementById("referenciaCabecera");
            insercion.innerHTML = "<img src='imagenes/boletinDiaLink.png' width='25' height='25' alt='Icono boletín diario'> Anuncio " + resultado.data.csv;
            insercion = document.getElementById("clasificado");
            //insercion.innerHTML =  resultado.data.csv;
            insercion = document.getElementById("nombreTipo");
            insercion.innerHTML = resultado.data.nombreTipo;
            insercion = document.getElementById("nombreGrupo");
            insercion.innerHTML = resultado.data.nombreGrupo;
            insercion = document.getElementById("nombreEntidad");
            insercion.innerHTML = resultado.data.nombreEntidad;
            insercion = document.getElementById("introduccion");
            insercion.innerHTML = resultado.data.tituloanuncio;
            // Lo apuntamos al div Sumario. (Contenedor padre de los anuncios).
            insercion = document.getElementsByClassName("anuncio")[0];
            insercion.innerHTML = resultado.data.contenidoHtml;
            insercion = document.getElementById("fechafir");
            if(resultado.data.fechaFirma!=null){            	
            	var datefirm = new Date(resultado.data.fechaFirma);
            	var monthNames = ["Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio",
            		"Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"];
            	var y = datefirm.getYear() + 1900;
            	var m = ("0" + (datefirm.getMonth() + 1)).slice(-2);
            	var mn = monthNames[datefirm.getMonth()];
            	var d = datefirm.getDate();
            	
            	var localidad="Cáceres";
            	if(resultado.data.localidad!=null)
            		localidad=resultado.data.localidad;
            	
            	var fechaTexto = localidad.trim()+", " + d + " de " + mn + " de " + y;
            	var fechaTexto2 = d + "/" + m + "/" + y;
            	insercion.innerHTML = fechaTexto;
            }
            insercion = document.getElementById("cargofir");
            insercion.innerHTML = resultado.data.cargoFirmante;
            insercion = document.getElementById("nombrefir");
            insercion.innerHTML = resultado.data.nombreFirmante;
            document.title = "Boletín Oficial de la Provincia de Cáceres: Anuncio " +  resultado.data.csv + " del día " + fechaTexto2 +", BOP Nº " + resultado.data.numBoletin;
            
        },
        error: function (jqXHR, textStatus, errorThrown) {
            console.log("Error: mostrarFicheroHtml() -> /services/anuncios/contenidoHtmlIdAnuncio", textStatus);
        }
    });
    
    $.ajax({
        url: '/bop/services/FichAnexos/anexosAnuncio',
        method: 'GET',
        dataType: 'json',
        data: {"csv": idAnuncio},
        timeout: 0, // sin tiempo de espera
        success: function (resultado, textStatus, jqXHR) {
            // Cargar enlaces adjuntos
            if (resultado !== null && resultado.data !== null && resultado.data.length > 0) {
                var insercion;
                insercion = document.getElementById("anexosContainerHeader");
//                var h = document.createElement("h4");
//                var t = document.createTextNode("Documentación anexa");
//                h.appendChild(t);
//                insercion.appendChild(h);
                var u = document.createElement("div");
                var lista = resultado.data;
                for (var item in lista) {
                    var i = document.createElement("img");
                    i.setAttribute("src","imagenes/puntoPDF.gif");
                    i.setAttribute("alt","Icono PDF");
                    i.setAttribute("title","Descargar anexo en PDF");
//                    var z = document.createElement("span");
                    var l = document.createElement("a");
                    l.setAttribute("href","/bop/services/FichAnexos/contenidoPdfAnexo?idAnexo=" + lista[item].idAnexo);
                    t = document.createTextNode("Documentación anexa");
                    l.appendChild(t);
                    u.appendChild(l);
                    u.appendChild(i);
//                    u.appendChild(z);
                }
                insercion.appendChild(u);
                insercion = document.getElementById("anexosContainerFooter");
                /*Duplicarh y u paraque se muetre tb abajo, cambiarlos en la dos lienas de abajo y descomentar*/
                //insercion.appendChild(h);
                //insercion.appendChild(u);
            }
           
        },
        error: function (jqXHR, textStatus, errorThrown) {
            console.log("Error: mostrarFicheroHtml() -> /bop/services/FichAnexos/anexosAnuncio", textStatus);
        }
    });
}

/*
 * cargarCombos()
 * 
 */
function cargaCombos() {
    var tipo = obtenerValorParametro("tipo");
    var grupo = obtenerValorParametro("grupo");
    $.ajax({
        url: '/bop/services/listas/tipos',
        method: 'GET',
        dataType: 'json',
        timeout: 0, // sin tiempo de espera
        success: function (resultado, textStatus, jqXHR) {
            if (resultado !== null && resultado.data !== null && resultado.data.length > 0) {
                var lista = resultado.data;
                // Añadir elemento vacio al principio
                var z = document.createElement("option");
                z.setAttribute("value", -1);
                var t = document.createTextNode("---");
                z.appendChild(t);
                document.getElementById("TipoEntidad").appendChild(z);
                for (var item in lista.sort()) {
                    var z = document.createElement("option");
                    z.setAttribute("value", lista[item].id);
                    var t = document.createTextNode(lista[item].descripcion);
                    z.appendChild(t);
                    document.getElementById("TipoEntidad").appendChild(z);
                }
                
                if (tipo && tipo != "null") {
                    $('#TipoEntidad').val(tipo);
                    actualizarComboGrupo(tipo);
                }
            }
            
        },
        error: function (jqXHR, textStatus, errorThrown) {
            console.log("Error: cargaCombos() -> /services/listas/tipos", textStatus);
        }});
    if (tipo != null) {
        $.ajax({
        url: '/bop/services/listas/grupos',
        method: 'GET',
        dataType: 'json',
        timeout: 0, // sin tiempo de espera
        success: function (resultado, textStatus, jqXHR) {
            if (resultado !== null && resultado.data !== null && resultado.data.length > 0) {
                var lista = resultado.data;
                // Añadir elemento vacio al principio
                var z = document.createElement("option");
                z.setAttribute("value", -1);
                var t = document.createTextNode("---");
                z.appendChild(t);
                document.getElementById("GrupoEntidad").appendChild(z);
                for (var item in lista.sort()) {
                    var z = document.createElement("option");
                    z.setAttribute("value", lista[item].id);
                    var t = document.createTextNode(lista[item].descripcion);
                    z.appendChild(t);
                    document.getElementById("GrupoEntidad").appendChild(z);
                }
            }
            if (grupo && grupo != "null") {
                actualizarComboEntidades(grupo);
            }
        },
        error: function (jqXHR, textStatus, errorThrown) {
            console.log("Error: cargaCombos() -> /services/listas/grupos", textStatus);
        }
    });
    }
    if (grupo != null) {
        $.ajax({
        url: '/bop/services/listas/entidades',
        method: 'GET',
        dataType: 'json',
        timeout: 0, // sin tiempo de espera
        success: function (resultado, textStatus, jqXHR) {
            if (resultado !== null && resultado.data !== null && resultado.data.length > 0) {
                var lista = resultado.data;
                // Añadir elemento vacio al principio
                var z = document.createElement("option");
                z.setAttribute("value", -1);
                var t = document.createTextNode("---");
                z.appendChild(t);
                document.getElementById("Entidad").appendChild(z);
                for (var item in lista.sort()) {
                    var z = document.createElement("option");
                    z.setAttribute("value", lista[item].id);
                    var t = document.createTextNode(lista[item].descripcion);
                    z.appendChild(t);
                    document.getElementById("Entidad").appendChild(z);
                }
                var entidad = obtenerValorParametro("entidad");
                if (entidad != null) {
                    $('#Entidad').val(entidad);
                }
            }
        },
        error: function (jqXHR, textStatus, errorThrown) {
            console.log("Error: cargaCombos() -> /services/listas/entidades", textStatus);
        }
    });
    }
}

