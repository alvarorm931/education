<div class="bipo bipo_bob">
   <div class="modal fade bipo_modal" id="bipoindices" tabindex="-1" role="dialog" aria-labelledby="bipoindices"
      aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered" role="document">
         <div class="modal-content">
            <div class="modal-header avisoForm-heading">
               <h1 class="modal-title">ÍNDICE DE EMISORES</h1>
               <button type="button" class="close bipoindices firstFocusElement" data-dismiss="modal" id="cerrarEmisores">
               <span class="sr-only" for="cerrarEmisores">Cerrar índice de emisores</span>
               <span aria-hidden="true" class="bipoicon icon-cross"></span>
               </button>
            </div>
            <div class="modal-body" tabindex="-1">
               <!--tags-->
               <div id="_IYCSWBSC_filtros">
                  <div class="bipo_catalogo_tags">
