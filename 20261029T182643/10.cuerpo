e": "Federaci\u00f3n", "state": "active", "vocabulary_id": null}, {"display_name": "Sexo", "id": "05d32cd2-91a0-4553-b1ee-a565d830f026", "name": "Sexo", "state": "active", "vocabulary_id": null}], "relationships_as_subject": [], "relationships_as_object": [], "tracking_summary": {"total": 290, "recent": 31}}, {"creator_user_id": "e3846494-e111-48e9-adeb-c27b3e75dc41", "extras_json": {"access_constraints": "[\"Atribuci\\u00f3n 4.0 Internacional de Creative Commons (CC BY 4.0)\"]", "bbox-east-long": "1.15", "bbox-north-lat": "40.81", "bbox-south-lat": "37.78", "bbox-west-long": "-1.72", "contact-email": "infonatura2000@gva.es", "coupled-resource": "[]", "dataset-reference-date": "[{\"type\": \"publication\", \"value\": \"2017-11-07\"}]", "fecha_publicacion": "2017-11-07", "frequency": "Dependiente de origen de datos", "frequency-of-update": "asNeeded", "geolocation": "S\u00ed, con visualizaci\u00f3n indirecta", "graphic-preview-file": "https://icvficherosweb.icv.gva.es/04/geonetwork/miniaturas/0502_planes_recuperacion.png", "guid": "spaicv0502_planes_recuperacion", "harvest_object_id": "fc497bbd-6199-423d-afad-6c3dba803271", "harvest_source_id": "6928cef1-9c0f-41d8-99aa-d423768feb17", "harvest_source_title": "HARVESTING-ICV-2024", "licence": "[]", "lineage": "Cartograf\u00eda generada a partir del marco normativo que sustenta los distintos planes de recuperaci\u00f3n, constituyendo una l\u00ednea de trabajo que integra y refleja la evoluci\u00f3n de las estrategias de conservaci\u00f3n aplicadas a cada especie protegida.", "metadata-date": "2025-10-01", "metadata-language": "spa", "patched_by": "GVA", "progress": "completed", "resource-type": "dataset", "responsible-party": "[{\"name\": \"Servicio de Vida Silvestre y Red Natura 2000 - Conselleria de Medio Ambiente, Infraestructuras y Territorio - Generalitat Valenciana\", \"roles\": [\"owner\", \"author\"]}, {\"name\": \"Institut Cartogr\\u00e0fic Valenci\\u00e0\", \"roles\": [\"publisher\"]}]", "spatial": "{\"type\": \"Polygon\", \"coordinates\": [[[-1.72, 37.78], [1.15, 37.78], [1.15, 40.81], [-1.72, 40.81], [-1.72, 37.78]]]}", "spatial-data-service-type": "", "spatial-reference-system": "", "spatial_harvester": "True"}, "frequency": "Dependiente de origen de datos", "geolocation": "S\u00ed, con visualizaci\u00f3n indirecta", "id": "9860bd5d-3a91-49ee-aa46-c4367d70c88f", "isopen": true, "license_id": "cc-by", "license_title": "Creative Commons Attribution", "license_url": "http://www.opendefinition.org/licenses/cc-by", "metadata_created": "2025-10-30T10:35:33.616498", "metadata_modified": "2026-10-26T15:08:26.697079", "name": "planes-de-recuperacion-de-especies-amenazadas-de-la-comunitat-valenciana", "notes": "Delimitaci\u00f3n de las zonas contempladas en los planes de recuperaci\u00f3n elaborados por la Generalitat Valenciana y publicados en el DOGV para diversas especies de fauna y flora en peligro de extinci\u00f3n o con poblaciones en regresi\u00f3n. Estos planes tienen como finalidad asegurar la conservaci\u00f3n y recuperaci\u00f3n de dichas especies mediante acciones coordinadas de protecci\u00f3n, restauraci\u00f3n de h\u00e1bitats, seguimiento cient\u00edfico y sensibilizaci\u00f3n social. Entre las especies incluidas se encuentran el fartet, el samaruc, el aguilucho lagunero, el avetoro, la cerceta pardilla, el escribano palustre, la gaviota de Audouin, la malvas\u00eda cabeciblanca, la silene hifacensis, el limonium perplexum y el cistus heterophyllus.", "num_resources": 5, "num_tags": 5, "organization": {"id": "629053f7-bbee-4e09-9615-93f587376e79", "name": "icv", "title": "ICV", "type": "organization", "description": "ICV - Institut Cartogr\u00e0fic Valenci\u00e0", "image_url": "2024-09-17-090922.148479Institut-cartografic-valencia.png", "created": "2024-09-17T11:01:43.178208", "is_organization": true, "approval_status": "approved", "state": "active"}, "owner_org": "629053f7-bbee-4e09-9615-93f587376e79", "private": false, "state": "active", "title": "Planes de Recuperaci\u00f3n de especies amenazadas de la Comunitat Valenciana", "type": "dataset", "url": "https://catalogo.icv.gva.es/geonetwork/srv/spa/catalog.search#/metadata/spaicv0502_planes_recuperacion", "extras": [{"key": "access_constraints", "value": "[\"Atribuci\\u00f3n 4.0 Internacional de Creative Commons (CC BY 4.0)\"]"}, {"key": "bbox-east-long", "value": "1.15"}, {"key": "bbox-north-lat", "value": "40.81"}, {"key": "bbox-south-lat", "value": "37.78"}, {"key": "bbox-west-long", "value": "-1.72"}, {"key": "contact-email", "value": "infonatura2000@gva.es"}, {"key": "coupled-resource", "value": "[]"}, {"key": "dataset-reference-date", "value": "[{\"type\": \"publication\", \"value\": \"2017-11-07\"}]"}, {"key": "fecha_publicacion", "value": "2017-11-07"}, {"key": "frequency-of-update", "value": "asNeeded"}, {"key": "graphic-preview-file", "value": "https://icvficherosweb.icv.gva.es/04/geonetwork/miniaturas/0502_planes_recuperacion.png"}, {"key": "guid", "value": "spaicv0502_planes_recuperacion"}, {"key": "harvest_object_id", "value": "bac6b11c-d33a-4c8c-a2f0-c35815cf24fa"}, {"key": "harvest_source_id", "value": "6928cef1-9c0f-41d8-99aa-d423768feb17"}, {"key": "harvest_source_title", "value": "HARVESTING-ICV-2024"}, {"key": "licence", "value": "[]"}, {"key": "lineage", "value": "Cartograf\u00eda generada a partir del marco normativo que sustenta los distintos planes de recuperaci\u00f3n, constituyendo una l\u00ednea de trabajo que integra y refleja la evoluci\u00f3n de las estrategias de conservaci\u00f3n aplicadas a cada especie protegida."}, {"key": "metadata-date", "value": "2025-10-01"}, {"key": "metadata-language", "value": "spa"}, {"key": "patched_by", "value": "GVA"}, {"key": "progress", "value": "completed"}, {"key": "resource-type", "value": "dataset"}, {"key": "responsible-party", "value": "[{\"name\": \"Servicio de Vida Silvestre y Red Natura 2000 - Conselleria de Medio Ambiente, Infraestructuras y Territorio - Generalitat Valenciana\", \"roles\": [\"owne