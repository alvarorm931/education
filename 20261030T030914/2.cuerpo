//                var d = date.getDate();
//                var mn = monthNames[date.getMonth()];
//                var fechaTexto = d + "/" + m + "/" + y;
//                var fechaMiga = d + " de " + mn + " de " + y;
//                var codigoVerificacion = dataAnunciosAnunciantes[0].tituloAnuncio.substring(0, 12);
//                document.getElementById('fechaMigaPan').innerHTML = fechaMiga;
//                document.getElementById('fechaCabecera').innerHTML = "<img src='imagenes/boletinDiaLink.png' width='25' height='25' alt=''/> " + fechaMiga;
//                document.getElementById('csvCabecera').innerHTML = "Descargar B.O.P. " + numBoletin + " completo   ";
                var anuncios = resultado.data.anuncios;
                if (anuncios != null) {
                    var lista = document.getElementById("listaanuncios");
                    for (var i = 0; i < anuncios.length; i++) {
                        var elemento = document.createElement("li");
                        var enlace = document.createElement("a");
                        var text = document.createTextNode(anuncios[i].nombreTipoEntidad + " - " + anuncios[i].nombreGrupoEntidad  + " - " + anuncios[i].nombreEntidad);
                        enlace.setAttribute("href", resultado.data.url + "anuncio.html?csv=" + anuncios[i].csv);
                        enlace.setAttribute("target", "_blank");
                        enlace.setAttribute("title", "Enlace a anuncio en la aplicación del B.O.P.");
                        enlace.appendChild(text);
                        elemento.appendChild(enlace);
                        text = document.createTextNode(anuncios[i].tituloAnuncio);
                        var parrafo = document.createElement("p");
                        parrafo.appendChild(text);
                        elemento.appendChild(parrafo);
                        lista.appendChild(elemento);
                        elemento = document.createElement("br");
                        lista.appendChild(elemento);
                        console.log("CREADA LA LISTA");
                    }
                }
//                <li>\n"
//                <p><a href='" + enlaceCsv + "'>" + tge +"</a></p>\n"
//                <p>" + titulo +"</p>\n"
//                </li><br/>\n
                
                document.getElementById('enlbop').href = resultado.data.url + "sumario.html?busqueda=numBop&id=" + resultado.data.idBoletin;
                document.getElementById('desbop').href = resultado.data.url + "services/boletines/contenidoPdfIdBolentin?idBoletin=" + resultado.data.idBoletin;
                document.getElementById('desbop').innerHTML = "Descarga del boletín: " + resultado.data.fecha + " - B.O.P. nº " + resultado.data.idBoletin;
                document.getElementById('cabhr').href = resultado.data.url;
                
            }
        },
        error: function (jqXHR, textStatus, errorThrown) {
            console.log("Error: loadTemplateMail() -> /services/boletin/loadTemplateMail", textStatus);
        }
    });
}
