e": 34152, "mimetype": "text/xml", "hash": "9e7d3f854139e2a29a64f58f8bf484a32638fab3", "etag": null, "last_modified": null, "first_failure": null, "last_success": "2026-10-27T08:03:19.663432", "failure_count": 0, "created": "2026-10-26T22:59:39.727729", "updated": "2026-10-27T08:03:19.663432", "status": "Archived successfully", "is_broken_printable": "Downloaded OK"}, "cache_last_updated": null, "cache_url": null, "created": "2026-10-26T15:09:02.735709", "datastore_active": false, "datastore_contains_all_records_of_source_file": false, "description": "", "format": "WFS", "hash": "", "id": "cde9fca9-0d9f-47f8-b1b4-62e42b82a7f2", "last_modified": "2026-10-26T00:00:00", "metadata_modified": "2026-10-26T15:09:02.701195", "mimetype": null, "mimetype_inner": null, "name": "Servicio WFS de mejoras geom\u00e9tricas", "package_id": "8922a1dd-1054-4f82-82e8-03b7d1e85e27", "position": 2, "qa": {"resource_timestamp": null, "archival_timestamp": "2026-10-27T08:03:19.663432", "openness_score": 3, "openness_score_reason": "Could not determine a file extension in the URL. Format field \"WFS\" receives score: 3.", "format": "WFS", "created": "2026-10-26T22:59:42.775246", "updated": "2026-10-27T08:03:22.362390"}, "resource_locator_function": "download", "resource_locator_protocol": "", "resource_type": null, "size": null, "state": "active", "tracking_summary": {"total": 5, "recent": 1}, "url": "https://terramapas.icv.gva.es/0105_MejorasGeometricas?service=WFS&request=GetCapabilities", "url_type": null}, {"archiver": {"resource_timestamp": null, "status_id": 0, "is_broken": false, "reason": "", "url_redirected_to": null, "cache_filepath": "/datos_apl/opendata/ckan/archive/ae/ae075bb6-03b1-4422-a2b8-4b97f8847dc5/0105_MejorasGeometricas", "cache_url": "https://dadesobertes.gva.es/ae/ae075bb6-03b1-4422-a2b8-4b97f8847dc5/0105_MejorasGeometricas", "size": 274432, "mimetype": "application/geopackage+sqlite3", "hash": "eef229408b01a4d71d6aa0adfe8305424d990be6", "etag": null, "last_modified":