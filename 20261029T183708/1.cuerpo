		event.stopPropagation();
		$("#copyText").val('https://twitter.com/intent/tweet?text=' + window.location.href);

	});

	/**
	 * Animated scroll with anchors
	 */
	$('body').on('click', '.js-scrollLink', function (event) {
		var $target = $(this.getAttribute('href'));
		if ($target.length > 0) {
			event.preventDefault();
			if ($(window).width() > 1199) {
				$('html, body').stop().animate({
					scrollTop: $target.offset().top - 10
				}, 750, 'easeInOutQuad');
			} else {
				var headerHeight = $('.fpca_capcalera_new .NG-main').height();
				$('html, body').stop().animate({
					scrollTop: $target.offset().top - headerHeight * 1.25
				}, 750, 'easeInOutQuad');
			}

		}
	});

	function scrollToID() {
		var url = decodeURIComponent(window.location.href);
		var urlIdString = "#" + url.split('#')[1];
		var $target = $(urlIdString);
		if ($target.length > 0) {
			event.preventDefault();
			if ($(window).width() > 1199) {
				$('html, body').stop().animate({
					scrollTop: $target.offset().top - 10
				}, 750, 'easeInOutQuad');
			} else {
				var headerHeight = $('.fpca_capcalera_new .NG-main').height();
				$('html, body').stop().animate({
					scrollTop: $target.offset().top - headerHeight * 1.25
				}, 750, 'easeInOutQuad');
			}

		}
	}
	window.onload = function () {
		//showModalLoading(false);
		scrollToID()
	};


});

var fpca_sumari_DOGC = {
    config: null,
    init: function ($fpca) {
        this.setUp($fpca);
    },
    setUp: function ($fpca) {
        const jsonLabels = $fpca.find(".i18n");
        this.config = {
            fpca: $fpca,
            labels: jsonLabels[0] ? JSON.parse(jsonLabels.text()) : {}
        }
    }
}