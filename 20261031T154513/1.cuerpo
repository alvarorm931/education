	<script type="text/javascript">
   	//<![CDATA[
		function startStatusPortal(title) {
			if (title == undefined) {
				title = "Processant";
			}
			PF('dlgStatusPortal').content.find(".status-message").text(title + "...");
			openDlg('dlgStatusPortal');
		}
		function stopStatusPortal() {
			closeDlg('dlgStatusPortal');;
		}
		function changeStatus() {
			var tmp = startStatus;
			startStatus = startStatusPortal;
			startStatusPortal = tmp;
			tmp = stopStatus;
			stopStatus = stopStatusPortal;
			stopStatusPortal = tmp;
		}
		changeStatus();
	//]]>
