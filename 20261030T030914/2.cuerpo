/*Obtenemos la fecha del breadcumb de la página Publico_Resultados_2*/
function fechaBCPubResul2() {
    var monthNames = ["Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio",
        "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"];
    var date = new Date();
    var ye = date.getYear() + 1900
    var mo = date.getMonth() + 1;
    var day = date.getDate();
    var mn = monthNames[date.getMonth()];
    var fechaMiga = day + " de " + mn + " de " + ye;
}

/*
 * Cargar Web de Resultados.
 * Auto-Ejecutado cuando se Carga sumario.
 */
function webResultadosCargar(idBOP) {
    var busqueda = obtenerValorParametro("busqueda");
    if (busqueda == null) {
    	var resultados=document.getElementById("resultados");
    	if(resultados!=null)
    		resultados.style.display = "none";
    	var textoIni=document.getElementById("textoIni");
    	if(textoIni!=null)
    		textoIni.style.display = "";
    	
    	if(resultados==null && textoIni==null){
    		busqueda = "fechaBop";
    	}
    }
    if(idBOP != undefined){
        loadAnunciosAnunciantes(idBOP, true);
    }else if (busqueda == "numBop") {
        var idBoletin = obtenerValorParametro("id");
        loadAnunciosAnunciantes(idBoletin);
    } else if (busqueda == "fechaBop") {
        var fechaBop = obtenerValorParametro("fecha");
        loadBopFecha(fechaBop);
    } else if (busqueda == "tge") {
    	document.getElementById("resultados").style.display = "";
    	document.getElementById("textoIni").style.display = "none";
        var tipo = obtenerValorParametro("tipo");
        var grupo = obtenerValorParametro("grupo");
        var entidad = obtenerValorParametro("entidad");
        var desde = obtenerValorParametro("desde");
        var hasta = obtenerValorParametro("hasta");
        if (grupo == "null") {
            grupo = -1;
        }
        if (entidad == "null") {
            entidad = -1;
        }
        var start = obtenerValorParametro("start");
        var limit = obtenerValorParametro("limit");
        loadAnunciosTipoGrupoEntidad(tipo, grupo, entidad, desde, hasta, start, limit);
    } else if (busqueda == "tc") {
    	document.getElementById("resultados").style.display = "";
    	document.getElementById("textoIni").style.display = "none";
        var tipos = obtenerValorParametro("tipos");
        var desde = obtenerValorParametro("desde");
        var hasta = obtenerValorParametro("hasta");
        var start = obtenerValorParametro("start");
        var limit = obtenerValorParametro("limit");
        loadAnunciosTipoContenido(tipos, desde, hasta, start, limit);
    } else if (busqueda == "ba") {
    	document.getElementById("resultados").style.display = "";
    	document.getElementById("textoIni").style.display = "none";
        var texto = obtenerValorParametro("texto");
        var tipo = obtenerValorParametro("tipo");
        var grupo = obtenerValorParametro("grupo");
        if (grupo == "null") {
            grupo = -1;
        }
        var entidad = obtenerValorParametro("entidad");
        if (entidad == "null") {
            entidad = -1;
        }
        var tipos = obtenerValorParametro("tipos");
        var desde = obtenerValorParametro("desde");
        var hasta = obtenerValorParametro("hasta");
        var start = obtenerValorParametro("start");
        var limit = obtenerValorParametro("limit");
        loadAnunciosBusqAvanzada(texto, tipo, grupo, entidad, tipos, desde, hasta, start, limit);
    }
}

function loadAnunciosAnunciantes(idBoletin, grande) {
    $.ajax({
        url: '/bop/services/anuncios/anunciosAnunciantes',
        method: 'GET',
        dataType: 'json',
        data: {"idBoletin": idBoletin},
        timeout: 0,
        success: function (resultado, textStatus, jqXHR) {
            if (resultado !== null && resultado.data !== null && resultado.data.length > 0) {
                var monthNames = ["Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio",
                    "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"];
                var dataAnunciosAnunciantes = resultado.data;
                // Establecemos un formato Natural para Mostrar la fecha.               
                var date = new Date(dataAnunciosAnunciantes[0].fechaPublicacion)
                var y = date.getYear() + 1900
                var m = ("0" + (date.getMonth() + 1)).slice(-2);
                var d = date.getDate();
                var mn = monthNames[date.getMonth()];
                var fechaTexto = d + "/" + m + "/" + y;
                var fechaMiga = d + " de " + mn + " de " + y;
                var codigoVerificacion = dataAnunciosAnunciantes[0].tituloAnuncio.substring(0, 12);
                document.getElementById('fechaMigaPan').innerHTML = fechaMiga;
                document.getElementById('fechaCabecera').innerHTML = "<img src='imagenes/boletinDiaLink.png' width='25' height='25' alt=''/> " + fechaMiga;
                document.getElementById('csvCabecera').innerHTML = "Descargar B.O.P. Nº " + dataAnunciosAnunciantes[0].numBop + " completo   ";
                document.getElementById('pdfCabecera').href = "/bop/services/boletines/contenidoPdfIdBolentin?idBoletin=" + idBoletin ;
                document.title = "Boletín Oficial de la Provincia de Cáceres: Boletín Nº " + dataAnunciosAnunciantes[0].numBop + ", del día "+ fechaTexto;
                //alert(y+" "+m+" "+d);
                //if(y=='2019' && m=='04' && d=='24'){
                if(dataAnunciosAnunciantes[0].csvFasciculo!=null){
                	document.getElementById('pdfFasciculo').href = "/bop/services/anuncios/contenidoPdfFasciculo?csv="+dataAnunciosAnunciantes[0].csvFasciculo;
                	document.getElementById("pdfFasciculo").style.display = "";
                }else{
                	/*var node = document.getElementById("pdfFasciculo");
                	node.parentNode.removeChild(node);*/
                	document.getElementById("pdfFasciculo").style.display = "none";
                }
                //document.getElementById('pdfCabecera').href = "#";
                mostrarAnunciosAnunciantes(dataAnunciosAnunciantes, grande);
            }
        },
        error: function (jqXHR, textStatus, errorThrown) {
            console.log("Error: loadAnunciosAnunciantes() -> /services/anuncios/anunciosAnunciantes", textStatus);
        }
    });
}

function loadBopFecha(fechaOrigen) {
	if(fechaOrigen==null){
		fechaOrigen= new Date();		
		var anio = fechaOrigen.getFullYear();
	    var dia = fechaOrigen.getDay();
	    var mes = fechaOrigen.getMonth();
	}else{
		var anio = String(fechaOrigen).substring(6, 10);
	    var dia = String(fechaOrigen).substring(0, 2);
	    var mes = String(fechaOrigen).substring(3, 5);
	}
// Ajustar la fecha al formato.    
    var fechaPublic = {"fechaPublic": mes + '/' + dia + '/' + anio};
    $.ajax({
        url: '/bop/services/anuncios/fechaPublicacion',
        method: 'GET',
        dataType: 'json',
        //jsonData:fecha,
        data: fechaPublic,
        timeout: 0, // sin tiempo de espera
        success: function (resultado, textStatus, jqXHR) {
            if (resultado !== null && resultado.data !== null && resultado.data.length > 0) {
                var dataAnunciosAnunciantes = resultado.data;
                mostrarAnunciosAnunciantes(dataAnunciosAnunciantes);
                // Establecemos un formato Natural para Mostrar la fecha.               
                var date = new Date(dataAnunciosAnunciantes[0].fechaPublicacion);
                var monthNames = ["Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio",
                    "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"];
                var y = date.getYear() + 1900;
                var m = ("0" + (date.getMonth() + 1)).slice(-2);
                var mn = monthNames[date.getMonth()];
                var d = date.getDate();
                var fechaTexto = d + " de " + mn + " de " + y;
                var fechaTexto2 = d + "/" + m + "/" + y;
                var codigoVerificacion = dataAnunciosAnunciantes[0].tituloAnuncio.substring(0, 12);
                document.getElementById('fechaCabecera').innerHTML = "<img src='imagenes/boletinDiaLink.png' width='25' height='25' alt=''/> " + fechaTexto;
                document.getElementById('csvCabecera').innerHTML = "Descargar " + codigoVerificacion + "   ";
                document.getElementById('pdfCabecera').href = "/bop/services/boletines/contenidoPdfIdBolentin?idBoletin=" + dataAnunciosAnunciantes[0].idboletin;
                document.title = "Boletín Oficial de la Provincia de Cáceres: Boletín Nº " + dataAnunciosAnunciantes[0].numBop + ", del día "+ fechaTexto2;
            }
            else {
                window.alert("No se han encontrado resultados con esos criterios de Búsqueda");
                window.location = "index.html";
                               
            }
        },
        error: function (jqXHR, textStatus, errorThrown) {
            console.log("Error: loadBopFecha() -> /services/anuncios/fechaPublicacion", textStatus);
        }});
}

