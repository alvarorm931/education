function loadAnunciosBusqAvanzadaCSV(texto, tipo, grupo, entidad, tipos, desde, hasta) {
    
    var dto = {};
    if (texto) {
        dto.texto = texto;
    }
    if (tipo && tipo != "null") {
        dto.tipo = tipo;
    }
    if (grupo && grupo != "null") {
        dto.grupo = grupo;
    }
    if (entidad && entidad != "null") {
        dto.entidad = entidad;
    }
    if (tipos) {
        dto.tipos = tipos;
    }
    if(desde) {
        dto.desde = desde;
    }
    if(hasta) {
        dto.hasta = hasta;
    }
    $.ajax({
        url: '/bop/services/anuncios/ba/report/csv',
        method: 'POST',
        data: dto,
        timeout: 0, // sin tiempo de espera
        success: function (resultado, textStatus, jqXHR) {
            if (resultado !== null) {
//                if (resultado.success == true) {
//                    var csv = JSON.parse(json.replace(/"([\w]+)":/g, function ($0, $1) { return ('"' + $1.toLowerCase() + '":'); }));
                    downloadFile('Listado_Anuncios.csv', resultado);
//                } if (resultado.success == false && resultado.msg != null) {
//                    window.alert("La consulta no ha devuelto ningún resultado");
//                } else {
//                    window.alert("Se ha producido un error al generar el csv");
//                } 
            }
            else {
                window.alert("La consulta no ha devuelto ningún resultado")
//                $('#contEnc').text("No se han obtenido resultados.");
            }
        },
        error: function (jqXHR, textStatus, errorThrown) {
            console.log("Error: loadAnunciosBusqAvanzadaCSV", textStatus, errorThrown, jqXHR);
        }
    });
}

 function downloadFile(fileName, csv) {
    if (navigator.userAgent.indexOf('MSIE') !== -1
        || navigator.appVersion.indexOf('Trident/') > 0) {
        var IEwindow = window.open("", "", "Width=0px; Height=0px");
        IEwindow.document.write('sep=,\r\n' + csv);
        IEwindow.document.close();
        IEwindow.document.execCommand('SaveAs', true, fileName);
        IEwindow.close();
    } else {
        var aLink = document.createElement('a');
        var evt = document.createEvent("MouseEvents");
        evt.initMouseEvent("click", true, true, window,
            0, 0, 0, 0, 0, false, false, false, false, 0, null);
        aLink.download = fileName;
        aLink.href = 'data:text/csv;charset=UTF-8,' + encodeURIComponent(csv);
        aLink.dispatchEvent(evt);
    }
}

