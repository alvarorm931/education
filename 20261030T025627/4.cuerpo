		function comprobarSlide() {
			if (!$("#advpsslideshow_5").size()) {
				window.requestAnimationFrame(comprobarSlide);
			} else {
				$('#advpsslideshow_5').bxSlider({
					useCSS : 1,
					slideMargin : 0,
					speed : 2000,
					mode : 'fade',
					auto : 1,
					autoHover : 1,
					pause : 8000,
					easing : 'linear',
					controls : 0,
					pager : 1,
					autoControls : 0
				});
				$("#advpsslideshow_5 .advs-title a").hover(function() {
					$(this).css('color', '#c4262b');
				}, function() {
					$(this).css('color', '#c4262b');
				});
				$("#advpsslideshow_5 .advps-slide").hover(function() {
				}, function() {
				});
			}
		};
		comprobarSlide();
	</script>
